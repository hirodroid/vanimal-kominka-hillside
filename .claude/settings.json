{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hook-check-cs.js\"",
            "timeout": 60,
            "statusMessage": "scripts/check-* (.cs 編集時)"
          }
        ]
      }
    ]
  }
}
