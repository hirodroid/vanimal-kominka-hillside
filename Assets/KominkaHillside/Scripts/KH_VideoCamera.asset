      Data: 424|UnityEngine.HeaderAttribute, UnityEngine.CoreModule
    - Name: header
      Entry: 1
      Data: "\u968A\u5217 (DES-WLD-004 M2\u3001\u81EA\u5206\u304C\u4E57\u3063\u3066\u3044\u308B\u30B0\u30EB\u30FC\u30D7\u306E\u5168\u30AB\u30FC\u30C8\u3068\u4E57\u54E1\u306E\u72AC\u3002\u4E57\u3063\u3066\u3044\u306A\u3051\u308C\u3070\u80CC\u4E2D\u3054\u3057)"
    - Name: 
      Entry: 8
      Data: 
    - Name: 
      Entry: 7
      Data: 425|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: "\u4E2D\u5FC3 = \u30B0\u30EB\u30FC\u30D7\u306E\u30AB\u30FC\u30C8\u306E\u91CD\u5FC3
        + convoyLift\u3002\u5E83\u304C\u308A = max(2 \xD7 \u30AB\u30FC\u30C8\u306E\u534A\u5F84
        + convoyDogMargin, 2 \xD7 \u72AC\u3082\u542B\u3081\u305F\u534A\u5F84) + convoyCartSize\u3002\u8DDD\u96E2
        = \u5E83\u304C\u308A\u304C\u753B\u9762\u306E\u9AD8\u3055\u306E convoyFill
        \u306B\u5165\u308B\u8DDD\u96E2 (convoyFov\u3001convoyDistMin\u301CconvoyDistMax)\u3002\u9032\u884C\u65B9\u5411\u306E\u5F8C\u65B9
