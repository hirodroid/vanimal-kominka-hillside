      Data: 1010|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: "\u9759\u6B62\u4E2D\u306E\u65CB\u56DE\u901F\u5EA6 (deg/s)\u3002**FaceTowards
        (\u3058\u3083\u308C\u5408\u3044\u306E\u5BFE\u9762) \u5C02\u7528** \u2014
        \u79FB\u52D5\u3092\u4F34\u3046\u65CB\u56DE\u306F _speed \u304C 0 \u306E\u9593\u305D\u3082\u305D\u3082\u8D70\u3089\u306A\u3044\u3002\u8DB3\u3092\u6B62\u3081\u305F\u307E\u307E\u56DE\u3059\u3068\u63A5\u5730\u3057\u305F\u8DB3\u304C\u5730\u9762\u3092\u64E6\u308A\u300C\u6ED1\u3063\u3066\u3044\u308B\u300D\u3088\u3046\u306B\u898B\u3048\u308B\u306E\u3067\u3001\u305D\u306E\u5834\u65CB\u56DE\u306F\u3053\u3053\u307E\u3067\u843D\u3068\u3059\u3002\u5B9F\u6E2C
        (2026-08-14) \u3067\u306F 60 \u3067\u3082\u307E\u3060\u6ED1\u3063\u3066\u898B\u3048\u305F\u306E\u3067
        30\u3002\u4E0B\u3052\u3059\u304E\u308B\u3068\u76F8\u624B\u3092\u898B\u3066\u3044\u306A\u3044\u3088\u3046\u306B\u898B\u3048\u308B\u306E\u3067\u3001\u5BFE\u9762\u306E\u6210\u7ACB\u3068\u306E\u30C8\u30EC\u30FC\u30C9\u30AA\u30D5"
