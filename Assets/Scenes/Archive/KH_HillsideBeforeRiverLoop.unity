    \u0443 \u0432\u043A\u043B\u0430\u0434\u0446\u0456 \xAB\u0412\u0431\u0440\u0430\u043D\u043D\u044F\xBB"
  - "\u0423 \u043F\u0440\u043E\u0434\u0430\u0436\u0443 \u0434\u043E 31 \u0436\u043E\u0432\u0442\u043D\u044F.
    \u041F\u0456\u0441\u043B\u044F \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u043C\u043E\u0436\u043D\u0430
