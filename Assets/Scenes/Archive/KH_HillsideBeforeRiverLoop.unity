  - "\u041F\u0456\u0441\u0435\u043D\u044C: {0}"
  - "\u0415\u0444\u0435\u043A\u0442\u0438 \u0433\u043B\u0430\u0434\u0456\u043D\u043D\u044F
    \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0456"
  - "\u0415\u0444\u0435\u043A\u0442\u0438 \u0432 \u0434\u0443\u0441\u0456 \u0448\u043E\u0443.
    \u0417'\u044F\u0432\u043B\u044F\u044E\u0442\u044C\u0441\u044F, \u043A\u043E\u043B\u0438
    \u0432\u0438 \u0433\u043B\u0430\u0434\u0438\u0442\u0435 \u0441\u043E\u0431\u0430\u043A"
  - "\u0412\u0431\u0440\u0430\u043D\u043D\u044F \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0456"
  - "\u041F\u0456\u0434 \u0447\u0430\u0441 \u0448\u043E\u0443 \u0441\u043E\u0431\u0430\u043A\u0438
