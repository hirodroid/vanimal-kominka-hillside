    / \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0438)."
  - "\u041F\u0430\u0440\u0430\u0434 \u0432\u043E\u043A\u0440\u0443\u0433 \u043A\u043E\u0440\u043E\u043D\u044B
    \u0438 \u0440\u0430\u0441\u0442\u0443\u0449\u0438\u0435 \u0444\u0435\u0439\u0435\u0440\u0432\u0435\u0440\u043A\u0438.
    \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u041C\u0435\u0434\u0432\u0435\u0434\u0438\u0446\u0430
    \u0438 \u0437\u0432\u0435\u0437\u0434\u043E\u043F\u0430\u0434. \u041B\u043E\u0442\u043E\u0441
    \u0438\u0437 \u0441\u0432\u0435\u0442\u0430 (112 \u0441) \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043D\u043E\u0447\u043D\u043E\u043C \u0441\u0430\u0434\u0443. \u041E\u0441\u0442\u0430\u0432\u044C\u0442\u0435
    \u043B\u044E\u0431\u0438\u043C\u043E\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
    \u0438 \u0434\u043B\u044F \u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u043F\u043E\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u0439."
  - Candy Step
  - "\u041D\u043E\u0447\u043D\u043E\u0439 \u0441\u0430\u0434, 124,8 \u0441"
  - "\u041A\u043E\u043D\u0444\u0435\u0442\u043D\u044B\u0435 \u043E\u0433\u043E\u043D\u044C\u043A\u0438
    \u0441\u043A\u0430\u0447\u0443\u0442 \u043F\u043E \u0441\u0430\u0434\u0443. \u041E\u0441\u043E\u0431\u043E\u0435
    \u0448\u043E\u0443, \u0433\u0434\u0435 \u0432\u0441\u0435 \u0448\u0435\u0441\u0442\u044C
    \u0441\u043E\u0431\u0430\u043A \u0442\u0430\u043D\u0446\u0443\u044E\u0442 \u043F\u043E\u0434
    \u043C\u0443\u0437\u044B\u043A\u0443."
  - "\u041A\u043E\u0433\u0434\u0430 \u0441\u043E\u0431\u0435\u0440\u0443\u0442\u0441\u044F
    \u0432\u0441\u0435 \u0448\u0435\u0441\u0442\u044C \u0441\u043E\u0431\u0430\u043A,
    \u0433\u0430\u0441\u043D\u0435\u0442 \u0441\u0432\u0435\u0442 \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043F\u0435\u0441\u043D\u044F. \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0448\u043E\u0443
    \u0441\u043E\u0431\u0430\u043A\u0438 \u043D\u043E\u0441\u044F\u0442 \u043D\u0430\u0440\u044F\u0434\u044B
    \u0438\u0437 \u043D\u0430\u0431\u043E\u0440\u0430. \u041A\u043E\u043D\u0444\u0435\u0442\u044B
    \u0432 \u043E\u0431\u0451\u0440\u0442\u043A\u0430\u0445 \u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
    \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0438 \u043F\u0440\u0438 \u043F\u043E\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u0438."
  - Pumpkin Parade
  - "\u041D\u043E\u0447\u043D\u043E\u0439 \u0441\u0430\u0434, 120 \u0441, \u0432
    \u043F\u0440\u043E\u0434\u0430\u0436\u0435 \u0434\u043E 31 \u043E\u043A\u0442\u044F\u0431\u0440\u044F"
  - "\u0412\u0441\u043B\u0435\u0434 \u0437\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C
    \u043F\u0440\u0438\u0432\u0438\u0434\u0435\u043D\u0438\u0435\u043C \u0441\u043E\u0431\u0430\u043A\u0438
    \u0438\u0434\u0443\u0442 \u043F\u043E \u0434\u043E\u0440\u043E\u0436\u043A\u0435
    \u0438\u0437 \u0442\u044B\u043A\u0432\u0435\u043D\u043D\u044B\u0445 \u043E\u0433\u043D\u0435\u0439.
    \u041E\u0441\u043E\u0431\u043E\u0435 \u0445\u044D\u043B\u043B\u043E\u0443\u0438\u043D\u0441\u043A\u043E\u0435
    \u0448\u043E\u0443."
  - "\u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430
    \u043F\u0440\u0438\u0432\u0438\u0434\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0435\u0442
    \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443 \u043E\u0433\u043E\u043D\u044C\u043A\u0443,
    \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043D\u043E\u0442\u0430, \u0438
    \u0442\u044B\u043A\u0432\u044B \u0437\u0430\u0436\u0438\u0433\u0430\u044E\u0442\u0441\u044F
    \u0432\u0434\u043E\u043B\u044C \u0448\u0435\u0441\u0442\u0432\u0438\u044F. \u0412
    \u043A\u043E\u043D\u0446\u0435 \u0441\u043E\u0431\u0430\u043A\u0438 \u0441\u0430\u0434\u044F\u0442\u0441\u044F
    \u043B\u0438\u0446\u043E\u043C \u043A \u0437\u0440\u0438\u0442\u0435\u043B\u044F\u043C."
  - Leaves into Stars
  - The plaza, from dusk into night
  - Glowing autumn leaves rise from the trees around the plaza and turn into stars.
    A quiet dusk song to watch beside your dogs.
  - It begins with a single leaf that grows into a slow, rising swirl. At the peak
    the leaves become stars, and the night lingers over the plaza.
  - "\u0425\u044D\u043B\u043B\u043E\u0443\u0438\u043D: \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0435
    \u0448\u043E\u0443 \xABPumpkin Parade\xBB \u0432 \u043F\u0440\u043E\u0434\u0430\u0436\u0435
    \u0434\u043E 31 \u043E\u043A\u0442\u044F\u0431\u0440\u044F"
  - "\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0445\u044D\u043B\u043B\u043E\u0443\u0438\u043D\u0441\u043A\u043E\u0435
    \u0448\u043E\u0443 \xABPumpkin Parade\xBB (\u0432 \u043F\u0440\u043E\u0434\u0430\u0436\u0435
    \u0434\u043E 31 \u043E\u043A\u0442\u044F\u0431\u0440\u044F)"
  - "\u041F\u0440\u043E\u0434\u0430\u0436\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430"
  - "\u041F\u0440\u043E\u0434\u0430\u0436\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B\u0430\u0441\u044C
    31 \u043E\u043A\u0442\u044F\u0431\u0440\u044F. \u041A\u0443\u043F\u0438\u0432\u0448\u0438\u0435
    \u043C\u043E\u0433\u0443\u0442 \u0438 \u0441 \u043D\u043E\u044F\u0431\u0440\u044F
    \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0448\u043E\u0443 \u0438
    \u043D\u0430\u0440\u044F\u0436\u0430\u0442\u044C \u0441\u043E\u0431\u0430\u043A."
  - "<b>Make yourself at home</b>\nYou can enjoy the usual activities without owning
    anything.\n\n<b>Pet a dog</b>\nStroke their head, cheeks, or chin, and they will
    respond.\n\n<b>Throw a ball or disc</b>\nPick one up and throw it. A dog will
    bring it back.\n\n<b>Walk together</b>\nChoose \u201CWalk\u201D in the menu.
    Put dogs on the lead and walk the hillside.\n\n<b>Rest together</b>\nChoose \u201CCall\u201D
    in the menu. A dog will come over and rest beside you.\n\n<b>What you can do
    in the menu</b>\nTime spent here earns points to exchange for things you like.\nUse
    the tabs above to walk with dogs on the lead, take out treats, or dress up a
    dog.\n\n<b>Points and Grandpa</b>\nOpen \u201CPoints\u201D at the top right to
    see how to earn points.\nTalk to Grandpa by the gate to get points for getting
    ready.\n\n<b>Bring the menu to you</b>\nVR: Hold the right stick down\nDesktop:
    Press T\nMobile: Tap [Menu] on the screen"
