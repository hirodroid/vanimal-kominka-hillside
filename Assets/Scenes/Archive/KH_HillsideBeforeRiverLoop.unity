    \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C.\n\n\u042F
    \u0432\u0432\u0430\u0436\u0430\u044E \u0428\u0406 \u043E\u0434\u043D\u0438\u043C
    \u0456\u0437 \u0442\u0432\u043E\u0440\u0447\u0438\u0445 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432
    \u0456 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F \u0437 \u0439\u043E\u0433\u043E
