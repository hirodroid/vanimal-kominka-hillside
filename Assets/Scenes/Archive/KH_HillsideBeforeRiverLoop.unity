  - "\uB098\uC5D0\uAC8C\uB9CC \uC801\uC6A9, \uB2E4\uC74C \uBC29\uBB38\uC5D0\uB3C4
    \uC720\uC9C0"
  - "\uD655\uC815 \uC804 \uC785\uB825\uC740 \uC804\uD658\uD558\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4"
