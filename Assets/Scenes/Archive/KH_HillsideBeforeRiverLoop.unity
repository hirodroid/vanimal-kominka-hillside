  - "\u0411\u043B\u0438\u0436\u0435 \u043A \u043A\u043E\u043D\u0446\u0443 \u0448\u0435\u0441\u0442\u044C
    \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u043E\u0432 \u0441\u043F\u0438\u0440\u0430\u043B\u044C\u044E
