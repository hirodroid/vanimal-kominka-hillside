  - "\u3088\u3046\u3053\u305D\u3001\u53E4\u6C11\u5BB6\u306E\u88CF\u5C71\u3078"
  - "\u306A\u306B\u3082\u6301\u3063\u3066\u3044\u306A\u304F\u3066\u3082 \u2014 \u3044\u3064\u3082\u306E\u904A\u3073\u306F\u3001\u305D\u306E\u307E\u307E\n\u30FB\u64AB\u3067\u308B:
    \u982D\u30FB\u307B\u3063\u307A\u30FB\u3042\u3054\u3092\u306A\u3067\u308B\u3068\u3001\u72AC\u304C\u8FD4\u4E8B\u3092\u3057\u307E\u3059\n\u30FB\u30DC\u30FC\u30EB\u3084\u30C7\u30A3\u30B9\u30AF\u3092\u6295\u3052\u308B:
    \u62FE\u3063\u3066\u6295\u3052\u308B\u3068\u3001\u6301\u3063\u3066\u304D\u307E\u3059\n\u30FB\u4E00\u7DD2\u306B\u6B69\u304F:
    \u3053\u306E\u677F\u306E\u300C\u3055\u3093\u307D\u300D\u304B\u3089\u3002\u72AC\u3092\u3064\u306A\u3044\u3067\u3001\u88CF\u5C71\u3092\u6B69\u3051\u307E\u3059\n\u30FB\u305D\u3070\u3067\u5BDD\u3066\u3082\u3089\u3046:
    \u3053\u306E\u677F\u306E\u300C\u547C\u3076\u300D\u304B\u3089\u3002\u72AC\u304C\u6765\u3066\u3001\u305D\u3070\u3067\u5BDD\u307E\u3059\n\n\u3053\u306E\u677F\u3067\u3067\u304D\u308B\u3053\u3068
    \u2014 \u904E\u3054\u3057\u305F\u6642\u9593\u304C\u30DD\u30A4\u30F3\u30C8\u306B\u306A\u308A\u3001\u597D\u304D\u306A\u3082\u306E\u3068\u4EA4\u63DB\u3067\u304D\u307E\u3059\n\u30FB\u3055\u3093\u307D\u30FB\u304A\u3084\u3064\u30FB\u304B\u3056\u308A:
    \u72AC\u3092\u3064\u306A\u3050\u3001\u624B\u5143\u306B\u51FA\u3059\u3001\u72AC\u306B\u3064\u3051\u308B\u3002\u4E0A\u306E\u30BF\u30D6\u304B\u3089\n\u30FB\u30DD\u30A4\u30F3\u30C8\u3068\u304A\u3058\u3044\u3055\u3093:
    \u53F3\u4E0A\u306E\u300C\u30DD\u30A4\u30F3\u30C8\u300D\u306B\u5165\u624B\u7D4C\u8DEF\u3002\u9580\u306E\u305D\u3070\u306E\u304A\u3058\u3044\u3055\u3093\u306B\u8A71\u3057\u304B\u3051\u308B\u3068\u3001\u652F\u5EA6\u7528\u306E\u30DD\u30A4\u30F3\u30C8\u304C\u3082\u3089\u3048\u307E\u3059"
  - "\u9589\u3058\u305F\u3042\u3068\u3082\u3001\u53F3\u30B9\u30C6\u30A3\u30C3\u30AF\u3092\u4E0B\u306B\u9577\u62BC\u3057\u3067\u3001\u307E\u305F\u547C\u3079\u307E\u3059\u3002\n\u3082\u3046\u4E00\u5EA6\u8AAD\u3080\u3068\u304D\u306F
