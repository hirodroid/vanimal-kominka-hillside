    \u0437 \u043B\u0438\u0441\u0442\u043E\u043F\u0430\u0434\u0430."
  - "\u0422\u043E\u0432\u0430\u0440\u0438 \u0437\u0430 Credits \u043A\u0443\u043F\u0443\u044E\u0442\u044C\u0441\u044F
    \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456 VRChat. \u0407\u0445
    \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u043D\u0430 \u0434\u0430\u0440\u0443\u0432\u0430\u0442\u0438."
  - "\u041F\u0456\u0441\u043B\u044F \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0448\u043E\u0443
    \u043C\u043E\u0436\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438
