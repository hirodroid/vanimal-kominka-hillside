  - "\u041E VAnimal"
  - "\u041E VAnimal\n\nVAnimal \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043C\u0438\u0440\u044B
    VRChat \u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u043C
    \u0441 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438, \u0438 \u0438\u0433\u0440\u0430\u0445
    \u0441 \u043D\u0438\u043C\u0438. \u041F\u043E-\u044F\u043F\u043E\u043D\u0441\u043A\u0438
    \u043D\u0430\u0441 \u0442\u0430\u043A\u0436\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442
    \xAB\u0412\u0430\u043D\u0438\u043C\u0430\u0440\u0443\xBB (\u3070\u306B\u307E\u308B).\n\n\u0421\u043E\u0431\u0430\u043A\u0430
    \u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
    \u0435\u0451 \u0433\u043B\u0430\u0434\u044F\u0442.\n\u041F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
    \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439 \u043C\u044F\u0447.\n\u0417\u0430\u0441\u044B\u043F\u0430\u0435\u0442
    \u0443 \u0432\u0430\u0448\u0438\u0445 \u043D\u043E\u0433.\n\n\u041C\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
    Kominka Dog Run, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0445\u043E\u0442\u0435\u043B\u0438
    \u0432\u043C\u0435\u0441\u0442\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0442\u044C
    \u044D\u0442\u0438 \u043C\u043E\u043C\u0435\u043D\u0442\u044B \u0438\u0433\u0440\u044B
    \u0438 \u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0441 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438
    \u0432 VRChat.\n\n\u0412 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u043C\u044B
    \u0445\u043E\u0442\u0438\u043C \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
    \u043C\u0438\u0440\u044B, \u0433\u0434\u0435 \u043C\u043E\u0436\u043D\u043E \u0433\u0443\u043B\u044F\u0442\u044C
    \u0441 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0445
    \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0430\u0445, \u043C\u044B\u0442\u044C
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0438 \u0438\u0433\u0440\u0430\u0442\u044C
    \u0441 \u043D\u0438\u043C\u0438 \u0438\u043B\u0438 \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0442\u044C
    \u0437\u0430 \u043D\u0438\u043C\u0438 \u0432 \u043C\u0435\u0441\u0442\u0435 \u0432\u0440\u043E\u0434\u0435
    \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043D\u043E\u0439 \u043A\u043B\u0438\u043D\u0438\u043A\u0438.\n\n\u041F\u043E\u043C\u0438\u043C\u043E
    \u043C\u0438\u0440\u043E\u0432, \u043C\u044B \u0445\u043E\u0442\u0435\u043B\u0438
    \u0431\u044B \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0441\u043E\u0431\u044B\u0442\u0438\u044F
    \u2014 \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0442\u0443\u0440\u044B
    \u043F\u043E \u043C\u0438\u0440\u0430\u043C \u043E \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445.\n\n\u041D\u0430\u0434\u0435\u0435\u043C\u0441\u044F
    \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C
    \u043D\u043E\u0432\u044B\u0435 \u043C\u0435\u0441\u0442\u0430 \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u044B
    \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
    \u0432\u043C\u0435\u0441\u0442\u0435, \u0440\u0430\u0434\u0443\u044F\u0441\u044C
    \u0442\u043E\u043C\u0443, \u043A\u0430\u043A \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u043E\u0442\u043A\u043B\u0438\u043A\u0430\u044E\u0442\u0441\u044F
    \u043D\u0430 \u043D\u0430\u0441.\n\n\u041D\u043E\u0432\u043E\u0441\u0442\u0438
    \u043C\u044B \u043F\u0443\u0431\u043B\u0438\u043A\u0443\u0435\u043C \u0432 Discord.\n\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
    \u043C\u043E\u0436\u043D\u043E \u043F\u043E \u0441\u0441\u044B\u043B\u043A\u0435
    \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435 \u0433\u0440\u0443\u043F\u043F\u044B
    VAnimal \u0432 VRChat."
  - "\u041E VAnimal Trainer"
  - "\u041E VAnimal Trainer\n\nVAnimal Trainer \u2014 \u044D\u0442\u043E \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u043E
    \u043D\u0430 \u0441\u0440\u043E\u043A \u0434\u043B\u044F \u0442\u0435\u0445,
    \u043A\u0442\u043E \u0445\u043E\u0447\u0435\u0442 \u0438\u0433\u0440\u0430\u0442\u044C
    \u0441 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438 \u0431\u043E\u043B\u044C\u0448\u0435.\n\n\u0422\u0440\u0435\u043D\u0435\u0440
    \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0441\u043E\u0431\u0430\u043A,
    \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0437\u0430\u0431\u0435\u0433
    \u0438\u043B\u0438 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0434\u0432\u0443\u0445
    \u0441\u043E\u0431\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0438
    \u043F\u043E\u0438\u0433\u0440\u0430\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435.\n\n\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435
    \u043E\u0431\u0449\u0435\u0435 \u0444\u043E\u0442\u043E \u0441\u043E \u0432\u0441\u0435\u043C\u0438
    \u0438\u043B\u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u0437\u0430\u0431\u0435\u0433.\n\u0417\u0430\u043D\u044F\u0442\u0438\u044F\u043C\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
    \u0422\u0440\u0435\u043D\u0435\u0440, \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F
    \u0432\u0441\u0435, \u043A\u0442\u043E \u0437\u0434\u0435\u0441\u044C.\n\n\u041F\u043E\u0433\u043B\u0430\u0434\u0438\u0442\u044C
    \u0441\u043E\u0431\u0430\u043A\u0443, \u0431\u0440\u043E\u0441\u0438\u0442\u044C
    \u043C\u044F\u0447, \u043F\u043E\u0437\u0432\u0430\u0442\u044C \u0441\u043E\u0431\u0430\u043A\u0443
    \u043F\u043E\u0441\u043F\u0430\u0442\u044C \u0440\u044F\u0434\u043E\u043C \u2014\n\u044D\u0442\u0438
    \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0438\u0433\u0440\u044B \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0432\u0441\u0435\u043C.\n\n\u041D\u0430\u0440\u044F\u0434\u044B,
    \u0438\u0433\u0440\u0443\u0448\u043A\u0438 \u0438 \u0448\u043E\u0443 \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u0441\u044F
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u0438 \u0432 \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u043E
    \u0422\u0440\u0435\u043D\u0435\u0440\u0430 \u043D\u0435 \u0432\u0445\u043E\u0434\u044F\u0442.\n\n\u0412
    \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u043C\u0438\u0440\u0430\u0445 \u043C\u044B
    \u0442\u043E\u0436\u0435 \u0445\u043E\u0442\u0438\u043C \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0442\u044C
    \u0422\u0440\u0435\u043D\u0435\u0440\u0430\u043C \u0438\u0433\u0440\u044B \u0441
    \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438, \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0435
    \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u043C\u0435\u0441\u0442\u0443. \u0427\u0442\u043E
    \u0438\u043C\u0435\u043D\u043D\u043E \u0438 \u043A\u043E\u0433\u0434\u0430 \u2014
    \u0435\u0449\u0451 \u043D\u0435 \u0440\u0435\u0448\u0435\u043D\u043E.\n\n\u0427\u0435\u0442\u044B\u0440\u0435
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430 \u0441\u0440\u043E\u043A\u0430:\n1
    \u043C\u0435\u0441\u044F\u0446: 500 Credits\n3 \u043C\u0435\u0441\u044F\u0446\u0430:
    1 350 Credits (450 Credits \u0432 \u043C\u0435\u0441\u044F\u0446)\n6 \u043C\u0435\u0441\u044F\u0446\u0435\u0432:
    2 550 Credits (425 Credits \u0432 \u043C\u0435\u0441\u044F\u0446)\n12 \u043C\u0435\u0441\u044F\u0446\u0435\u0432:
    4 800 Credits (400 Credits \u0432 \u043C\u0435\u0441\u044F\u0446)\n\n\u0427\u043B\u0435\u043D\u0441\u0442\u0432\u043E
    \u043D\u0435 \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0435\u0442\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438."
  - '?'
  - "\u041A\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0444\u043E\u0442\u043E"
  - "\u0424\u043E\u0442\u043E \u0441\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
    \u0441\u0430\u043C\u0438, \u043A\u043E\u0433\u0434\u0430 \u0441\u043E\u0431\u0430\u043A\u0430
    \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u043C\u044F\u0447, \u043F\u043E\u043A\u0430
    \u0432\u044B \u0435\u0451 \u0433\u043B\u0430\u0434\u0438\u0442\u0435, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0437\u0430\u0431\u0435\u0433\u043E\u0432
    \u0438 \u0438\u0433\u0440 \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438.
    \u0412 \u0441\u043F\u0430\u043B\u044C\u043D\u0435 \u0441\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
    \u0438 \u0442\u043E, \u043A\u0430\u043A \u0432\u044B \u043E\u0442\u0434\u044B\u0445\u0430\u0435\u0442\u0435
    \u0432\u043C\u0435\u0441\u0442\u0435.\n\n\u0421\u043D\u0438\u043C\u043A\u0438
    \u0434\u0435\u043B\u0430\u044E\u0442\u0441\u044F \u0441 \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043A\u0430\u043C\u0438,
    \u0430 \u043D\u0435 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E.
    \u041D\u043E\u0432\u044B\u0435 \u0444\u043E\u0442\u043E \u0437\u0430\u043C\u0435\u043D\u044F\u044E\u0442
    \u0441\u0430\u043C\u044B\u0435 \u0441\u0442\u0430\u0440\u044B\u0435 \u0432 \u043A\u0430\u0436\u0434\u043E\u0439
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438.\n\n\u042D\u0442\u043E\u0442
    \u0430\u043B\u044C\u0431\u043E\u043C \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0430\u0448.
    \u0414\u0440\u0443\u0433\u0438\u0435 \u043B\u044E\u0434\u0438 \u0432\u0438\u0434\u044F\u0442
    \u043D\u0430 \u0441\u0432\u043E\u0438\u0445 \u0434\u043E\u0441\u043A\u0430\u0445
    \u0434\u0440\u0443\u0433\u0438\u0435 \u0444\u043E\u0442\u043E.\n\n\u041F\u043E\u0441\u043B\u0435
    \u0432\u044B\u0445\u043E\u0434\u0430 \u0444\u043E\u0442\u043E \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442.
    \u0427\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u0441\u043D\u0438\u043C\u043E\u043A \u043D\u0430 \u041F\u041A \u0438\u043B\u0438
    Quest, \u043F\u043E\u0434\u043D\u0435\u0441\u0438\u0442\u0435 \u043A \u043D\u0435\u043C\u0443
    \u043A\u0430\u043C\u0435\u0440\u0443 VRChat \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435.
    \u041D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435 \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C
    \u0444\u043E\u0442\u043E \u0438 \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435
    \u0441\u043A\u0440\u0438\u043D\u0448\u043E\u0442.\n\n\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0441\u044A\u0451\u043C\u043A\u0443 \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0432 \xAB\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430\xBB
    \u0440\u044F\u0434\u043E\u043C \u0441 \u0444\u043E\u0442\u043E\u0434\u043E\u0441\u043A\u043E\u0439."
  - "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
