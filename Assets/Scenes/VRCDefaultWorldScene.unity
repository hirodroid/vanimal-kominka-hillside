  - "\u8BD5\u7740\u6478\u6478\u5934\u3001\u8138\u988A\u548C\u4E0B\u5DF4\n\u7528\u53CC\u624B\u5B83\u4F1A\u66F4\u5F00\u5FC3"
  - "\u957F\u6309\u53F3\u6447\u6746\u5411\u4E0B\u6253\u5F00\u83DC\u5355\n\u88C5\u9970\u3001\u96F6\u98DF\u3001\u547C\u5524\u3001\u73A9\u5177\u3001\u706F\u5149\u79C0\u3001\u5149\u6548\u3001\u73A9\u800D"
  - "\u6309 T \u952E\u6253\u5F00\u83DC\u5355\n\u88C5\u9970\u3001\u96F6\u98DF\u3001\u547C\u5524\u3001\u73A9\u5177\u3001\u706F\u5149\u79C0\u3001\u5149\u6548\u3001\u73A9\u800D"
  - "\u70B9\u51FB\u753B\u9762\u4E0A\u7684\u201C\u83DC\u5355\u201D\n\u88C5\u9970\u3001\u96F6\u98DF\u3001\u547C\u5524\u3001\u73A9\u5177\u3001\u706F\u5149\u79C0\u3001\u5149\u6548\u3001\u73A9\u800D"
