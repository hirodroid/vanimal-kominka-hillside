    \u044F\u043A \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438."
  - "\u041D\u0430\u0437\u0430\u0434"
  - "\u041F\u043E\u0447\u0430\u0442\u0438 \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0438"
  - "\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u043F\u0430\u0440\u0443"
  - "\u0427\u0435\u043A\u0430\u0454\u043C\u043E \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F\u2026"
  - "\u041D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u043F\u043E\u0447\u0430\u0442\u0438.
    \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043F\u043E\u0442\u043E\u0447\u043D\u0435
    \u0437\u0430\u043D\u044F\u0442\u0442\u044F, \u0441\u043E\u0431\u0430\u043A \u0456
    \u043C\u0456\u0441\u0446\u0435."
  - "\u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456 \u043D\u0435\u043C\u0430\u0454.
    \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043F\u043E\u0442\u043E\u0447\u043D\u0435
    \u0437\u0430\u043D\u044F\u0442\u0442\u044F, \u043F\u0435\u0440\u0448 \u043D\u0456\u0436
    \u043F\u043E\u0432\u0442\u043E\u0440\u044E\u0432\u0430\u0442\u0438."
  - "\u0427\u0430\u0441 \u0433\u0440\u0443\u043F\u043E\u0432\u043E\u0433\u043E \u0444\u043E\u0442\u043E"
  - "\u0422\u0440\u0438\u0432\u0430\u044E\u0442\u044C \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0438"
  - "\u0427\u0430\u0441 \u0433\u0440\u0438"
  - "60 \u0441\u0435\u043A\u0443\u043D\u0434 \u0456\u0437 \u0432\u0456\u043B\u044C\u043D\u0438\u043C\u0438
    \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438. \u0414\u043E \u0433\u0440\u0443\u043F\u043E\u0432\u043E\u0433\u043E
