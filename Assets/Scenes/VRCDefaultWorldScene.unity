  - "\u0412 \u0456\u043C\u0435\u043D\u0456 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
    \u043B\u0456\u0442\u0435\u0440\u0438, \u0446\u0438\u0444\u0440\u0438, \u0445\u0456\u0440\u0430\u0433\u0430\u043D\u0443
    \u0442\u0430 \u043A\u0430\u0442\u0430\u043A\u0430\u043D\u0443"
