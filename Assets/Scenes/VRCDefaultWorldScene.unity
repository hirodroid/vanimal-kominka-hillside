  - "\u041F\u0440\u043E VAnimal\n\nVAnimal \u0441\u0442\u0432\u043E\u0440\u044E\u0454
    \u0441\u0432\u0456\u0442\u0438 VRChat \u043F\u0440\u043E \u0447\u0430\u0441,
    \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0439 \u0456\u0437 \u0442\u0432\u0430\u0440\u0438\u043D\u0430\u043C\u0438,
    \u0442\u0430 \u0456\u0433\u0440\u0438 \u0437 \u043D\u0438\u043C\u0438. \u042F\u043F\u043E\u043D\u0441\u044C\u043A\u043E\u044E
    \u043D\u0430\u0441 \u0442\u0430\u043A\u043E\u0436 \u043D\u0430\u0437\u0438\u0432\u0430\u044E\u0442\u044C
    \xAB\u0412\u0430\u043D\u0456\u043C\u0430\u0440\u0443\xBB (\u3070\u306B\u307E\u308B).\n\n\u0421\u043E\u0431\u0430\u043A\u0430
    \u0440\u0430\u0434\u0456\u0454, \u043A\u043E\u043B\u0438 \u0457\u0457 \u0433\u043B\u0430\u0434\u044F\u0442\u044C.\n\u041F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C
    \u043A\u0438\u043D\u0443\u0442\u0438\u0439 \u043C'\u044F\u0447.\n\u0417\u0430\u0441\u0438\u043D\u0430\u0454
    \u0431\u0456\u043B\u044F \u0432\u0430\u0448\u0438\u0445 \u043D\u0456\u0433.\n\n\u041C\u0438
    \u0437\u0440\u043E\u0431\u0438\u043B\u0438 Kominka Dog Run, \u0431\u043E \u0445\u043E\u0442\u0456\u043B\u0438
    \u0440\u0430\u0437\u043E\u043C \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0442\u0438
    \u0446\u0456 \u043C\u0438\u0442\u0456 \u0433\u0440\u0438 \u0442\u0430 \u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u043D\u043D\u044F
    \u0437 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438 \u0443 VRChat.\n\n\u0423
    \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u043C\u0443 \u043C\u0438
    \u0445\u043E\u0447\u0435\u043C\u043E \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438
    \u0441\u0432\u0456\u0442\u0438, \u0434\u0435 \u043C\u043E\u0436\u043D\u0430 \u0433\u0443\u043B\u044F\u0442\u0438
    \u0437 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438 \u043D\u0430 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0445
    \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0430\u0445, \u043C\u0438\u0442\u0438
    \u0442\u0432\u0430\u0440\u0438\u043D \u0456 \u0433\u0440\u0430\u0442\u0438\u0441\u044F
    \u0437 \u043D\u0438\u043C\u0438 \u0430\u0431\u043E \u0434\u043E\u0433\u043B\u044F\u0434\u0430\u0442\u0438
    \u0437\u0430 \u043D\u0438\u043C\u0438 \u0432 \u043C\u0456\u0441\u0446\u0456 \u043D\u0430
    \u043A\u0448\u0442\u0430\u043B\u0442 \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043D\u043E\u0457
    \u043A\u043B\u0456\u043D\u0456\u043A\u0438.\n\n\u041E\u043A\u0440\u0456\u043C
    \u0441\u0432\u0456\u0442\u0456\u0432, \u043C\u0438 \u0445\u043E\u0442\u0456\u043B\u0438
    \u0431 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438 \u043F\u043E\u0434\u0456\u0457
    \u2014 \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0442\u0443\u0440\u0438
    \u0441\u0432\u0456\u0442\u0430\u043C\u0438 \u043F\u0440\u043E \u0442\u0432\u0430\u0440\u0438\u043D.\n\n\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u0454\u043C\u043E\u0441\u044F
    \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u0432\u043E \u0434\u043E\u0434\u0430\u0432\u0430\u0442\u0438
    \u043D\u043E\u0432\u0456 \u043C\u0456\u0441\u0446\u044F \u0442\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u0438
    \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438 \u0447\u0430\u0441 \u0440\u0430\u0437\u043E\u043C,
    \u0442\u0456\u0448\u0430\u0447\u0438\u0441\u044C \u0442\u0438\u043C, \u044F\u043A
    \u043F\u043E-\u0440\u0456\u0437\u043D\u043E\u043C\u0443 \u0442\u0432\u0430\u0440\u0438\u043D\u0438
    \u0432\u0456\u0434\u0433\u0443\u043A\u0443\u044E\u0442\u044C\u0441\u044F \u043D\u0430
    \u043D\u0430\u0441.\n\n\u041D\u043E\u0432\u0438\u043D\u0438 \u043C\u0438 \u043F\u0443\u0431\u043B\u0456\u043A\u0443\u0454\u043C\u043E
    \u0432 Discord.\n\u041F\u0440\u0438\u0454\u0434\u043D\u0430\u0442\u0438\u0441\u044F
    \u043C\u043E\u0436\u043D\u0430 \u0437\u0430 \u043F\u043E\u0441\u0438\u043B\u0430\u043D\u043D\u044F\u043C
    \u043D\u0430 \u0441\u0442\u043E\u0440\u0456\u043D\u0446\u0456 \u0433\u0440\u0443\u043F\u0438
    VAnimal \u0443 VRChat."
  - "\u041F\u0440\u043E VAnimal Trainer"
  - "\u041F\u0440\u043E VAnimal Trainer\n\nVAnimal Trainer \u2014 \u0446\u0435 \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u043E
    \u043D\u0430 \u0441\u0442\u0440\u043E\u043A \u0434\u043B\u044F \u0442\u0438\u0445,
    \u0445\u0442\u043E \u0445\u043E\u0447\u0435 \u0433\u0440\u0430\u0442\u0438\u0441\u044F
    \u0437 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438 \u0431\u0456\u043B\u044C\u0448\u0435.\n\n\u0422\u0440\u0435\u043D\u0435\u0440
    \u043C\u043E\u0436\u0435 \u0437\u0456\u0431\u0440\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u043A,
    \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0438
    \u0430\u0431\u043E \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0434\u0432\u043E\u0445
    \u0441\u043E\u0431\u0430\u043A, \u0449\u043E\u0431 \u0432\u043E\u043D\u0438 \u043F\u043E\u0433\u0440\u0430\u043B\u0438\u0441\u044F
    \u0440\u0430\u0437\u043E\u043C.\n\n\u0417\u0440\u043E\u0431\u0456\u0442\u044C
    \u0441\u043F\u0456\u043B\u044C\u043D\u0435 \u0444\u043E\u0442\u043E \u0437 \u0443\u0441\u0456\u043C\u0430
    \u0430\u0431\u043E \u043F\u043E\u0434\u0438\u0432\u0456\u0442\u044C\u0441\u044F
    \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0438.\n\u0417\u0430\u043D\u044F\u0442\u0442\u044F\u043C\u0438,
    \u044F\u043A\u0456 \u043F\u043E\u0447\u0438\u043D\u0430\u0454 \u0422\u0440\u0435\u043D\u0435\u0440,
    \u043C\u043E\u0436\u0443\u0442\u044C \u0442\u0456\u0448\u0438\u0442\u0438\u0441\u044F
    \u0432\u0441\u0456, \u0445\u0442\u043E \u0442\u0443\u0442.\n\n\u041F\u043E\u0433\u043B\u0430\u0434\u0438\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A\u0443, \u043A\u0438\u043D\u0443\u0442\u0438 \u043C'\u044F\u0447,
    \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u043A\u0443
    \u043F\u043E\u0441\u043F\u0430\u0442\u0438 \u043F\u043E\u0440\u0443\u0447 \u2014\n\u0446\u0456
    \u0437\u0432\u0438\u0447\u043D\u0456 \u0456\u0433\u0440\u0438 \u0439 \u0434\u0430\u043B\u0456
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456 \u0432\u0441\u0456\u043C.\n\n\u0412\u0431\u0440\u0430\u043D\u043D\u044F,
    \u0456\u0433\u0440\u0430\u0448\u043A\u0438 \u0442\u0430 \u0448\u043E\u0443 \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u044C\u0441\u044F
    \u043E\u043A\u0440\u0435\u043C\u043E \u0439 \u0434\u043E \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u0430
    \u0422\u0440\u0435\u043D\u0435\u0440\u0430 \u043D\u0435 \u0432\u0445\u043E\u0434\u044F\u0442\u044C.\n\n\u0423
    \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0456\u0445 \u0441\u0432\u0456\u0442\u0430\u0445
    \u043C\u0438 \u0442\u0435\u0436 \u0445\u043E\u0447\u0435\u043C\u043E \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0432\u0430\u0442\u0438
    \u0422\u0440\u0435\u043D\u0435\u0440\u0430\u043C \u0456\u0433\u0440\u0438 \u0437
    \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438, \u0449\u043E \u043F\u0430\u0441\u0443\u044E\u0442\u044C
    \u043A\u043E\u0436\u043D\u043E\u043C\u0443 \u043C\u0456\u0441\u0446\u044E. \u0429\u043E
    \u0441\u0430\u043C\u0435 \u0439 \u043A\u043E\u043B\u0438 \u2014 \u0449\u0435
    \u043D\u0435 \u0432\u0438\u0440\u0456\u0448\u0435\u043D\u043E.\n\n\u0427\u043E\u0442\u0438\u0440\u0438
    \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0438 \u0441\u0442\u0440\u043E\u043A\u0443:\n1
    \u043C\u0456\u0441\u044F\u0446\u044C: 500 Credits\n3 \u043C\u0456\u0441\u044F\u0446\u0456:
    1 350 Credits (450 Credits \u043D\u0430 \u043C\u0456\u0441\u044F\u0446\u044C)\n6
    \u043C\u0456\u0441\u044F\u0446\u0456\u0432: 2 550 Credits (425 Credits \u043D\u0430
    \u043C\u0456\u0441\u044F\u0446\u044C)\n12 \u043C\u0456\u0441\u044F\u0446\u0456\u0432:
    4 800 Credits (400 Credits \u043D\u0430 \u043C\u0456\u0441\u044F\u0446\u044C)\n\n\u0427\u043B\u0435\u043D\u0441\u0442\u0432\u043E
    \u043D\u0435 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0454\u0442\u044C\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E."
  - '?'
  - "\u042F\u043A \u043F\u0440\u0430\u0446\u044E\u044E\u0442\u044C \u0444\u043E\u0442\u043E"
  - "\u0424\u043E\u0442\u043E \u0437\u043D\u0456\u043C\u0430\u044E\u0442\u044C\u0441\u044F
    \u0441\u0430\u043C\u0456, \u043A\u043E\u043B\u0438 \u0441\u043E\u0431\u0430\u043A\u0430
    \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C \u043C'\u044F\u0447, \u043F\u043E\u043A\u0438
    \u0432\u0438 \u0457\u0457 \u0433\u043B\u0430\u0434\u0438\u0442\u0435, \u0430
    \u0442\u0430\u043A\u043E\u0436 \u043F\u0456\u0434 \u0447\u0430\u0441 \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0456\u0432
    \u0442\u0430 \u0456\u0433\u043E\u0440 \u043C\u0456\u0436 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438.
    \u0423 \u0441\u043F\u0430\u043B\u044C\u043D\u0456 \u0437\u043D\u0456\u043C\u0430\u0454\u0442\u044C\u0441\u044F
    \u0439 \u0442\u0435, \u044F\u043A \u0432\u0438 \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u0432\u0430\u0454\u0442\u0435
    \u0440\u0430\u0437\u043E\u043C.\n\n\u0417\u043D\u0456\u043C\u043A\u0438 \u0440\u043E\u0431\u043B\u044F\u0442\u044C\u0441\u044F
    \u0437 \u043F\u0440\u043E\u043C\u0456\u0436\u043A\u0430\u043C\u0438, \u0430 \u043D\u0435
    \u0431\u0435\u0437\u043F\u0435\u0440\u0435\u0440\u0432\u043D\u043E. \u041D\u043E\u0432\u0456
    \u0444\u043E\u0442\u043E \u0437\u0430\u043C\u0456\u043D\u044E\u044E\u0442\u044C
    \u043D\u0430\u0439\u0441\u0442\u0430\u0440\u0456\u0448\u0456 \u0432 \u043A\u043E\u0436\u043D\u0456\u0439
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457.\n\n\u0426\u0435\u0439
    \u0430\u043B\u044C\u0431\u043E\u043C \u043B\u0438\u0448\u0435 \u0432\u0430\u0448.
    \u0406\u043D\u0448\u0456 \u043B\u044E\u0434\u0438 \u0431\u0430\u0447\u0430\u0442\u044C
    \u043D\u0430 \u0441\u0432\u043E\u0457\u0445 \u0434\u043E\u0448\u043A\u0430\u0445
    \u0456\u043D\u0448\u0456 \u0444\u043E\u0442\u043E.\n\n\u041F\u0456\u0441\u043B\u044F
    \u0432\u0438\u0445\u043E\u0434\u0443 \u0444\u043E\u0442\u043E \u0437\u043D\u0438\u043A\u0430\u044E\u0442\u044C.
    \u0429\u043E\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0437\u043D\u0456\u043C\u043E\u043A
    \u043D\u0430 \u041F\u041A \u0430\u0431\u043E Quest, \u043F\u0456\u0434\u043D\u0435\u0441\u0456\u0442\u044C
    \u0434\u043E \u043D\u044C\u043E\u0433\u043E \u043A\u0430\u043C\u0435\u0440\u0443
    VRChat \u0456 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0443\u0439\u0442\u0435.
    \u041D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0456 \u0442\u043E\u0440\u043A\u043D\u0456\u0442\u044C\u0441\u044F
    \u0444\u043E\u0442\u043E \u0442\u0430 \u0437\u0440\u043E\u0431\u0456\u0442\u044C
    \u0437\u043D\u0456\u043C\u043E\u043A \u0435\u043A\u0440\u0430\u043D\u0430.\n\n\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0443
    \u0437\u0439\u043E\u043C\u043A\u0443 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043C\u043A\u043D\u0443\u0442\u0438
    \u0432 \xAB\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F\u0445
    \u044F\u043A\u043E\u0441\u0442\u0456\xBB \u043F\u043E\u0440\u0443\u0447 \u0456\u0437
    \u0444\u043E\u0442\u043E\u0434\u043E\u0448\u043A\u043E\u044E."
  - "\u0417\u0430\u043A\u0440\u0438\u0442\u0438"
  - "\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u044F\u043A\u043E\u0441\u0442\u0456"
  - "2K 2560\xD71440"
  - "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0430 1280\xD7720"
  - "\u0417\u0439\u043E\u043C\u043A\u0430 \u0412\u0418\u041C\u041A"
  - "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u044C\u2026"
  - "\u0417\u043C\u0456\u043D\u044E\u0454\u043C\u043E \u044F\u043A\u0456\u0441\u0442\u044C,
    \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044E\u0447\u0438 \u0432\u0430\u0448\u0456
    \u0444\u043E\u0442\u043E\u2026"
  - "\u041D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u043C\u0456\u043D\u0438\u0442\u0438
    \u044F\u043A\u0456\u0441\u0442\u044C. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044C
    \xAB\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0430\xBB \u0449\u0435 \u0440\u0430\u0437."
  - "\u042F\u043A\u0456\u0441\u0442\u044C 2K \u0437\u0430\u0441\u0442\u043E\u0441\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
    \u0434\u043E \u0444\u043E\u0442\u043E, \u0437\u043D\u044F\u0442\u0438\u0445 \u043F\u0456\u0441\u043B\u044F
    \u043F\u0435\u0440\u0435\u043C\u0438\u043A\u0430\u043D\u043D\u044F. \u0423\u0436\u0435
    \u0437\u043D\u044F\u0442\u0456 \u0444\u043E\u0442\u043E \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u0456\u0448\u0438\u043C\u0438
    \u043D\u0435 \u0441\u0442\u0430\u043D\u0443\u0442\u044C.\n\u041F\u0440\u0438
    \u0437\u043C\u0456\u043D\u0456 \u044F\u043A\u043E\u0441\u0442\u0456 \u0444\u043E\u0442\u043E
    \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044E\u0442\u044C\u0441\u044F. \u0414\u0435\u0442\u0430\u043B\u0456,
    \u0432\u0442\u0440\u0430\u0447\u0435\u043D\u0456 \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0456
    \u043D\u0430 \xAB\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0443\xBB, \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F\u043C
    \u0434\u043E 2K \u043D\u0435 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C\u0441\u044F.\n\u0412\u0418\u041C\u041A
    \u0437\u0443\u043F\u0438\u043D\u044F\u0454 \u043D\u043E\u0432\u0456 \u0437\u043D\u0456\u043C\u043A\u0438.
    \u041D\u0430\u044F\u0432\u043D\u0456 \u0444\u043E\u0442\u043E \u0439 \u0434\u0430\u043B\u0456
    \u043C\u043E\u0436\u043D\u0430 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0430\u0442\u0438
    \u0442\u0430 \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u0438.\n\u0426\u0435
    \u0441\u0442\u043E\u0441\u0443\u0454\u0442\u044C\u0441\u044F \u043B\u0438\u0448\u0435
    \u0432\u0430\u0448\u0438\u0445 \u0444\u043E\u0442\u043E. \u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
    \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F \u0434\u043E
    \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0432\u0456\u0437\u0438\u0442\u0443."
  - "\u0421\u043E\u0431\u0430\u043A\u0438 \u0432 \u0441\u0430\u0434\u0443"
  - "\u0412\u0438\u0431\u0435\u0440\u0438 \u0441\u043E\u0431\u0430\u043A\u0443, \u0449\u043E\u0431
    \u043F\u043E\u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0442\u0438\u0441\u044F"
  - "\u0406\u043C\u0435\u043D\u0430 \u0442\u0430 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u044F
    \u0432\u0438\u0434\u0438\u043C\u0456 \u043B\u0438\u0448\u0435 \u0432\u0430\u043C"
  - "\u0412\u0430\u0448\u0435 \u0456\u043C'\u044F \u0434\u043B\u044F \u0446\u0456\u0454\u0457
    \u0441\u043E\u0431\u0430\u043A\u0438 (\u0434\u043E 12 \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0432)"
