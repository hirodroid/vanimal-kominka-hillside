  - Pumpkin Parade
  - "\uBC24\uC758 \uC815\uC6D0\xB7120\uCD08\xB7\uD310\uB9E4\uB294 10/31\uAE4C\uC9C0"
  - "\uC791\uC740 \uC720\uB839\uC744 \uB530\uB77C \uAC15\uC544\uC9C0\uB4E4\uC774
    \uD638\uBC15 \uBD88\uBE5B\uC758 \uAE38\uC744 \uAC78\uC5B4\uAC11\uB2C8\uB2E4.
    \uD560\uB85C\uC708 \uC804\uC6A9 \uB77C\uC774\uBE0C."
  - "\uC720\uB839\uC774 \uB2E4\uC74C \uBD88\uBE5B\uC73C\uB85C \uAC74\uB108\uAC08
    \uB54C\uB9C8\uB2E4 \uC18C\uB9AC\uAC00 \uB300\uB2F5\uD558\uACE0, \uD589\uC9C4\uC744
    \uB530\uB77C \uD638\uBC15\uC774 \uCF1C\uC9D1\uB2C8\uB2E4. \uB9C8\uC9C0\uB9C9\uC5D0\uB294
    \uAC15\uC544\uC9C0\uB4E4\uC774 \uAC1D\uC11D\uC744 \uD5A5\uD574 \uC549\uC2B5\uB2C8\uB2E4."
  - "\uD560\uB85C\uC708 \uC774\uBCA4\uD2B8\xB7\uD55C\uC815 \uB77C\uC774\uBE0C \"Pumpkin
    Parade\" \uAE30\uAC04 \uD55C\uC815 \uD310\uB9E4 \uC911 (10/31\uAE4C\uC9C0)"
  - "\uD560\uB85C\uC708 \uD55C\uC815 \uB77C\uC774\uBE0C \"Pumpkin Parade\"\uB97C
    \uBCF4\uC720 \uC911\uC785\uB2C8\uB2E4 (\uD310\uB9E4\uB294 10/31\uAE4C\uC9C0)"
  - "\uD310\uB9E4 \uC885\uB8CC"
  - "\uD310\uB9E4\uB294 10/31\uB85C \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uC0AC \uB454
    \uBD84\uC740 11\uC6D4 \uC774\uD6C4\uC5D0\uB3C4 \uADF8\uB300\uB85C \uAC1C\uCD5C\xB7\uCC29\uC6A9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "<b>\uD3B8\uD558\uAC8C \uC9C0\uB0B4\uC138\uC694</b>\n\uC544\uBB34\uAC83\uB3C4
    \uAC00\uC9C0\uACE0 \uC788\uC9C0 \uC54A\uC544\uB3C4 \uB298 \uD558\uB358 \uB180\uC774\uB97C
    \uADF8\uB300\uB85C \uC990\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<b>\uAC15\uC544\uC9C0\uB97C
    \uC4F0\uB2E4\uB4EC\uAE30</b>\n\uBA38\uB9AC\xB7\uBCFC\xB7\uD131\uC744 \uC4F0\uB2E4\uB4EC\uC73C\uBA74
    \uAC15\uC544\uC9C0\uAC00 \uB300\uB2F5\uD569\uB2C8\uB2E4.\n\n<b>\uACF5 \uB358\uC9C0\uACE0
    \uBC1B\uAE30</b>\n\uACF5\uC744 \uC8FC\uC6CC \uB358\uC9C0\uBA74 \uAC15\uC544\uC9C0\uAC00
    \uBB3C\uC5B4 \uC635\uB2C8\uB2E4.\n\n<b>\uD568\uAED8 \uC26C\uAE30</b>\n\uBA54\uB274\uC5D0\uC11C
    [\uBD80\uB974\uAE30]\uB97C \uACE0\uB974\uC138\uC694. \uAC15\uC544\uC9C0\uAC00
    \uC640\uC11C \uACC1\uC5D0 \uB215\uC2B5\uB2C8\uB2E4.\n\n<b>\uC0AC\uC9C4 \uC990\uAE30\uAE30</b>\n\uC88B\uC740
    \uC21C\uAC04\uC740 \uC790\uB3D9\uC73C\uB85C \uCC0D\uD600 \uD207\uB9C8\uB8E8\uC758
    \uC0AC\uC9C4\uD310\uC5D0 \uB193\uC785\uB2C8\uB2E4.\n\n<b>\uBA54\uB274\uC5D0\uC11C
    \uD560 \uC218 \uC788\uB294 \uAC83</b>\n\uC5EC\uAE30\uC11C \uBCF4\uB0B8 \uC2DC\uAC04\uC774
    \uD3EC\uC778\uD2B8\uAC00 \uB418\uC5B4 \uC88B\uC544\uD558\uB294 \uAC83\uACFC \uBC14\uAFC0
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC704\uCABD \uD0ED\uC5D0\uC11C \uAC04\uC2DD\uC744
    \uAEBC\uB0B4\uAC70\uB098, \uAC15\uC544\uC9C0\uB97C \uAFB8\uBBF8\uAC70\uB098,
    \uC815\uC6D0\uC5D0\uC11C \uB77C\uC774\uBE0C\uB97C \uC5F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uB77C\uC774\uBE0C\uB294 \uADF8 \uC790\uB9AC\uC758 \uBAA8\uB450\uAC00 \uD568\uAED8
    \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<b>\uD3EC\uC778\uD2B8\uC640 \uD560\uC544\uBC84\uC9C0</b>\n\uC624\uB978\uCABD
    \uC704\uC758 [\uD3EC\uC778\uD2B8]\uC5D0\uC11C \uD3EC\uC778\uD2B8 \uC5BB\uB294
    \uBC29\uBC95\uACFC \uAE30\uD504\uD2B8 \uCF54\uB4DC\uB97C \uD655\uC778\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\n\uC815\uC6D0\uC758 \uD560\uC544\uBC84\uC9C0\uB294
    \uB178\uB294 \uBC95\uC744 \uC54C\uB824 \uC8FC\uACE0 \uCCAB \uD3EC\uC778\uD2B8\uB97C
    \uC90D\uB2C8\uB2E4.\n\n<b>\uBA54\uB274\uB97C \uC190\uC548\uC73C\uB85C \uBD80\uB974\uAE30</b>\nVR:
    \uC624\uB978\uCABD \uC2A4\uD2F1\uC744 \uC544\uB798\uB85C \uAE38\uAC8C\nDesktop:
    T \uD0A4\n\uC2A4\uB9C8\uD2B8\uD3F0: \uD654\uBA74\uC758 [\uBA54\uB274]"
