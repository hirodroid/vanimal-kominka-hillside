  - "\u53EF\u4EE5\u505A\u7684\u4E8B"
  - "\u5728\u8FD9\u513F\u53EF\u4EE5\u8FD9\u4E48\u8FC7\uFF0C\u987A\u5E8F\u968F\u4F60\u559C\u6B22\u3002\n\n\u6478\u6478\u72D7\u72D7\u3002\u6254\u6254\u7403\u3002\u5582\u70B9\u96F6\u98DF\u3002\u5149\u662F\u8FD9\u4E9B\uFF0C\u5C31\u5DF2\u7ECF\u8DB3\u591F\u4E86\u3002\n\n\u5728\u624B\u8FB9\u83DC\u5355\u7684\u201C\u547C\u5524\u201D\u91CC\uFF0C\u53EF\u4EE5\u628A\u72D7\u72D7\u53EB\u5230\u559C\u6B22\u7684\u5730\u65B9\uFF0C\u8BA9\u5B83\u5728\u8EAB\u8FB9\u7761\u4E00\u4F1A\u513F\u3002\u8BE6\u7EC6\u7684\uFF0C\u6211\u5728\u201C\u5173\u4E8E\u547C\u5524\u201D\u91CC\u8BB2\u3002\n\n\u597D\u7684\u77AC\u95F4\u4F1A\u53D8\u6210\u7167\u7247\uFF0C\u6392\u5728\u5ECA\u8FB9\u7684\u677F\u4E0A\u3002\u8FD9\u4E9B\u6211\u5728\u201C\u5173\u4E8E\u7167\u7247\u201D\u91CC\u8BB2\u3002\n\n\u60F3\u7ED9\u72D7\u6234\u88C5\u9970\u5C31\u9009\u201C\u88C5\u9970\u201D\uFF0C\u60F3\u6362\u629A\u6478\u65F6\u7684\u5149\uFF0C\u5C31\u9009\u201C\u5149\u6548\u201D\u3002\u201C\u706F\u5149\u79C0\u201D\u53EA\u8981\u6709\u4EBA\u529E\u8D77\u6765\uFF0C\u5728\u573A\u7684\u5927\u4F19\u513F\u90FD\u80FD\u4E00\u8D77\u770B\u3002\u201C\u73A9\u800D\u201D\u91CC\u6709\u72D7\u72D7\u89C6\u89D2\u76F8\u673A\u548C\u8BAD\u7EC3\u5458\u7684\u73A9\u6CD5\u3002\u529E\u706F\u5149\u79C0\u3001\u7528\u8BAD\u7EC3\u5458\u73A9\u6CD5\u7684\u6761\u4EF6\uFF0C\u8FD8\u6709\u4E70\u4E1C\u897F\u7684\u4E8B\uFF0C\u6211\u5728\u201C\u8D2D\u7269\u201D\u91CC\u8BB2\u3002\n\n\u65C1\u8FB9\u90A3\u5757\u677F\u4E0A\uFF0C\u53EF\u4EE5\u7ED9\u72D7\u8D77\u4E2A\u540D\u5B57\uFF0C\u4E5F\u80FD\u9009\u4E00\u53EA\u559C\u6B22\u7684\u3002\n\n\u4E0D\u7528\u5168\u90FD\u8BD5\u4E00\u904D\u3002\u5149\u662F\u770B\u7740\u4E5F\u633A\u597D\u7684\u3002"
  - "\u5728\u5367\u5BA4\u62CD\u5230\u7684\u4E00\u5F20"
  - "\u53EF\u4EE5\u548C\u72D7\u72D7\u4E00\u8D77\u8EBA\u7740\n\u83DC\u5355\u201C\u547C\u5524\u201D\u2192\u201C\u4FA7\u8EBA\u201D"
