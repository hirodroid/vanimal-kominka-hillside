    Credits \u0432 \u043C\u0435\u0441\u044F\u0446, \u043D\u0435 \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u043E"
  - "VAnimal Trainer \u2014 \u0430\u043A\u0442\u0438\u0432\u043D\u043E, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432\u0435\u0441\u044C \u0432\u0438\u0437\u0438\u0442, \u0435\u0441\u043B\u0438
    \u0431\u044B\u043B\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u043F\u0440\u0438
    \u0432\u0445\u043E\u0434\u0435"
  - "\u0422\u0440\u0435\u043D\u0435\u0440 \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u0441\u043E\u0431\u0430\u043A, \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u0437\u0430\u0431\u0435\u0433 \u0438 \u0434\u0430\u0442\u044C \u043B\u044E\u0431\u044B\u043C
    \u0434\u0432\u0443\u043C \u0441\u043E\u0431\u0430\u043A\u0430\u043C \u043F\u043E\u0438\u0433\u0440\u0430\u0442\u044C
    \u0432\u043C\u0435\u0441\u0442\u0435.\n\u041D\u0430\u0440\u044F\u0434\u044B,
    \u0438\u0433\u0440\u0443\u0448\u043A\u0438 \u0438 \u0448\u043E\u0443 \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u0441\u044F
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E. \u0414\u0440\u0443\u0437\u044C\u044F
    \u0431\u0435\u0437 \u0422\u0440\u0435\u043D\u0435\u0440\u0430 \u0432\u0441\u0451
    \u0440\u0430\u0432\u043D\u043E \u043C\u043E\u0433\u0443\u0442 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0432 \u0433\u0440\u0443\u043F\u043F\u043E\u0432\u044B\u0445 \u0444\u043E\u0442\u043E,
    \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0448\u043E\u0443 \u0438 \u0437\u0430\u0431\u0435\u0433\u0438.\n500
    Credits \u0437\u0430 1 \u043C\u0435\u0441\u044F\u0446 / 1 350 \u0437\u0430 3
    / 2 550 \u0437\u0430 6 / 4 800 \u0437\u0430 12. \u0411\u0435\u0437 \u0430\u0432\u0442\u043E\u043F\u0440\u043E\u0434\u043B\u0435\u043D\u0438\u044F;
    \u043F\u0440\u043E\u0434\u043B\u0435\u043D\u0438\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043A \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u043C\u0441\u044F \u0434\u043D\u044F\u043C."
  - "\u041F\u0440\u0430\u0432\u0430 \u0422\u0440\u0435\u043D\u0435\u0440\u0430, \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043F\u0440\u0438 \u0432\u0445\u043E\u0434\u0435, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442
