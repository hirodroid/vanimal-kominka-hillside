  - "\u041F\u043E\u0442\u044F\u0433\u0443\u0448\u043A\u0438 \u0438 \u0437\u0435\u0432\u043E\u043A"
  - "\u041E\u0434\u043D\u0430 \u043F\u043E\u043A\u0443\u043F\u043A\u0430 \u2014 \u0434\u043B\u044F
    \u0432\u0441\u0435\u0445 6 \u043F\u043E\u0440\u043E\u0434. \u0412\u044B\u0431\u0435\u0440\u0438
    \u0441\u043D\u043E\u0432\u0430, \u0447\u0442\u043E\u0431\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
  - "\u041E\u0442\u043C\u0435\u043D\u0430"
  - "\u0427\u0435\u0442\u044B\u0440\u0435 \u0431\u0430\u0437\u043E\u0432\u044B\u0435
    \u043F\u043E\u0437\u044B \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B.
    \u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u2014 \u043F\u043E 30pt \u0437\u0430
    \u043A\u0430\u0436\u0434\u043E\u0435, \u0434\u043B\u044F \u0432\u0441\u0435\u0445
    6 \u043F\u043E\u0440\u043E\u0434."
