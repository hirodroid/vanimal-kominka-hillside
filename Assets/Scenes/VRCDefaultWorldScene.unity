    \uBC29\uC1A1\uD558\uBA70 \uD504\uB85C\uADF8\uB7A8\uC740 \uB9E4\uB2EC \uAC31\uC2E0\uB429\uB2C8\uB2E4."
  - "\uD3B8\uC131\uD45C\xB7\uCD5C\uC2E0 \uC18C\uC2DD\uC740 X\uC5D0\uC11C"
  - "\uC9C0\uB0B4\uB294 \uBC95"
  - "\uC5EC\uAE30\uC11C \uC9C0\uB0B4\uB294 \uBC95\uC774\uB77C\uB124. \uC88B\uC544\uD558\uB294
    \uC21C\uC11C\uB300\uB85C \uD558\uBA74 \uB418\uB124.\n\n\uAC15\uC544\uC9C0\uB97C
    \uC4F0\uB2E4\uB4EC\uACE0, \uACF5\uC744 \uB358\uC9C0\uACE0, \uAC04\uC2DD\uC744
    \uC8FC\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uCDA9\uBD84\uD558\uB2E4\uB124.\n\n\uC190\uC548\uC758
    \uBA54\uB274 [\uBD80\uB974\uAE30]\uC5D0\uC11C \uC6D0\uD558\uB294 \uACF3\uC73C\uB85C
    \uAC15\uC544\uC9C0\uB97C \uBD88\uB7EC \uACC1\uC5D0\uC11C \uC790\uAC8C \uD560
    \uC218 \uC788\uB124. \uC790\uC138\uD55C \uAC83\uC740 [\uAC15\uC544\uC9C0 \uBD80\uB974\uAE30]\uC5D0
    \uC788\uB124.\n\n\uC88B\uC740 \uC21C\uAC04\uC740 \uC0AC\uC9C4\uC774 \uB418\uC5B4
    \uD207\uB9C8\uB8E8\uC758 \uD310\uC5D0 \uAC78\uB9B0\uB2E4\uB124. [\uC0AC\uC9C4]\uC5D0\uC11C
    \uC774\uC57C\uAE30\uD558\uC9C0.\n\n[\uAFB8\uBBF8\uAE30]\uC5D0\uC11C\uB294 \uAC15\uC544\uC9C0\uB97C
    \uAFB8\uBBF8\uACE0, [\uD30C\uD2F0\uD074]\uC5D0\uC11C\uB294 \uC4F0\uB2E4\uB4EC\uC744
    \uB54C\uC758 \uBE5B\uC744 \uBC14\uAFC0 \uC218 \uC788\uB124. [\uB77C\uC774\uBE0C]\uB294
    \uB204\uAD70\uAC00 \uC5F4\uBA74 \uADF8 \uC790\uB9AC\uC758 \uBAA8\uB450\uAC00
    \uD568\uAED8 \uBCFC \uC218 \uC788\uC9C0. [\uB180\uAE30]\uC5D0\uB294 \uAC15\uC544\uC9C0
    \uC2DC\uC810 \uCE74\uBA54\uB77C\uC640 \uD2B8\uB808\uC774\uB108 \uB180\uC774\uAC00
    \uC788\uB124. \uB77C\uC774\uBE0C\uC640 \uD2B8\uB808\uC774\uB108 \uC774\uC6A9
    \uC870\uAC74, \uC1FC\uD551\uC5D0 \uB300\uD574\uC11C\uB294 [\uC1FC\uD551]\uC5D0\uC11C
    \uC774\uC57C\uAE30\uD574 \uC8FC\uACA0\uB124.\n\n\uC606\uC5D0 \uC788\uB294 \uD310\uC5D0\uC11C\uB294
    \uAC15\uC544\uC9C0\uC5D0\uAC8C \uC774\uB984\uC744 \uBD99\uC774\uACE0 \uB9C8\uC74C\uC5D0
    \uB4DC\uB294 \uC544\uC774\uB97C \uACE0\uB97C \uC218 \uC788\uB124.\n\n\uC804\uBD80
    \uD574 \uBCF4\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uB124. \uADF8\uC800 \uBC14\uB77C\uBCF4\uACE0
    \uC788\uC5B4\uB3C4 \uC88B\uC740 \uAC70\uB77C\uB124."
  - "\uCE68\uC2E4\uC5D0\uC11C \uCC0D\uD78C \uD55C \uC7A5"
  - "\uAC15\uC544\uC9C0 \uACC1\uC5D0\uC11C \uC798 \uC218 \uC788\uC2B5\uB2C8\uB2E4\n\uBA54\uB274
    [\uBD80\uB974\uAE30] \u2192 [\uC606\uC73C\uB85C \uB215\uAE30]"
  - "\uC190\uC744 \uD718\uB450\uB974\uACE0 \uB193\uC73C\uBA74 \uB358\uC838\uC9D1\uB2C8\uB2E4"
  - "\uD074\uB9AD\uC744 \uAE38\uAC8C \uB20C\uB7EC \uBAA8\uC558\uB2E4\uAC00 \uB193\uC73C\uBA74
    \uB358\uC838\uC9D1\uB2C8\uB2E4"
  - "\uB358\uC9C0\uAE30 \uC870\uC791\uC744 \uAE38\uAC8C \uB204\uB978 \uB4A4 \uB193\uC73C\uBA74
    \uB358\uC838\uC9D1\uB2C8\uB2E4"
  - "\uBA38\uB9AC\xB7\uBCFC\xB7\uD131\uC744 \uC4F0\uB2E4\uB4EC\uC5B4 \uBCF4\uC138\uC694\n\uB450
    \uC190\uC73C\uB85C \uD558\uBA74 \uB354 \uC88B\uC544\uD569\uB2C8\uB2E4"
  - "\uC624\uB978\uCABD \uC2A4\uD2F1\uC744 \uC544\uB798\uB85C \uAE38\uAC8C \uB20C\uB7EC
    \uBA54\uB274\n\uAFB8\uBBF8\uAE30\xB7\uAC04\uC2DD\xB7\uBD80\uB974\uAE30\xB7\uC7A5\uB09C\uAC10\xB7\uB77C\uC774\uBE0C\xB7\uD30C\uD2F0\uD074\xB7\uB180\uAE30"
  - "T \uD0A4\uB85C \uBA54\uB274\n\uAFB8\uBBF8\uAE30\xB7\uAC04\uC2DD\xB7\uBD80\uB974\uAE30\xB7\uC7A5\uB09C\uAC10\xB7\uB77C\uC774\uBE0C\xB7\uD30C\uD2F0\uD074\xB7\uB180\uAE30"
  - "\uD654\uBA74\uC758 [\uBA54\uB274]\uC5D0\uC11C\n\uAFB8\uBBF8\uAE30\xB7\uAC04\uC2DD\xB7\uBD80\uB974\uAE30\xB7\uC7A5\uB09C\uAC10\xB7\uB77C\uC774\uBE0C\xB7\uD30C\uD2F0\uD074\xB7\uB180\uAE30"
  - "\uAC15\uC544\uC9C0 \uACC1\uC5D0\uC11C \uC798 \uC218 \uC788\uC2B5\uB2C8\uB2E4\n\uC190\uC548\uC758
    \uBA54\uB274 [\uBD80\uB974\uAE30] \u2192 [\uC606\uC73C\uB85C \uB215\uAE30]\uC5D0\uC11C"
  - "Kominka Dog Run\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4"
  - "\uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5B4\uB3C4 \u2014 \uB298 \uD558\uB358 \uB180\uC774\uB294
    \uADF8\uB300\uB85C \uC5EC\uAE30\uC5D0\n- \uC4F0\uB2E4\uB4EC\uAE30: \uBA38\uB9AC\xB7\uBCFC\xB7\uD131\uC744
    \uC4F0\uB2E4\uB4EC\uC73C\uBA74 \uAC15\uC544\uC9C0\uAC00 \uB300\uB2F5\uD569\uB2C8\uB2E4\n-
    \uACF5 \uB358\uC9C0\uAE30: \uACF5\uC744 \uC8FC\uC6CC \uB358\uC9C0\uBA74 \uAC15\uC544\uC9C0\uAC00
    \uBB3C\uC5B4 \uC635\uB2C8\uB2E4\n- \uACC1\uC5D0\uC11C \uC7AC\uC6B0\uAE30: \uC774
    \uD310\uC758 [\uBD80\uB974\uAE30]\uC5D0\uC11C. \uAC15\uC544\uC9C0\uAC00 \uC640\uC11C
    \uACC1\uC5D0 \uB215\uC2B5\uB2C8\uB2E4\n- \uC0AC\uC9C4: \uC88B\uC740 \uC21C\uAC04\uC740
    \uC790\uB3D9\uC73C\uB85C \uCC0D\uD600 \uD207\uB9C8\uB8E8\uC758 \uC0AC\uC9C4\uD310\uC5D0
    \uB193\uC785\uB2C8\uB2E4\n\n\uC774 \uD310\uC73C\uB85C \uD560 \uC218 \uC788\uB294
    \uAC83 \u2014 \uC5EC\uAE30\uC11C \uBCF4\uB0B8 \uC2DC\uAC04\uC774 \uD3EC\uC778\uD2B8\uAC00
    \uB418\uC5B4 \uC88B\uC544\uD558\uB294 \uAC83\uACFC \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4\n-
    \uAC04\uC2DD\xB7\uAFB8\uBBF8\uAE30\xB7\uB77C\uC774\uBE0C: \uC190\uC5D0 \uAEBC\uB0B4\uAE30,
    \uAC15\uC544\uC9C0\uC5D0\uAC8C \uCC29\uC6A9, \uC815\uC6D0\uC5D0\uC11C \uC5F4\uAE30
    (\uB77C\uC774\uBE0C\uB294 \uADF8 \uC790\uB9AC\uC758 \uBAA8\uB450\uAC00 \uD568\uAED8
    \uBD05\uB2C8\uB2E4). \uC704\uCABD \uD0ED\uC5D0\uC11C\n- \uD3EC\uC778\uD2B8\uC640
    \uD560\uC544\uBC84\uC9C0: \uC624\uB978\uCABD \uC704 [\uD3EC\uC778\uD2B8]\uC5D0
    \uC5BB\uB294 \uBC29\uBC95\uACFC \uAE30\uD504\uD2B8 \uCF54\uB4DC\uAC00 \uC788\uC2B5\uB2C8\uB2E4.
    \uC815\uC6D0\uC758 \uD560\uC544\uBC84\uC9C0\uB294 \uB178\uB294 \uBC95\uC744 \uC54C\uB824
    \uC8FC\uACE0 \uCCAB \uD3EC\uC778\uD2B8\uB97C \uC90D\uB2C8\uB2E4"
  - "\uB2EB\uC740 \uB4A4\uC5D0\uB3C4 \uC624\uB978\uCABD \uC2A4\uD2F1\uC744 \uC544\uB798\uB85C
    \uAE38\uAC8C \uB204\uB974\uBA74 \uC5B8\uC81C\uB4E0 \uB2E4\uC2DC \uBD80\uB97C
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB2E4\uC2DC \uC77D\uC73C\uB824\uBA74 \uC124\uC815
    \u2192 \uC778\uD3EC\uBA54\uC774\uC158 \u2192 \uC2DC\uC791\uD558\uAE30"
  - "\uB2EB\uC740 \uB4A4\uC5D0\uB3C4 T \uD0A4\uB85C \uC5B8\uC81C\uB4E0 \uB2E4\uC2DC
    \uBD80\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB2E4\uC2DC \uC77D\uC73C\uB824\uBA74
    \uC124\uC815 \u2192 \uC778\uD3EC\uBA54\uC774\uC158 \u2192 \uC2DC\uC791\uD558\uAE30"
