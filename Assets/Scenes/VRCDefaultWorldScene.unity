  - "\u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F"
  - "\u041F\u0440\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0433\u043E
    \u0428\u0406"
  - "\u042F\u043A \u0456\u043D\u0436\u0435\u043D\u0435\u0440-\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0456\u0441\u0442
    \u044F \u0449\u043E\u0434\u043D\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u044E
    \u0428\u0406 \u0432 \u0440\u043E\u0437\u0440\u043E\u0431\u0446\u0456.\n\n\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0438\u0439
    \u0428\u0406 \u2014 \u043E\u0434\u0438\u043D \u0437 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432
    \u0456 \u043F\u0456\u0434 \u0447\u0430\u0441 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F
    \u0446\u044C\u043E\u0433\u043E \u0441\u0432\u0456\u0442\u0443. \u0412\u0456\u043D
    \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454 \u043F\u0438\u0441\u0430\u0442\u0438
    \u0442\u0430 \u043F\u0440\u0430\u0432\u0438\u0442\u0438 \u043A\u043E\u0434, \u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u0442\u0438
    \u0439 \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u0430\u0442\u0438, \u0430
    \u043F\u0440\u043E\u0454\u043A\u0442\u0443\u0432\u0430\u043D\u043D\u044F, \u0440\u0435\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044E,
    \u0434\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u044F \u0442\u0430 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0443
