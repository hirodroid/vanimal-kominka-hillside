    \u0434\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0432\u0456\u0437\u0438\u0442\u0443"
  - "\u041F\u0456\u0434 \u0447\u0430\u0441 \u043F\u0435\u0440\u0435\u043C\u0438\u043A\u0430\u043D\u043D\u044F
    \u043D\u0435\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0456 \u0437\u043C\u0456\u043D\u0438
    \u0432\u0442\u0440\u0430\u0447\u0430\u044E\u0442\u044C\u0441\u044F"
  - "\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438"
  - "\u0412\u043B\u0430\u0441\u043D\u0456 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
    \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E"
  - "\u041D\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E. \u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
    \xAB\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438\xBB."
  - "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u044C"
  - "\u0412\u0432\u0435\u0434\u0456\u0442\u044C # \u0456 \u0448\u0456\u0441\u0442\u044C
    \u0448\u0456\u0441\u0442\u043D\u0430\u0434\u0446\u044F\u0442\u043A\u043E\u0432\u0438\u0445
    \u0446\u0438\u0444\u0440"
  - "\u0412\u0432\u0435\u0434\u0456\u0442\u044C \u0447\u0438\u0441\u043B\u043E, \u0434\u0435\u0441\u044F\u0442\u043A\u043E\u0432\u0438\u0439
    \u0440\u043E\u0437\u0434\u0456\u043B\u044C\u043D\u0438\u043A \u2014 \u043A\u0440\u0430\u043F\u043A\u0430
    (.)"
  - "\u041F\u043E\u0447\u0430\u0442\u043E\u043A > \u043A\u0456\u043D\u0435\u0446\u044C
    >= 0, \u0441\u0438\u043B\u0430 >= 0"
  - "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0456 \u0434\u0430\u043D\u0456
    \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456; \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F
    \xAB\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439\xBB"
  - "\u041F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0444\u043E\u0442\u043E"
  - "\u0417\u0430\u043A\u0440\u0438\u0442\u0438"
  - "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u0437 \u0434\u0456\u0434\u0443\u0441\u0435\u043C"
  - "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E
    \u0434\u043E \u043C\u043E\u0433\u043E \u0441\u0430\u0434\u0443.\n\u041F\u043E\u0447\u0443\u0432\u0430\u0439\u0441\u044F
    \u044F\u043A \u0443\u0434\u043E\u043C\u0430 \u0439 \u043F\u043E\u0431\u0443\u0434\u044C
    \u0456\u0437 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438.\n\u042F\u043A\u0449\u043E
    \u0449\u043E\u0441\u044C \u0446\u0456\u043A\u0430\u0432\u043E \u2014 \u043F\u0438\u0442\u0430\u0439."
  - "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E.
    \u0426\u0435 \u043C\u0456\u0439 \u0441\u0430\u0434.\n\n\u0412\u043F\u0435\u0440\u0448\u0435
    \u0442\u0443\u0442? \u0422\u0440\u0438\u043C\u0430\u0439: {0} \u0431\u0430\u043B\u0456\u0432.
    \u041E\u0431\u043C\u0456\u043D\u044F\u0439 \u0457\u0445 \u043D\u0430 \u0449\u043E
    \u0437\u0430\u0445\u043E\u0447\u0435\u0448.\n\n\u0413\u0440\u0430\u0439\u0441\u044F
    \u0437 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438, \u044F\u043A \u0434\u043E
    \u0432\u043F\u043E\u0434\u043E\u0431\u0438. \u041F\u0438\u0442\u0430\u0439 \u043F\u0440\u043E
    \u0449\u043E \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E."
  - "\u041C\u0435\u043D\u044E"
  - "\u042F\u043A \u0433\u043B\u0430\u0434\u0438\u0442\u0438"
  - "\u041F\u0440\u043E \u0441\u043E\u0431\u0430\u043A"
  - "\u041F\u0440\u043E \u0444\u043E\u0442\u043E"
  - "\u041F\u043E\u043A\u0443\u043F\u043A\u0438"
  - "\u041F\u0440\u043E \u043B\u0430\u0441\u043E\u0449\u0456"
  - "\u0411\u0443\u0432\u0430\u0439"
  - "\u042F\u043A \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u043A"
  - "\u0421\u043F\u0435\u0440\u0448\u0443 \u0441\u043F\u0440\u043E\u0431\u0443\u0439
    \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0441\u0432\u043E\u0454 \u043C\u0435\u043D\u044E.
    \u0423 VR \u0443\u0442\u0440\u0438\u043C\u0443\u0439 \u043F\u0440\u0430\u0432\u0438\u0439
    \u0441\u0442\u0456\u043A \u0434\u043E\u043D\u0438\u0437\u0443. \u041D\u0430 \u041F\u041A
    \u0431\u0435\u0437 VR \u043D\u0430\u0442\u0438\u0441\u043D\u0438 T. \u041D\u0430
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0456 \u0442\u043E\u0440\u043A\u043D\u0438\u0441\u044C
    \xAB\u041C\u0435\u043D\u044E\xBB \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456.\n\n\u0423\u0433\u043E\u0440\u0456
    \u0454 7 \u0432\u043A\u043B\u0430\u0434\u043E\u043A. \xAB\u0412\u0431\u0440\u0430\u043D\u043D\u044F\xBB
    \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u043F\u0440\u0438\u043A\u0440\u0430\u0441\u0438\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A\u0443. \xAB\u041B\u0430\u0441\u043E\u0449\u0456\xBB
    \u0434\u0456\u0441\u0442\u0430\u0454 \u043B\u0430\u0441\u043E\u0449\u0456 \u0442\u043E\u0431\u0456
    \u0432 \u0440\u0443\u043A\u0443. \xAB\u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438\xBB
    \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A\u0443 \u0434\u043E \u0441\u0435\u0431\u0435 \u0439
    \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u043F\u043E\u0437\u0443. \xAB\u0406\u0433\u0440\u0430\u0448\u043A\u0438\xBB
    \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454 \u0441\u043E\u0431\u0430\u0447\u0438\u0439
    \u043C'\u044F\u0447 \u0442\u043E\u0431\u0456 \u0432 \u0440\u0443\u043A\u0438.
    \xAB\u0428\u043E\u0443\xBB \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
    \u0448\u043E\u0443 \u0432 \u0441\u0430\u0434\u0443. \xAB\u0415\u0444\u0435\u043A\u0442\u0438\xBB
    \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443 \u0432\u0438\u0431\u0440\u0430\u0442\u0438
    \u0441\u044F\u0439\u0432\u043E \u043F\u0456\u0434 \u0447\u0430\u0441 \u0433\u043B\u0430\u0434\u0456\u043D\u043D\u044F.
    \xAB\u0406\u0433\u0440\u0438\xBB \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443
    \u043E\u0447\u0438\u043C\u0430 \u0441\u043E\u0431\u0430\u043A\u0438 \u0442\u0430
    \u0456\u0433\u0440\u0438 \u0422\u0440\u0435\u043D\u0435\u0440\u0430.\n\n\u041D\u0430\u0442\u0438\u0441\u043D\u0438
    \xAB\u0411\u0430\u043B\u0438\xBB \u0432\u0433\u043E\u0440\u0456, \u0449\u043E\u0431
    \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F, \u044F\u043A \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
    \u0431\u0430\u043B\u0438, \u0430\u0431\u043E \u0432\u0432\u0435\u0441\u0442\u0438
    \u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043A\u043E\u0432\u0438\u0439 \u043A\u043E\u0434.
    \u0423 \u0440\u043E\u0437\u0434\u0456\u043B\u0456 \xAB\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438\xBB
    \u043C\u043E\u0436\u043D\u0430 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438
    \u0433\u0443\u0447\u043D\u0456\u0441\u0442\u044C, \u043D\u0456\u0447\u043D\u0438\u0439
    \u0440\u0435\u0436\u0438\u043C, \u043C\u043E\u0432\u0443 \u0442\u0430 \u0440\u043E\u0437\u0434\u0456\u043B\u044C\u043D\u0443
    \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u0444\u043E\u0442\u043E.
    \u0422\u0430\u043C \u0454 \u0439 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
    \u0440\u0430\u0434\u0456\u043E \u0442\u0430 \u0441\u0435\u0440\u043F\u0430\u043D\u043A\u0443,
    \u0430\u043B\u0435 \u043E\u0431\u0438\u0434\u0432\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456
    \u043B\u0438\u0448\u0435 \u043D\u0430 \u041F\u041A. \u042F\u043A\u0449\u043E
    \u0442\u0438 \u0430\u0434\u043C\u0456\u043D\u0456\u0441\u0442\u0440\u0430\u0442\u043E\u0440,
    \u0442\u0430\u043C \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u043D\u0430
    \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0438 \u0432\u0441\u0456\u043C
    \u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u043A \u0456
    \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438 \u0448\u043E\u0443. \u0410\u0434\u043C\u0456\u043D\u0456\u0441\u0442\u0440\u0430\u0442\u043E\u0440
    \u0442\u0443\u0442 \u043E\u0437\u043D\u0430\u0447\u0430\u0454 \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430
    \u0446\u0456\u0454\u0457 \u043A\u0456\u043C\u043D\u0430\u0442\u0438. \u041A\u043E\u043B\u0438
    \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0430 \u043D\u0435\u043C\u0430\u0454,
    \u0439\u043E\u0433\u043E \u0437\u0430\u043C\u0456\u043D\u044E\u0454 Master. \u0423
    \u0440\u043E\u0437\u0434\u0456\u043B\u0456 \xAB\u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F\xBB
    \u0432 \u043C\u0435\u043D\u044E \xAB\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438\xBB
    \u043C\u043E\u0436\u043D\u0430 \u0442\u0430\u043A\u043E\u0436 \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u0442\u0438
    \xAB\u0417 \u0447\u043E\u0433\u043E \u043F\u043E\u0447\u0430\u0442\u0438\xBB.\n\n\u041A\u043E\u043B\u0438
    \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0448, \u043D\u0430\u0442\u0438\u0441\u043D\u0438
    \xAB\u0417\u0430\u043A\u0440\u0438\u0442\u0438\xBB. \u0423 VR \u0442\u0430 \u043D\u0430
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0456 \u043F\u043E\u0432\u0442\u043E\u0440\u0438
    \u0434\u0456\u044E, \u044F\u043A\u043E\u044E \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454\u0448
    \u043C\u0435\u043D\u044E, \u0456 \u0432\u043E\u043D\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u0442\u044C\u0441\u044F
    \u0434\u043E \u0440\u0443\u043A, \u043D\u0430\u0432\u0456\u0442\u044C \u044F\u043A\u0449\u043E
    \u0432\u043E\u043D\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
    \u0434\u0430\u043B\u0435\u043A\u043E. \u041D\u0430 \u041F\u041A \u0431\u0435\u0437
    VR \u043A\u043B\u0430\u0432\u0456\u0448\u0430 T \u043F\u043E \u0447\u0435\u0440\u0437\u0456
    \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454 \u0442\u0430 \u0437\u0430\u043A\u0440\u0438\u0432\u0430\u0454
    \u043C\u0435\u043D\u044E."
  - "\u0413\u043B\u0430\u0434\u044C \u0441\u043E\u0431\u0430\u043A\u0443 \u043F\u043E
    \u043C\u0430\u043A\u0456\u0432\u0446\u0456, \u043F\u043E \u0449\u043E\u043A\u0430\u0445
    \u0430\u0431\u043E \u043F\u0456\u0434 \u043F\u0456\u0434\u0431\u043E\u0440\u0456\u0434\u0434\u044F\u043C.
    \u0421\u043E\u0431\u0430\u043A\u0438 \u0440\u0430\u0434\u0456\u044E\u0442\u044C
    \u0456 \u043E\u0434\u043D\u0456\u0439 \u0440\u0443\u0446\u0456, \u0430 \u0434\u0432\u043E\u043C
    \u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u0435, \u0456 \u0441\u0432\u0456\u0442\u043B\u043E\u0432\u0456
    \u0435\u0444\u0435\u043A\u0442\u0438 \u0442\u0435\u0436 \u0437\u043C\u0456\u043D\u044E\u044E\u0442\u044C\u0441\u044F.\n\n\u0415\u0444\u0435\u043A\u0442\u0438
    \u0433\u043B\u0430\u0434\u0456\u043D\u043D\u044F \u043C\u043E\u0436\u043D\u0430
    \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0443 \u0432\u043A\u043B\u0430\u0434\u0446\u0456
    \xAB\u0415\u0444\u0435\u043A\u0442\u0438\xBB \u0443 \u0441\u0432\u043E\u0454\u043C\u0443
    \u043C\u0435\u043D\u044E. \u0404 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0456,
    \u0454 \u0437\u0430 \u0431\u0430\u043B\u0438, \u0430 \u0434\u0435\u044F\u043A\u0456
    \u0439\u0434\u0443\u0442\u044C \u0440\u0430\u0437\u043E\u043C \u0456\u0437 \u043F\u0440\u0438\u0434\u0431\u0430\u043D\u0438\u043C\u0438
    \u0448\u043E\u0443."
  - "\u041D\u0430\u0432\u0456\u0442\u044C \u043A\u043E\u043B\u0438 \u0457\u0445 \u043D\u0456\u0445\u0442\u043E
    \u043D\u0435 \u0447\u0456\u043F\u0430\u0454, \u0441\u043E\u0431\u0430\u043A\u0438
    \u0431\u0456\u0433\u0430\u044E\u0442\u044C \u043E\u0434\u043D\u0430 \u0437\u0430
    \u043E\u0434\u043D\u043E\u044E \u0442\u0430 \u0433\u0440\u0430\u044E\u0442\u044C\u0441\u044F.
    \u041A\u043E\u043B\u0438 \u0432\u043E\u043D\u0438 \u0441\u0430\u043C\u0456 \u043F\u043E\u0447\u0438\u043D\u0430\u044E\u0442\u044C
    \u0431\u0430\u0432\u0438\u0442\u0438\u0441\u044F \u0440\u0430\u0437\u043E\u043C,
    \u0431\u0443\u0434\u044C-\u0445\u0442\u043E \u043C\u043E\u0436\u0435 \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
    \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u043E. \u0412\u0442\u043E\u043C\u0438\u0432\u0448\u0438\u0441\u044C,
    \u043F'\u044E\u0442\u044C \u0432\u043E\u0434\u0443 \u0439 \u043B\u044F\u0433\u0430\u044E\u0442\u044C
    \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u0442\u0438. \u041C\u043E\u0436\u043D\u0430
    \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0442\u0438.\n\n\u0423
    \u043A\u043E\u0436\u043D\u043E\u0457 \u0441\u043E\u0431\u0430\u043A\u0438 \u0441\u0432\u0456\u0439
    \u043A\u043E\u043B\u0456\u0440 \u0456 \u0440\u043E\u0437\u043C\u0456\u0440 \u043C'\u044F\u0447\u0430.
    \u041A\u0438\u043D\u044C \u0457\u0457 \u043C'\u044F\u0447, \u0456 \u0432\u043E\u043D\u0430
    \u043F\u0440\u0438\u043D\u0435\u0441\u0435 \u0439\u043E\u0433\u043E \u043D\u0430\u0437\u0430\u0434.
    \u041D\u0430 \u041F\u041A \u0431\u0435\u0437 VR \u0437\u0430\u0442\u0438\u0441\u043D\u0438
    \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u0438\u0448\u0456, \u0449\u043E\u0431
    \u043D\u0430\u0431\u0440\u0430\u0442\u0438 \u0441\u0438\u043B\u0443 \u043A\u0438\u0434\u043A\u0430,
    \u0456 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438, \u0449\u043E\u0431 \u043A\u0438\u043D\u0443\u0442\u0438.
    \u0423 VR, \u044F\u043A\u0449\u043E \u0432\u0434\u0430\u0442\u0438 \u043A\u0438\u0434\u043E\u043A,
    \u043D\u0435 \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u044E\u0447\u0438 \u043C'\u044F\u0447\u0430
    \u0437 \u0440\u0443\u043A\u0438, \u0441\u043E\u0431\u0430\u043A\u0430 \u043C\u043E\u0436\u0435
    \u043F\u043E\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u043D\u0430 \u0442\u0435\u0431\u0435
    \u0430\u0431\u043E \u0433\u0430\u0432\u043A\u043D\u0443\u0442\u0438.\n\n\u042F\u043A\u0449\u043E
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0448 \u0437\u043D\u0430\u0439\u0442\u0438
    \u043C'\u044F\u0447, \u0432\u0456\u0434\u043A\u0440\u0438\u0439 \xAB\u0406\u0433\u0440\u0430\u0448\u043A\u0438\xBB
    \u0432 \u043C\u0435\u043D\u044E \u0439 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
    \xAB\u0414\u043E \u043C\u0435\u043D\u0435\xBB \u0434\u043B\u044F \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E\u0457
    \u0441\u043E\u0431\u0430\u043A\u0438. \u041F\u043E\u043A\u0438 \u0445\u0442\u043E\u0441\u044C
    \u0442\u0440\u0438\u043C\u0430\u0454 \u043C'\u044F\u0447 \u0430\u0431\u043E \u0441\u043E\u0431\u0430\u043A\u0430
    \u0433\u0440\u0430\u0454\u0442\u044C\u0441\u044F \u0441\u0430\u043C\u0435 \u0446\u0438\u043C
    \u043C'\u044F\u0447\u0435\u043C, \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
    \u0439\u043E\u0433\u043E \u043D\u0435 \u043C\u043E\u0436\u043D\u0430.\n\n\u041F\u0440\u043E
    \u0442\u0435, \u044F\u043A \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A\u0443 \u0441\u043F\u0430\u0442\u0438 \u043F\u043E\u0440\u0443\u0447,
    \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C \u0443 \xAB\u042F\u043A \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A\xBB.\n\n\u041D\u0430 \u0434\u043E\u0448\u0446\u0456
    \xAB\u0421\u043E\u0431\u0430\u043A\u0438 \u0432 \u0441\u0430\u0434\u0443\xBB
    \u043F\u043E\u0440\u0443\u0447 \u0437\u0456 \u043C\u043D\u043E\u044E \u043C\u043E\u0436\u043D\u0430
    \u0434\u0430\u0442\u0438 \u043A\u043E\u0436\u043D\u0456\u0439 \u0441\u043E\u0431\u0430\u0446\u0456
    \u0456\u043C'\u044F \u0442\u0430 \u043E\u0431\u0440\u0430\u0442\u0438 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u044E.
    \u041D\u0430\u0442\u0438\u0441\u043D\u0438 \xAB?\xBB \u043D\u0430 \u0434\u043E\u0448\u0446\u0456,
    \u0449\u043E\u0431 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0431\u0456\u043B\u044C\u0448\u0435."
  - "\u041F\u043E\u043A\u0438 \u0442\u0438 \u0433\u0440\u0430\u0454\u0448\u0441\u044F
    \u0456\u0437 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438, \u043F\u0430\u043C'\u044F\u0442\u043D\u0456
    \u043C\u0438\u0442\u0456 \u0441\u0442\u0430\u044E\u0442\u044C \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u044F\u043C\u0438
    \u043D\u0430 \u0444\u043E\u0442\u043E\u0434\u043E\u0448\u0446\u0456 \u0431\u0456\u043B\u044F
    \u0432\u0435\u0440\u0430\u043D\u0434\u0438. \u0423 \u0441\u043F\u0430\u043B\u044C\u043D\u0456
    \u0437'\u044F\u0432\u043B\u044F\u044E\u0442\u044C\u0441\u044F \u0444\u043E\u0442\u043E
    \u0441\u043D\u0443 \u043F\u043E\u0440\u0443\u0447 \u0456\u0437 \u0441\u043E\u0431\u0430\u043A\u043E\u044E.
    \u041A\u043E\u0436\u0435\u043D \u0432\u0438\u0434 \u0444\u043E\u0442\u043E \u043C\u0430\u0454
    \u0441\u0432\u043E\u0457 \u043C\u0456\u0441\u0446\u044F, \u0456 \u043A\u043E\u043B\u0438
    \u0432\u043E\u043D\u0438 \u0437\u0430\u043F\u043E\u0432\u043D\u044F\u0442\u044C\u0441\u044F,
    \u043D\u043E\u0432\u0456 \u0444\u043E\u0442\u043E \u0437\u0430\u043C\u0456\u043D\u044E\u0432\u0430\u0442\u0438\u043C\u0443\u0442\u044C
    \u043D\u0430\u0439\u0441\u0442\u0430\u0440\u0456\u0448\u0456.\n\n\u0426\u0456
    \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u0457 \u043B\u0438\u0448\u0435
    \u0442\u0432\u043E\u0457, \u0456\u043D\u0448\u0456 \u043B\u044E\u0434\u0438 \u0431\u0430\u0447\u0430\u0442\u044C
    \u0456\u043D\u0448\u0456 \u0437\u043D\u0456\u043C\u043A\u0438. \u041A\u043E\u043B\u0438
    \u0442\u0438 \u0432\u0438\u0439\u0434\u0435\u0448 \u0456\u0437 \u0446\u044C\u043E\u0433\u043E
    \u0441\u0432\u0456\u0442\u0443 VRChat, \u0444\u043E\u0442\u043E \u0437\u043D\u0438\u043A\u043D\u0443\u0442\u044C.
    \u042F\u043A\u0449\u043E \u044F\u043A\u0430\u0441\u044C \u0441\u0432\u0456\u0442\u043B\u0438\u043D\u0430
    \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u043B\u0430\u0441\u044F, \u043D\u0430
    \u041F\u041A \u0447\u0438 Quest \u043D\u0430\u0432\u0435\u0434\u0438 \u043D\u0430
    \u043D\u0435\u0457 \u043A\u0430\u043C\u0435\u0440\u0443 VRChat \u0456 \u0437\u043D\u0456\u043C\u0438,
    \u0449\u043E\u0431 \u0437\u0430\u0431\u0440\u0430\u0442\u0438 \u0456\u0437 \u0441\u043E\u0431\u043E\u044E.
    \u041D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
    \u043D\u0430 \u0444\u043E\u0442\u043E, \u0449\u043E\u0431 \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u0438
    \u0439\u043E\u0433\u043E, \u0430 \u0442\u043E\u0434\u0456 \u0437\u0440\u043E\u0431\u0438
    \u0437\u043D\u0456\u043C\u043E\u043A \u0435\u043A\u0440\u0430\u043D\u0430. \u0420\u0430\u043C\u043A\u0443
    \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u043E.\n\n\u041A\u0430\u043C\u0435\u0440\u0430
    \u043E\u0447\u0438\u043C\u0430 \u0441\u043E\u0431\u0430\u043A\u0438 \u0454 \u0491\u0430\u0434\u0436\u0435\u0442\u043E\u043C,
    \u044F\u043A\u0438\u0439 \u043A\u0443\u043F\u0443\u044E\u0442\u044C \u0437\u0430
    \u0431\u0430\u043B\u0438. \u041D\u0435\u044E \u043C\u043E\u0436\u043D\u0430 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
    \u0447\u0435\u0440\u0435\u0437 \u0432\u043A\u043B\u0430\u0434\u043A\u0443 \xAB\u0406\u0433\u0440\u0438\xBB,
    \u0456 \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F \u0431\u0430\u0447\u0438\u0448
    \u043B\u0438\u0448\u0435 \u0442\u0438. \u0412\u043E\u043D\u0430 \u043F\u0440\u0430\u0446\u044E\u0454
    \u043E\u043A\u0440\u0435\u043C\u043E \u0432\u0456\u0434 \u0446\u0438\u0445 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u0439.\n\n\u0414\u043E\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435
    \u043C\u043E\u0436\u043D\u0430 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F,
    \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0432\u0448\u0438 \xAB?\xBB \u043D\u0430
    \u0444\u043E\u0442\u043E\u0434\u043E\u0448\u0446\u0456. \u0429\u043E\u0431 \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u0438
    \u0437\u0439\u043E\u043C\u043A\u0443 \u0430\u0431\u043E \u0437\u043C\u0456\u043D\u0438\u0442\u0438
    \u044F\u043A\u0456\u0441\u0442\u044C \u0444\u043E\u0442\u043E, \u0432\u0456\u0434\u043A\u0440\u0438\u0439
    \xAB\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
    \u044F\u043A\u043E\u0441\u0442\u0456\xBB \u043F\u043E\u0440\u0443\u0447."
  - "\u041F\u0456\u0434 \u0447\u0430\u0441 \u043F\u0435\u0440\u0448\u043E\u0433\u043E
    \u0432\u0456\u0437\u0438\u0442\u0443 \u0442\u0438 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0448
    100pt. \u041A\u043E\u043B\u0438 \u0432\u043F\u0435\u0440\u0448\u0435 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0448
    \u0437\u0456 \u043C\u043D\u043E\u044E, \u044F \u0442\u0435\u0436 \u0434\u0430\u043C
    \u0442\u043E\u0431\u0456 100pt, \u043B\u0438\u0448\u0435 \u043E\u0434\u0438\u043D
    \u0440\u0430\u0437. \u0410 \u0434\u0430\u043B\u0456 \u0449\u043E\u0445\u0432\u0438\u043B\u0438\u043D\u0438
    \u0442\u0443\u0442 \u0434\u043E\u0434\u0430\u0454\u0442\u044C\u0441\u044F 1pt,
    \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043A\u0438 \u0442\u0438 \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u0432\u0430\u0454\u0448.
    \u0413\u043B\u0430\u0434\u0456\u043D\u043D\u044F \u0441\u043E\u0431\u0430\u043A
    \u0456 \u043A\u0438\u0434\u0430\u043D\u043D\u044F \u043C'\u044F\u0447\u0456\u0432
    \u043D\u0435 \u0434\u043E\u0434\u0430\u044E\u0442\u044C \u0431\u0430\u043B\u0456\u0432.
    \u0411\u0430\u043B\u0438 \u043C\u043E\u0436\u043D\u0430 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
    \u0439 \u0437\u0430 \u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043A\u043E\u0432\u0438\u043C\u0438
    \u043A\u043E\u0434\u0430\u043C\u0438. \u0421\u0432\u043E\u0457 \u0431\u0430\u043B\u0438
    \u0442\u0438 \u0431\u0430\u0447\u0438\u0448 \u043D\u0430 \u0446\u0456\u0439 \u0434\u043E\u0448\u0446\u0456
    \u0442\u0430 \u0443 \u0441\u0432\u043E\u0454\u043C\u0443 \u043C\u0435\u043D\u044E.
    \u0429\u043E\u0431 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438
    \u043A\u043E\u0434, \u043D\u0430\u0442\u0438\u0441\u043D\u0438 \xAB\u0411\u0430\u043B\u0438\xBB
    \u0443 \u0441\u0432\u043E\u0454\u043C\u0443 \u043C\u0435\u043D\u044E.\n\n\u0423\u0441\u0435
    \u0442\u0443\u0442 \u043F\u043E\u0434\u0456\u043B\u044F\u0454\u0442\u044C\u0441\u044F
    \u043D\u0430 4 \u0432\u0438\u0434\u0438.\n\n\u0422\u0435, \u0447\u0438\u043C
    \u043C\u043E\u0436\u043D\u0430 \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u0432\u0430\u0442\u0438\u0441\u044F
    \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u043E. \u0413\u043B\u0430\u0434\u0438\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A, \u043A\u0438\u0434\u0430\u0442\u0438 \u043C'\u044F\u0447\u0456,
    \u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u043A, \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
    \u0448\u043E\u0443 \u0439 \u0434\u043E\u043B\u0443\u0447\u0430\u0442\u0438\u0441\u044F
    \u0434\u043E \u0456\u0433\u043E\u0440, \u044F\u043A\u0456 \u0432\u043B\u0430\u0448\u0442\u043E\u0432\u0443\u044E\u0442\u044C
    \u0456\u043D\u0448\u0456.\n\n\u0422\u0435, \u0449\u043E \u043A\u0443\u043F\u0443\u044E\u0442\u044C
    \u0437\u0430 \u0431\u0430\u043B\u0438. \u0429\u043E\u0431 \u043A\u0443\u043F\u0438\u0442\u0438
    \u0456\u0433\u0440\u0430\u0448\u043A\u0438 \u0447\u0438 \u043B\u0430\u0441\u043E\u0449\u0456,
    \u043D\u0430\u0442\u0438\u0441\u043D\u0438 \u043D\u0430 \u0442\u043E\u0432\u0430\u0440
    \u043D\u0430 \u043F\u043E\u043B\u0438\u0446\u0456 \u0439 \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u044C
    \u043F\u043E\u043A\u0443\u043F\u043A\u0443 \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456,
    \u0449\u043E \u0432\u0456\u0434\u043A\u0440\u0438\u0454\u0442\u044C\u0441\u044F.
    \u0406\u043D\u0448\u0456 \u0442\u043E\u0432\u0430\u0440\u0438 \u0437\u0430 \u0431\u0430\u043B\u0438
    \u043C\u043E\u0436\u043D\u0430 \u043A\u0443\u043F\u0438\u0442\u0438 \u0443 \u0441\u0432\u043E\u0454\u043C\u0443
    \u043C\u0435\u043D\u044E. \u041B\u0430\u0441\u043E\u0449\u0456 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u044E\u0442\u044C\u0441\u044F
    \u0449\u043E\u0440\u0430\u0437\u0443, \u043A\u043E\u043B\u0438 \u0457\u0445 \u0434\u0430\u0454\u0448,
    \u0430 \u0440\u0435\u0448\u0442\u0443 \u0434\u043E\u0441\u0438\u0442\u044C \u043A\u0443\u043F\u0438\u0442\u0438
    \u043E\u0434\u0438\u043D \u0440\u0430\u0437.\n\n\u0422\u0435, \u0449\u043E \u043A\u0443\u043F\u0443\u044E\u0442\u044C
    \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0443 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456
    VRChat. \u0426\u0435 \u043D\u0430\u0431\u043E\u0440\u0438 \u0456\u0433\u0440\u0430\u0448\u043E\u043A
    \u0456 \u043F\u0440\u0438\u043A\u0440\u0430\u0441, \u0430 \u0442\u0430\u043A\u043E\u0436
    \u0448\u043E\u0443. \u0414\u0435\u044F\u043A\u0456 \u0442\u043E\u0432\u0430\u0440\u0438
    \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u044C\u0441\u044F \u043B\u0438\u0448\u0435
    \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u043E\u0433\u043E
    \u0447\u0430\u0441\u0443.\n\n\u041C\u0456\u0441\u044F\u0447\u043D\u0435 \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u043E
    \u043D\u0430\u0437\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F VAnimal Trainer.
    \u0422\u0438 \u043A\u0443\u043F\u0443\u0454\u0448 \u043F\u0435\u0440\u0456\u043E\u0434
    \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u0430, \u0456 \u0432\u043E\u043D\u043E
    \u043D\u0435 \u043F\u043E\u043D\u043E\u0432\u043B\u044E\u0454\u0442\u044C\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E. \u0427\u0435\u0440\u0435\u0437
    \xAB\u0406\u0433\u0440\u0438\xBB \u043C\u043E\u0436\u043D\u0430 \u0432\u043B\u0430\u0448\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
    \u0437\u0431\u0456\u0440 \u0441\u043E\u0431\u0430\u043A \u0456 \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0438
    \u0430\u0431\u043E \u0432\u0438\u0431\u0440\u0430\u0442\u0438 2 \u0432\u0456\u043B\u044C\u043D\u0438\u0445
    \u0441\u043E\u0431\u0430\u043A, \u0449\u043E\u0431 \u0432\u043E\u043D\u0438 \u043F\u043E\u0431\u0430\u0432\u0438\u043B\u0438\u0441\u044F
    \u0440\u0430\u0437\u043E\u043C. \u0406\u043D\u0448\u0456 \u043C\u043E\u0436\u0443\u0442\u044C
    \u0434\u043E\u043B\u0443\u0447\u0430\u0442\u0438\u0441\u044F \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u043E,
    \u043D\u0430\u0432\u0456\u0442\u044C \u0431\u0435\u0437 \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u0430.
    \u0414\u043E\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435 \u0434\u0438\u0432\u0438\u0441\u044C
    \u0443 \u0440\u043E\u0437\u0434\u0456\u043B\u0456 \xAB\u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F\xBB
    \u0432 \u043C\u0435\u043D\u044E \xAB\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438\xBB.\n\n\u041F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438
    \u0448\u043E\u0443 \u043C\u043E\u0436\u0435 \u0430\u0434\u043C\u0456\u043D\u0456\u0441\u0442\u0440\u0430\u0442\u043E\u0440,
    \u044F\u043A\u0438\u0439 \u043F\u0440\u0438\u0434\u0431\u0430\u0432 \u0441\u0430\u043C\u0435
    \u0446\u0435 \u0448\u043E\u0443. \u0410\u0434\u043C\u0456\u043D\u0456\u0441\u0442\u0440\u0430\u0442\u043E\u0440
    \u0454 \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u043E\u043C \u043A\u0456\u043C\u043D\u0430\u0442\u0438,
    \u0430 \u043A\u043E\u043B\u0438 \u0439\u043E\u0433\u043E \u043D\u0435\u043C\u0430\u0454,
    \u0446\u044E \u0440\u043E\u043B\u044C \u0432\u0438\u043A\u043E\u043D\u0443\u0454
    Master. \u042F\u043A\u0449\u043E \u0432\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u043E
    \xAB\u0428\u043E\u0443 \u043C\u043E\u0436\u0443\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438
    \u0432\u0441\u0456: \u0423\u0412\u0406\u041C\u041A\xBB, \u0456\u043D\u0448\u0456
    \u0442\u0435\u0436 \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0442\u0438
    \u043F\u0440\u0438\u0434\u0431\u0430\u043D\u0456 \u043D\u0438\u043C\u0438 \u0448\u043E\u0443.
    \u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0446\u0435\u0439 \u0434\u043E\u0437\u0432\u0456\u043B
    \u0443\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u0438\u0439. \u041E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E
    \u043C\u043E\u0436\u0435 \u0439\u0442\u0438 \u043B\u0438\u0448\u0435 \u043E\u0434\u043D\u0435
    \u0448\u043E\u0443, \u0430 \u043F\u0456\u0441\u043B\u044F \u0439\u043E\u0433\u043E
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044F \u0442\u0440\u0435\u0431\u0430
    \u0442\u0440\u043E\u0445\u0438 \u0437\u0430\u0447\u0435\u043A\u0430\u0442\u0438,
    \u043F\u0435\u0440\u0448 \u043D\u0456\u0436 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0442\u0438
    \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0435. \u0427\u0430\u0441 \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F
    \u0434\u0438\u0432\u0438\u0441\u044C \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456.
    \u0414\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u0431\u0443\u0434\u044C-\u0445\u0442\u043E
    \u043C\u043E\u0436\u0435 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u043E.
    \u0404 \u0439 \u0448\u043E\u0443 \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u044E
    \u0441\u043E\u0431\u0430\u043A."
  - "\u0412\u0438\u0431\u0435\u0440\u0438 \xAB\u041B\u0430\u0441\u043E\u0449\u0456\xBB
    \u0443 \u0441\u0432\u043E\u0454\u043C\u0443 \u043C\u0435\u043D\u044E \u0439 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
    \xAB\u0414\u0430\u0442\u0438\xBB. \u041A\u043E\u043B\u0438 \u043B\u0430\u0441\u043E\u0449\u0456
    \u0437'\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F, \u043C\u0435\u043D\u044E
    \u0437\u0430\u043A\u0440\u0438\u0454\u0442\u044C\u0441\u044F, \u0442\u043E\u0436
    \u043F\u0440\u0438\u0433\u043E\u0441\u0442\u0438 \u0441\u043E\u0431\u0430\u043A\u0443.\n\n\u0422\u0440\u0438\u043C\u0430\u0439
    \u043B\u0430\u0441\u043E\u0449\u0456 \u0432 \u0440\u0443\u0446\u0456, \u0456
    \u0441\u043E\u0431\u0430\u043A\u0438 \u043F\u0456\u0434\u0456\u0439\u0434\u0443\u0442\u044C.
    \u0412\u0456\u0434\u043F\u0443\u0441\u0442\u0438, \u0456 \u0457\u0445 \u0437'\u0457\u0441\u0442\u044C
    \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0430 \u0441\u043E\u0431\u0430\u043A\u0430.
    \u0417\u0430 \u0440\u0430\u0437 \u043C\u043E\u0436\u043D\u0430 \u0434\u0456\u0441\u0442\u0430\u0442\u0438
    \u043B\u0438\u0448\u0435 \u043E\u0434\u043D\u0456 \u043B\u0430\u0441\u043E\u0449\u0456.
    \u0414\u043B\u044F \u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u044F \u0434\u0430\u0432
    \u0442\u043E\u0431\u0456 5 \u0448\u0442\u0443\u043A. \u041A\u043E\u043B\u0438
    \u0437\u0430\u043A\u0456\u043D\u0447\u0430\u0442\u044C\u0441\u044F, \u043E\u0431\u043C\u0456\u043D\u044F\u0439
    \u0431\u0430\u043B\u0438 \u043D\u0430 \u043D\u043E\u0432\u0456 \u043D\u0430 \u043F\u043E\u043B\u0438\u0446\u0456."
  - "[\u042F\u043A \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438]\n\u0412\u0456\u0434\u043A\u0440\u0438\u0439
    \xAB\u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438\xBB \u0443 \u0441\u0432\u043E\u0454\u043C\u0443
    \u043C\u0435\u043D\u044E, \u0432\u0438\u0431\u0435\u0440\u0438 \u0441\u043E\u0431\u0430\u043A\u0443
    \u0439 \u043F\u043E\u0437\u0443, \u0430 \u0442\u043E\u0434\u0456 \u0432\u0438\u0437\u043D\u0430\u0447
    \u043C\u0456\u0441\u0446\u0435 \u0442\u0430 \u043D\u0430\u043F\u0440\u044F\u043C\u043E\u043A,
    \u043A\u0443\u0434\u0438 \u0432\u043E\u043D\u0430 \u0434\u0438\u0432\u0438\u0442\u0438\u043C\u0435\u0442\u044C\u0441\u044F.
    \u041D\u0430 \u0447\u0430\u0441 \u0432\u0438\u0431\u043E\u0440\u0443 \u043C\u0456\u0441\u0446\u044F
    \u043C\u0435\u043D\u044E \u0437\u0430\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F.
    \u041F\u0456\u0441\u043B\u044F \u0432\u0438\u0431\u043E\u0440\u0443 \u0432\u043E\u043D\u043E
    \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F \u0437\u0430\u043A\u0440\u0438\u0442\u0438\u043C,
    \u0430 \u0441\u043E\u0431\u0430\u043A\u0430 \u043F\u0456\u0434\u0456\u0439\u0434\u0435.
    \u0429\u043E\u0431 \u0437\u043D\u043E\u0432\u0443 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u0442\u0438
    \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u043D\u0443 \u0442\u043E\u0431\u043E\u044E
    \u0441\u043E\u0431\u0430\u043A\u0443 \u0433\u0443\u043B\u044F\u0442\u0438 \u0432\u0456\u043B\u044C\u043D\u043E,
    \u0432\u0438\u0431\u0435\u0440\u0438 \u0457\u0457 \u0443 \u0432\u043A\u043B\u0430\u0434\u0446\u0456
    \xAB\u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438\xBB \u0439 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
    \xAB\u0412\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u0442\u0438\xBB.\n\n[\u041F\u043E\u0437\u0438
    \u0442\u0430 \u0434\u0456\u0457]\n4 \u043F\u043E\u0437\u0438 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0456:
    \xAB\u041D\u0430 \u0431\u043E\u0446\u0456\xBB, \xAB\u041B\u0435\u0436\u0430\u0442\u0438\xBB,
    \xAB\u0421\u0438\u0434\u0456\u0442\u0438\xBB \u0442\u0430 \xAB\u041A\u043B\u0443\u0431\u043E\u0447\u043A\u043E\u043C\xBB.
    \u041F\u043E\u0437\u0443 \xAB\u041D\u0430 \u0441\u043F\u0438\u043D\u0456\xBB
    \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u043F\u0456\u0441\u043B\u044F
    \u043F\u0440\u0438\u0434\u0431\u0430\u043D\u043D\u044F \u0437\u0430 \u0431\u0430\u043B\u0438.
    \xAB\u0414\u0430\u0439 \u043B\u0430\u043F\u0443\xBB \u0442\u0430 \xAB\u0413\u043E\u043B\u043E\u0432\u0443
    \u043D\u0430 \u0440\u0443\u043A\u0443\xBB \u0442\u0435\u0436 \u043A\u0443\u043F\u0443\u044E\u0442\u044C\u0441\u044F
    \u0437\u0430 \u0431\u0430\u043B\u0438. \u0414\u043B\u044F \xAB\u0414\u0430\u0439
    \u043B\u0430\u043F\u0443\xBB \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430
    \u043F\u043E\u0437\u0430 \xAB\u0421\u0438\u0434\u0456\u0442\u0438\xBB, \u0430
    \u0434\u043B\u044F \xAB\u0413\u043E\u043B\u043E\u0432\u0443 \u043D\u0430 \u0440\u0443\u043A\u0443\xBB
    \u043F\u043E\u0437\u0430 \xAB\u041B\u0435\u0436\u0430\u0442\u0438\xBB. \u0423
    VR \u0442\u043E\u0439, \u0445\u0442\u043E \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0432
    \u0441\u043E\u0431\u0430\u043A\u0443, \u043C\u0430\u0454 \u043F\u0440\u043E\u0441\u0442\u044F\u0433\u043D\u0443\u0442\u0438
    \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u044E \u0440\u0443\u043A\u0443 \u0439
    \u0442\u0440\u043E\u0445\u0438 \u0437\u0430\u0447\u0435\u043A\u0430\u0442\u0438.
    \u0412\u0456\u0434\u0432\u0435\u0434\u0438 \u0440\u0443\u043A\u0443 \u0432\u0456\u0434
    \u0441\u043E\u0431\u0430\u043A\u0438, \u0449\u043E\u0431 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438
    \u0434\u0456\u044E. \u041D\u0430 \u041F\u041A \u0431\u0435\u0437 VR \u0442\u0430
    \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0456 \u0432\u0456\u0434\u043A\u0440\u0438\u0439
    \u043C\u0435\u043D\u044E \u0431\u0456\u043B\u044F \u0441\u043E\u0431\u0430\u043A\u0438
    \u0439 \u043D\u0430\u0442\u0438\u0441\u043D\u0438 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0434\u0456\u0457 \u0443 \u0432\u043A\u043B\u0430\u0434\u0446\u0456 \xAB\u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438\xBB.
    \u0421\u043E\u0431\u0430\u043A\u0430 \u043D\u0435\u043D\u0430\u0434\u043E\u0432\u0433\u043E
    \u043F\u0440\u0438\u0439\u043C\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0443
    \u043F\u043E\u0437\u0443. \xAB\u041F\u043E\u0442\u044F\u0433\u0443\u0432\u0430\u043D\u043D\u044F
    \u0439 \u043F\u043E\u0437\u0456\u0445\u0430\u043D\u043D\u044F\xBB \u043A\u0443\u043F\u0443\u044E\u0442\u044C\u0441\u044F
    \u0440\u0430\u0437\u043E\u043C, \u0442\u0435\u0436 \u0437\u0430 \u0431\u0430\u043B\u0438.
    \u041A\u043E\u043B\u0438 \u0441\u043E\u0431\u0430\u043A\u0430 \u043F\u0440\u0438\u0439\u0434\u0435,
    \u043D\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0457
    \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0438
    \u0457\u0457 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438 \u043A\u043E\u0436\u043D\u0443
    \u0437 \u0446\u0438\u0445 \u0434\u0456\u0439 \u043E\u043A\u0440\u0435\u043C\u043E
    \u043A\u043D\u043E\u043F\u043A\u0430\u043C\u0438 \u0443 \u0432\u043A\u043B\u0430\u0434\u0446\u0456
    \xAB\u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438\xBB. \u0414\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0443
    \u043F\u043E\u0437\u0443 \u0447\u0438 \u0434\u0456\u044E \u0434\u043E\u0441\u0438\u0442\u044C
    \u043A\u0443\u043F\u0438\u0442\u0438 \u043E\u0434\u0438\u043D \u0440\u0430\u0437,
    \u0449\u043E\u0431 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
    \u043D\u0435\u044E \u0437 \u0443\u0441\u0456\u043C\u0430 6 \u043F\u043E\u0440\u043E\u0434\u0430\u043C\u0438
    \u0441\u043E\u0431\u0430\u043A. \u0414\u043E \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u0430
