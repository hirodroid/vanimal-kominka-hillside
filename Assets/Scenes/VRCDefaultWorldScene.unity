  - "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043B\u0438\u0447\u043D\u043E\u0435
    \u043C\u0435\u043D\u044E. \u0412 VR \u043D\u0430\u043A\u043B\u043E\u043D\u0438\u0442\u0435
    \u043F\u0440\u0430\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0432\u043D\u0438\u0437
    \u0438 \u043F\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0435. \u0412 \u0440\u0435\u0436\u0438\u043C\u0435
    Desktop \u043D\u0430\u0436\u043C\u0438\u0442\u0435 T. \u041D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435
    \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u043A\u043D\u043E\u043F\u043A\u0438
    \xAB\u041C\u0435\u043D\u044E\xBB \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435.\n\n\u041D\u0430\u0432\u0435\u0440\u0445\u0443
    7 \u0432\u043A\u043B\u0430\u0434\u043E\u043A. \u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435
    \xAB\u041D\u0430\u0440\u044F\u0434\u044B\xBB \u043C\u043E\u0436\u043D\u043E \u0443\u043A\u0440\u0430\u0441\u0438\u0442\u044C
    \u0441\u043E\u0431\u0430\u043A\u0443. \u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435
    \xAB\u041B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430\xBB \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
    \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E \u0432 \u0440\u0443\u043A\u0438.
    \u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u041F\u043E\u0437\u0432\u0430\u0442\u044C\xBB
    \u043F\u043E\u0434\u0437\u044B\u0432\u0430\u0435\u0442\u0435 \u0441\u043E\u0431\u0430\u043A\u0443
    \u0438 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043F\u043E\u0437\u0443.
    \u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u0418\u0433\u0440\u0443\u0448\u043A\u0438\xBB
    \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0435 \u0441\u0435\u0431\u0435
    \u0441\u043E\u0431\u0430\u0447\u0438\u0439 \u043C\u044F\u0447. \u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435
    \xAB\u0428\u043E\u0443\xBB \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0435
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0432 \u0441\u0430\u0434\u0443. \u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435
    \xAB\u042D\u0444\u0444\u0435\u043A\u0442\u044B\xBB \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435
    \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0438 \u043F\u043E\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u0438.
    \u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u0418\u0433\u0440\u044B\xBB
    \u0435\u0441\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0430 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
    \u0441\u043E\u0431\u0430\u043A\u0438 \u0438 \u0438\u0433\u0440\u044B \u0422\u0440\u0435\u043D\u0435\u0440\u0430.\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u041E\u0447\u043A\u0438\xBB \u043D\u0430\u0432\u0435\u0440\u0445\u0443,
    \u0447\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C, \u043A\u0430\u043A
    \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u043E\u0447\u043A\u0438, \u0438\u043B\u0438
    \u0432\u0432\u0435\u0441\u0442\u0438 \u043F\u043E\u0434\u0430\u0440\u043E\u0447\u043D\u044B\u0439
    \u043A\u043E\u0434. \u0412 \u0440\u0430\u0437\u0434\u0435\u043B\u0435 \xAB\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438\xBB
    \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C, \u043D\u043E\u0447\u043D\u043E\u0439
    \u0440\u0435\u0436\u0438\u043C, \u044F\u0437\u044B\u043A \u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0439. \u0422\u0430\u043C
    \u0435\u0441\u0442\u044C \u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u0440\u0430\u0434\u0438\u043E \u0438 \u0434\u044B\u043C\u043A\u0438, \u043D\u043E
    \u043E\u0431\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0442\u043E\u043B\u044C\u043A\u043E
    \u043D\u0430 \u041F\u041A. \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0443
    \u0442\u0430\u043A\u0436\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B
    \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0435
    \u0432\u0441\u0435\u043C \u0437\u0432\u0430\u0442\u044C \u0441\u043E\u0431\u0430\u043A
    \u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0448\u043E\u0443.
    \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u043E\u043C
    \u0437\u0434\u0435\u0441\u044C \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u043A\u043E\u043C\u043D\u0430\u0442\u044B.
    \u0415\u0441\u043B\u0438 \u0435\u0433\u043E \u043D\u0435\u0442, \u044D\u0442\u0443
    \u0440\u043E\u043B\u044C \u0431\u0435\u0440\u0451\u0442 \u043D\u0430 \u0441\u0435\u0431\u044F
    Master. \u0415\u0449\u0451 \u0432 \u0440\u0430\u0437\u0434\u0435\u043B\u0435
    \xAB\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\xBB \u0432 \u043C\u0435\u043D\u044E
    \xAB\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438\xBB \u043C\u043E\u0436\u043D\u043E
    \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u0442\u044C \xAB\u0421 \u0447\u0435\u0433\u043E
    \u043D\u0430\u0447\u0430\u0442\u044C\xBB.\n\n\u041A\u043E\u0433\u0434\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435,
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0417\u0430\u043A\u0440\u044B\u0442\u044C\xBB.
    \u0412 VR \u0438 \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435
    \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435,
    \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0438
    \u043C\u0435\u043D\u044E, \u0438 \u043E\u043D\u043E \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F
    \u043A \u0432\u0430\u043C, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
    \u0432\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0435\u0433\u043E
    \u0434\u0430\u043B\u0435\u043A\u043E. \u0412 \u0440\u0435\u0436\u0438\u043C\u0435
    Desktop \u043A\u043B\u0430\u0432\u0438\u0448\u0430 T \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043C\u0435\u043D\u044E."
  - "\u0421\u043E\u0431\u0430\u043A\u0443 \u043C\u043E\u0436\u043D\u043E \u0433\u043B\u0430\u0434\u0438\u0442\u044C
    \u043F\u043E \u043C\u0430\u043A\u0443\u0448\u043A\u0435, \u043F\u043E \u0449\u0435\u043A\u0430\u043C
    \u0438\u043B\u0438 \u043F\u043E\u0434 \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u043E\u043C.
    \u041E\u0434\u043D\u043E\u0439 \u0440\u0443\u043A\u0435 \u043E\u043D\u0430 \u0442\u043E\u0436\u0435
    \u0440\u0430\u0434\u0430, \u0430 \u043E\u0442 \u0434\u0432\u0443\u0445 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
    \u0432 \u0432\u043E\u0441\u0442\u043E\u0440\u0433, \u0434\u0430 \u0438 \u0441\u0432\u0435\u0442\u043E\u0432\u044B\u0435
    \u044D\u0444\u0444\u0435\u043A\u0442\u044B \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F.\n\n\u042D\u0444\u0444\u0435\u043A\u0442\u044B
    \u043F\u043E\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0432\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435
    \xAB\u042D\u0444\u0444\u0435\u043A\u0442\u044B\xBB \u0432 \u043B\u0438\u0447\u043D\u043E\u043C
    \u043C\u0435\u043D\u044E. \u0415\u0441\u0442\u044C \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435,
    \u0435\u0441\u0442\u044C \u0437\u0430 \u043E\u0447\u043A\u0438, \u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0438\u0434\u0443\u0442 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435
    \u0441 \u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439 \u0448\u043E\u0443."
  - "\u0421\u043E\u0431\u0430\u043A\u0438 \u0438 \u0441\u0430\u043C\u0438 \u0431\u0435\u0433\u0430\u044E\u0442
    \u0434\u0440\u0443\u0433 \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u043C \u0438
    \u0438\u0433\u0440\u0430\u044E\u0442. \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0438
    \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0432\u043E\u0437\u0438\u0442\u044C\u0441\u044F
    \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C \u0441\u0430\u043C\u0438,
    \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043C\u043E\u0436\u043D\u043E
    \u0432\u0441\u0435\u043C \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E.
    \u0423\u0441\u0442\u0430\u0432, \u043E\u043D\u0438 \u043F\u044C\u044E\u0442 \u0432\u043E\u0434\u0443
    \u0438 \u043B\u043E\u0436\u0430\u0442\u0441\u044F \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C.
    \u041F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C
    \u0442\u043E\u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u043E.\n\n\u0423 \u043A\u0430\u0436\u0434\u043E\u0439
    \u0441\u043E\u0431\u0430\u043A\u0438 \u0441\u0432\u043E\u0439 \u043C\u044F\u0447
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430 \u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u0430.
    \u0411\u0440\u043E\u0441\u044C\u0442\u0435 \u0435\u0433\u043E, \u0438 \u043E\u043D\u0430
    \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E.
    \u0412 \u0440\u0435\u0436\u0438\u043C\u0435 Desktop \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u0441\u0438\u043B\u0443 \u0431\u0440\u043E\u0441\u043A\u0430,
    \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
    \u0431\u0440\u043E\u0441\u0438\u0442\u044C. \u0412 VR, \u0435\u0441\u043B\u0438
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0438\u0434, \u0447\u0442\u043E
    \u0431\u0440\u043E\u0441\u0430\u0435\u0442\u0435 \u043C\u044F\u0447, \u043D\u0435
    \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044F \u0435\u0433\u043E \u0438\u0437
    \u0440\u0443\u043A\u0438, \u0441\u043E\u0431\u0430\u043A\u0430 \u043C\u043E\u0436\u0435\u0442
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0432\u0430\u0441
    \u0438\u043B\u0438 \u0433\u0430\u0432\u043A\u043D\u0443\u0442\u044C.\n\n\u0415\u0441\u043B\u0438
    \u043C\u044F\u0447 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0441\u044F, \u043E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
    \u0432\u043A\u043B\u0430\u0434\u043A\u0443 \xAB\u0418\u0433\u0440\u0443\u0448\u043A\u0438\xBB
    \u0432 \u043C\u0435\u043D\u044E \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u041A\u043E \u043C\u043D\u0435\xBB \u0443 \u043D\u0443\u0436\u043D\u043E\u0439
    \u0441\u043E\u0431\u0430\u043A\u0438. \u041F\u043E\u043A\u0430 \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0434\u0435\u0440\u0436\u0438\u0442 \u044D\u0442\u043E\u0442 \u043C\u044F\u0447
    \u0438\u043B\u0438 \u0441\u043E\u0431\u0430\u043A\u0430 \u0441 \u043D\u0438\u043C
    \u0438\u0433\u0440\u0430\u0435\u0442, \u0432\u0435\u0440\u043D\u0443\u0442\u044C
    \u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F.\n\n\u041E \u0442\u043E\u043C,
    \u043A\u0430\u043A \u043F\u043E\u0437\u0432\u0430\u0442\u044C \u0441\u043E\u0431\u0430\u043A\u0443
    \u043F\u043E\u0441\u043F\u0430\u0442\u044C \u0440\u044F\u0434\u043E\u043C \u0441
    \u0432\u0430\u043C\u0438, \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0432
    \u0440\u0430\u0437\u0434\u0435\u043B\u0435 \xAB\u041A\u0430\u043A \u043F\u043E\u0437\u0432\u0430\u0442\u044C\xBB.\n\n\u041D\u0430
    \u0434\u043E\u0441\u043A\u0435 \xAB\u0421\u043E\u0431\u0430\u043A\u0438 \u0432
    \u0441\u0430\u0434\u0443\xBB \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u043C\u043D\u043E\u0439
    \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u0442\u044C \u043A\u0430\u0436\u0434\u043E\u0439
    \u0441\u043E\u0431\u0430\u043A\u0435 \u0438\u043C\u044F \u0438 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u043B\u044E\u0431\u0438\u043C\u0438\u0446\u0443. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB?\xBB \u043D\u0430 \u0434\u043E\u0441\u043A\u0435, \u0447\u0442\u043E\u0431\u044B
    \u0443\u0437\u043D\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435."
  - "\u041F\u043E\u043A\u0430 \u0432\u044B \u0438\u0433\u0440\u0430\u0435\u0442\u0435
    \u0441 \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438, \u043F\u0430\u043C\u044F\u0442\u043D\u044B\u0435
    \u043C\u043E\u043C\u0435\u043D\u0442\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
    \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u043C\u0438 \u043D\u0430
    \u0444\u043E\u0442\u043E\u0434\u043E\u0441\u043A\u0435 \u0443 \u0432\u0435\u0440\u0430\u043D\u0434\u044B.
    \u0410 \u0432 \u0441\u043F\u0430\u043B\u044C\u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0442\u043E\u0433\u043E,
    \u043A\u0430\u043A \u0432\u044B \u0441\u043F\u0438\u0442\u0435 \u0440\u044F\u0434\u043E\u043C
    \u0441 \u0441\u043E\u0431\u0430\u043A\u043E\u0439. \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0432\u0438\u0434\u0430 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0439
    \u0441\u0432\u043E\u0438 \u043C\u0435\u0441\u0442\u0430 \u043D\u0430 \u0434\u043E\u0441\u043A\u0435.
    \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F,
    \u043D\u043E\u0432\u044B\u0435 \u0441\u043D\u0438\u043C\u043A\u0438 \u0437\u0430\u043C\u0435\u043D\u044F\u044E\u0442
    \u0441\u0430\u043C\u044B\u0435 \u0441\u0442\u0430\u0440\u044B\u0435.\n\n\u042D\u0442\u0438
    \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432\u0430\u0448\u0438. \u0414\u0440\u0443\u0433\u0438\u0435 \u043B\u044E\u0434\u0438
    \u0432\u0438\u0434\u044F\u0442 \u0441\u0432\u043E\u0438 \u0441\u043D\u0438\u043C\u043A\u0438.
    \u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u0432\u044B\u0439\u0434\u0435\u0442\u0435
    \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u043C\u0438\u0440\u0430 VRChat,
    \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0438\u0441\u0447\u0435\u0437\u043D\u0443\u0442.
    \u0415\u0441\u043B\u0438 \u043A\u0430\u043A\u043E\u0439-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0441\u043D\u0438\u043C\u043E\u043A \u0432\u0430\u043C \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F,
    \u043D\u0430 \u041F\u041A \u0438\u043B\u0438 Quest \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
    \u043D\u0430 \u043D\u0435\u0433\u043E \u043A\u0430\u043C\u0435\u0440\u0443 VRChat
    \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435.
    \u041D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043D\u0430 \u0444\u043E\u0442\u043E, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
    \u0435\u0433\u043E, \u0430 \u0437\u0430\u0442\u0435\u043C \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435
    \u0441\u043D\u0438\u043C\u043E\u043A \u044D\u043A\u0440\u0430\u043D\u0430. \u0420\u0430\u043C\u043A\u0443
    \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E.\n\n\u041A\u0430\u043C\u0435\u0440\u0430
    \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u0441\u043E\u0431\u0430\u043A\u0438
    \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0441\u044F \u0437\u0430 \u043E\u0447\u043A\u0438.
    \u0415\u044E \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0432\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u0418\u0433\u0440\u044B\xBB,
    \u0438 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0432\u0438\u0434\u043D\u043E
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0430\u043C. \u041A \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u043C
    \u043D\u0430 \u0434\u043E\u0441\u043A\u0435 \u043E\u043D\u0430 \u043D\u0435 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F.\n\n\u041F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
    \u043C\u043E\u0436\u043D\u043E \u0443\u0437\u043D\u0430\u0442\u044C, \u043D\u0430\u0436\u0430\u0432
    \xAB?\xBB \u043D\u0430 \u0444\u043E\u0442\u043E\u0434\u043E\u0441\u043A\u0435.
    \u0410 \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0441\u044A\u0451\u043C\u043A\u0443 \u0438\u043B\u0438 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E, \u043E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
    \xAB\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430\xBB
    \u0440\u044F\u0434\u043E\u043C."
  - "\u041F\u0440\u0438 \u043F\u0435\u0440\u0432\u043E\u043C \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u0438
    \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 100 pt. \u0417\u0430
    \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
    \u0441\u043E \u043C\u043D\u043E\u0439 \u044F \u0442\u043E\u0436\u0435 \u0434\u0430\u043C
    \u0432\u0430\u043C 100 pt, \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D
    \u0440\u0430\u0437. \u0410 \u0434\u0430\u043B\u044C\u0448\u0435, \u043F\u043E\u043A\u0430
    \u0432\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
    \u043E\u0442\u0434\u044B\u0445\u0430\u0435\u0442\u0435 \u0437\u0434\u0435\u0441\u044C,
    \u043A\u0430\u0436\u0434\u0443\u044E \u043C\u0438\u043D\u0443\u0442\u0443 \u043F\u0440\u0438\u0431\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    1 pt. \u041F\u043E\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0431\u0440\u043E\u0441\u043A\u0438 \u043C\u044F\u0447\u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043E\u0447\u043A\u043E\u0432 \u043D\u0435 \u0434\u0430\u044E\u0442. \u041E\u0447\u043A\u0438
    \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0438 \u043F\u043E \u043F\u043E\u0434\u0430\u0440\u043E\u0447\u043D\u043E\u043C\u0443
    \u043A\u043E\u0434\u0443. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C,
    \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443 \u0432\u0430\u0441 \u043E\u0447\u043A\u043E\u0432,
    \u043C\u043E\u0436\u043D\u043E \u043D\u0430 \u044D\u0442\u043E\u0439 \u0434\u043E\u0441\u043A\u0435
    \u0438 \u0432 \u043B\u0438\u0447\u043D\u043E\u043C \u043C\u0435\u043D\u044E.
    \u0427\u0442\u043E\u0431\u044B \u0432\u0432\u0435\u0441\u0442\u0438 \u043A\u043E\u0434,
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041E\u0447\u043A\u0438\xBB \u0432
    \u043B\u0438\u0447\u043D\u043E\u043C \u043C\u0435\u043D\u044E.\n\n\u0412\u0441\u0451,
    \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C, \u0434\u0435\u043B\u0438\u0442\u0441\u044F
    \u043D\u0430 4 \u0432\u0438\u0434\u0430.\n\n\u0422\u043E, \u0447\u0435\u043C
    \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F
    \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E. \u0413\u043B\u0430\u0434\u0438\u0442\u044C
    \u0441\u043E\u0431\u0430\u043A, \u0431\u0440\u043E\u0441\u0430\u0442\u044C \u043C\u044F\u0447,
    \u0437\u0432\u0430\u0442\u044C \u0441\u043E\u0431\u0430\u043A, \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u0448\u043E\u0443 \u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0432 \u0438\u0433\u0440\u0430\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442 \u0434\u0440\u0443\u0433\u0438\u0435.\n\n\u0422\u043E,
    \u0447\u0442\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0441\u044F
    \u0437\u0430 \u043E\u0447\u043A\u0438. \u0427\u0442\u043E\u0431\u044B \u043A\u0443\u043F\u0438\u0442\u044C
    \u0438\u0433\u0440\u0443\u0448\u043A\u0443 \u0438\u043B\u0438 \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E,
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0442\u043E\u0432\u0430\u0440
    \u043D\u0430 \u043F\u043E\u043B\u043A\u0435 \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435
    \u043F\u043E\u043A\u0443\u043F\u043A\u0443 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0448\u0435\u043C\u0441\u044F
    \u044D\u043A\u0440\u0430\u043D\u0435. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0442\u043E\u0432\u0430\u0440\u044B \u0437\u0430 \u043E\u0447\u043A\u0438 \u043C\u043E\u0436\u043D\u043E
    \u043A\u0443\u043F\u0438\u0442\u044C \u0432 \u043B\u0438\u0447\u043D\u043E\u043C
    \u043C\u0435\u043D\u044E. \u041B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430
    \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u044E\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
    \u0432\u044B \u0438\u0445 \u0434\u0430\u0451\u0442\u0435, \u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043A\u0443\u043F\u0438\u0442\u044C
    \u043E\u0434\u0438\u043D \u0440\u0430\u0437.\n\n\u0422\u043E\u0432\u0430\u0440\u044B
    \u0438\u0437 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 VRChat, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u043E\u043A\u0443\u043F\u0430\u044E\u0442\u0441\u044F \u043E\u0434\u0438\u043D
    \u0440\u0430\u0437. \u042D\u0442\u043E \u043D\u0430\u0431\u043E\u0440\u044B \u0438\u0433\u0440\u0443\u0448\u0435\u043A
    \u0438 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0439, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u0448\u043E\u0443. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u043E\u0432\u0430\u0440\u044B
    \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0433\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438.\n\n\u041C\u0435\u0441\u044F\u0447\u043D\u043E\u0435
    \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    VAnimal Trainer. \u0412\u044B \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0435
    \u0441\u0440\u043E\u043A \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u0430, \u0438
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043E\u043D\u043E \u043D\u0435 \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0435\u0442\u0441\u044F.
    \u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u0418\u0433\u0440\u044B\xBB
    \u043C\u043E\u0436\u043D\u043E \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C
