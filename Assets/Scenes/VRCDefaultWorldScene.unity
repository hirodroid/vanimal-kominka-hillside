    \u0440\u0435\u0448\u0438\u0442\u0435, \u0433\u0434\u0435 \u0435\u0439 \u0431\u044B\u0442\u044C
    \u0438 \u043A\u0443\u0434\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C.
    \u041F\u043E\u043A\u0430 \u0432\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435
    \u043C\u0435\u0441\u0442\u043E, \u043C\u0435\u043D\u044E \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
    \u041F\u043E\u0441\u043B\u0435 \u0432\u044B\u0431\u043E\u0440\u0430 \u043E\u043D\u043E
    \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C,
    \u0430 \u0441\u043E\u0431\u0430\u043A\u0430 \u0441\u0430\u043C\u0430 \u0438\u0434\u0451\u0442
    \u043D\u0430 \u043C\u0435\u0441\u0442\u043E. \u0427\u0442\u043E\u0431\u044B \u0441\u043D\u043E\u0432\u0430
    \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043F\u043E\u0437\u0432\u0430\u043D\u043D\u0443\u044E
    \u0432\u0430\u043C\u0438 \u0441\u043E\u0431\u0430\u043A\u0443 \u0433\u0443\u043B\u044F\u0442\u044C,
    \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0451 \u0432\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435
    \xAB\u041F\u043E\u0437\u0432\u0430\u0442\u044C\xBB \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C\xBB.\n\n[\u041F\u043E\u0437\u044B
    \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F]\n4 \u043F\u043E\u0437\u044B
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E:
    \xAB\u041D\u0430 \u0431\u043E\u043A\u0443\xBB, \xAB\u041B\u0435\u0436\u0430\u0442\u044C\xBB,
    \xAB\u0421\u0438\u0434\u0435\u0442\u044C\xBB \u0438 \xAB\u041A\u043B\u0443\u0431\u043A\u043E\u043C\xBB.
