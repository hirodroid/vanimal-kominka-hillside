  - "\u0427\u0438\u043C \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F"
  - "\u041E\u0441\u044C \u044F\u043A \u043C\u043E\u0436\u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
    \u0442\u0443\u0442 \u0447\u0430\u0441. \u041F\u0440\u043E\u0431\u0443\u0439 \u0443
    \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443 \u043F\u043E\u0440\u044F\u0434\u043A\u0443.\n\n\u041F\u043E\u0433\u043B\u0430\u0434\u044C
    \u0441\u043E\u0431\u0430\u043A\u0443. \u041A\u0438\u043D\u044C \u043C'\u044F\u0447.
    \u041F\u0440\u0438\u0433\u043E\u0441\u0442\u0438 \u043B\u0430\u0441\u043E\u0449\u0430\u043C\u0438.
    \u0406 \u0446\u044C\u043E\u0433\u043E \u0432\u0436\u0435 \u0446\u0456\u043B\u043A\u043E\u043C
    \u0434\u043E\u0441\u0438\u0442\u044C.\n\n\u0423 \u0441\u0432\u043E\u0454\u043C\u0443
    \u043C\u0435\u043D\u044E \u0432\u0456\u0434\u043A\u0440\u0438\u0439 \xAB\u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438\xBB,
    \u0449\u043E\u0431 \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u043A\u0443
    \u0432 \u043C\u0456\u0441\u0446\u0435, \u044F\u043A\u0435 \u0442\u043E\u0431\u0456
    \u0434\u043E \u0432\u043F\u043E\u0434\u043E\u0431\u0438, \u0456 \u0432\u043A\u043B\u0430\u0441\u0442\u0438
    \u0457\u0457 \u0441\u043F\u0430\u0442\u0438 \u043F\u043E\u0440\u0443\u0447. \u0414\u043E\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435
    \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C \u0443 \xAB\u042F\u043A \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A\xBB.\n\n\u041F\u0430\u043C'\u044F\u0442\u043D\u0456
    \u043C\u0438\u0442\u0456 \u0441\u0442\u0430\u044E\u0442\u044C \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u044F\u043C\u0438
    \u043D\u0430 \u0434\u043E\u0448\u0446\u0456 \u0431\u0456\u043B\u044F \u0432\u0435\u0440\u0430\u043D\u0434\u0438.
    \u041F\u0440\u043E \u0446\u0435 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C
    \u0443 \xAB\u041F\u0440\u043E \u0444\u043E\u0442\u043E\xBB.\n\n\u0423 \u0432\u043A\u043B\u0430\u0434\u0446\u0456
    \xAB\u0412\u0431\u0440\u0430\u043D\u043D\u044F\xBB \u043C\u043E\u0436\u043D\u0430
    \u0432\u0431\u0440\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u043A\u0443, \u0430
    \u0443 \u0432\u043A\u043B\u0430\u0434\u0446\u0456 \xAB\u0415\u0444\u0435\u043A\u0442\u0438\xBB
    \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u0441\u044F\u0439\u0432\u043E \u043F\u0456\u0434
    \u0447\u0430\u0441 \u0433\u043B\u0430\u0434\u0456\u043D\u043D\u044F. \u041A\u043E\u043B\u0438
    \u0445\u0442\u043E\u0441\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
    \u0448\u043E\u0443 \u0447\u0435\u0440\u0435\u0437 \xAB\u0428\u043E\u0443\xBB,
    \u0443\u0441\u0456, \u0445\u0442\u043E \u0442\u0443\u0442, \u043C\u043E\u0436\u0443\u0442\u044C
    \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u0440\u0430\u0437\u043E\u043C.
    \u0423 \u0432\u043A\u043B\u0430\u0434\u0446\u0456 \xAB\u0406\u0433\u0440\u0438\xBB
    \u0454 \u043A\u0430\u043C\u0435\u0440\u0430 \u043E\u0447\u0438\u043C\u0430 \u0441\u043E\u0431\u0430\u043A\u0438
    \u0442\u0430 \u0456\u0433\u0440\u0438 \u0422\u0440\u0435\u043D\u0435\u0440\u0430.
    \u041F\u0440\u043E \u0443\u043C\u043E\u0432\u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u044F
    \u0448\u043E\u0443 \u0439 \u0456\u0433\u043E\u0440 \u0422\u0440\u0435\u043D\u0435\u0440\u0430
    \u0442\u0430 \u043F\u0440\u043E \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C
    \u0443 \xAB\u041F\u043E\u043A\u0443\u043F\u043A\u0438\xBB.\n\n\u041D\u0430 \u0441\u0443\u0441\u0456\u0434\u043D\u0456\u0439
    \u0434\u043E\u0448\u0446\u0456 \u043C\u043E\u0436\u043D\u0430 \u0434\u0430\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A\u0430\u043C \u0456\u043C\u0435\u043D\u0430 \u0442\u0430
    \u043E\u0431\u0440\u0430\u0442\u0438 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u044E.\n\n\u041D\u0435
    \u043E\u0431\u043E\u0432'\u044F\u0437\u043A\u043E\u0432\u043E \u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
    \u0432\u0441\u0435. \u041F\u0440\u043E\u0441\u0442\u043E \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
    \u0442\u0435\u0436 \u0434\u043E\u0431\u0440\u0435."
  - "\u0417\u0456 \u0441\u043F\u0430\u043B\u044C\u043D\u0456"
  - "\u041F\u043E\u0434\u0440\u0456\u043C\u0430\u0439 \u043F\u043E\u0440\u0443\u0447
    \u0456\u0437 \u0441\u043E\u0431\u0430\u043A\u043E\u044E\n\u041C\u0435\u043D\u044E:
    \u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u2192 \u041D\u0430 \u0431\u043E\u0446\u0456"
  - "\u0417\u043C\u0430\u0445\u043D\u0438 \u0440\u0443\u043A\u043E\u044E \u0442\u0430
    \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438, \u0449\u043E\u0431 \u043A\u0438\u043D\u0443\u0442\u0438"
  - "\u0417\u0430\u0442\u0438\u0441\u043D\u0438 \u043A\u043B\u0456\u043A \u0434\u043B\u044F
    \u0437\u0430\u043C\u0430\u0445\u0443 \u0439 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438,
    \u0449\u043E\u0431 \u043A\u0438\u043D\u0443\u0442\u0438"
  - "\u0423\u0442\u0440\u0438\u043C\u0443\u0439 \u043A\u043D\u043E\u043F\u043A\u0443
    \u043A\u0438\u0434\u043A\u0430 \u0442\u0430 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438,
    \u0449\u043E\u0431 \u043A\u0438\u043D\u0443\u0442\u0438"
  - "\u0421\u043F\u0440\u043E\u0431\u0443\u0439 \u043F\u043E\u0433\u043B\u0430\u0434\u0438\u0442\u0438
    \u0433\u043E\u043B\u043E\u0432\u0443, \u0449\u043E\u043A\u0438 \u0430\u0431\u043E
    \u043F\u0456\u0434\u0431\u043E\u0440\u0456\u0434\u0434\u044F\n\u0414\u0432\u043E\u043C\u0430
    \u0440\u0443\u043A\u0430\u043C\u0438 \u0441\u043E\u0431\u0430\u043A\u0430\u043C
    \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F \u0431\u0456\u043B\u044C\u0448\u0435"
  - "\u0423\u0442\u0440\u0438\u043C\u0443\u0439 \u043F\u0440\u0430\u0432\u0438\u0439
    \u0441\u0442\u0456\u043A \u0434\u043E\u043D\u0438\u0437\u0443, \u0449\u043E\u0431
    \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u043C\u0435\u043D\u044E\n\u0412\u0431\u0440\u0430\u043D\u043D\u044F,
    \u043B\u0430\u0441\u043E\u0449\u0456, \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438,
    \u0456\u0433\u0440\u0430\u0448\u043A\u0438, \u0448\u043E\u0443, \u0435\u0444\u0435\u043A\u0442\u0438
    \u0442\u0430 \u0456\u0433\u0440\u0438"
  - "\u041D\u0430\u0442\u0438\u0441\u043D\u0438 T, \u0449\u043E\u0431 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438
    \u043C\u0435\u043D\u044E\n\u0412\u0431\u0440\u0430\u043D\u043D\u044F, \u043B\u0430\u0441\u043E\u0449\u0456,
    \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438, \u0456\u0433\u0440\u0430\u0448\u043A\u0438,
    \u0448\u043E\u0443, \u0435\u0444\u0435\u043A\u0442\u0438 \u0442\u0430 \u0456\u0433\u0440\u0438"
  - "\u0422\u043E\u0440\u043A\u043D\u0438\u0441\u044C \xAB\u041C\u0435\u043D\u044E\xBB
    \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456\n\u0412\u0431\u0440\u0430\u043D\u043D\u044F,
    \u043B\u0430\u0441\u043E\u0449\u0456, \u043F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438,
    \u0456\u0433\u0440\u0430\u0448\u043A\u0438, \u0448\u043E\u0443, \u0435\u0444\u0435\u043A\u0442\u0438
    \u0442\u0430 \u0456\u0433\u0440\u0438"
  - "\u041C\u043E\u0436\u043D\u0430 \u043F\u043E\u0434\u0440\u0456\u043C\u0430\u0442\u0438
    \u043F\u043E\u0440\u0443\u0447 \u0456\u0437 \u0441\u043E\u0431\u0430\u043A\u043E\u044E\n\u0423
    \u043C\u0435\u043D\u044E: \u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438
    \u2192 \u041D\u0430 \u0431\u043E\u0446\u0456"
  - "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E
    \u0434\u043E Kominka Dog Run"
  - "\u041D\u0456\u0447\u043E\u0433\u043E \u043D\u0435\u043C\u0430\u0454 \u0432 \u0440\u0443\u043A\u0430\u0445?
    \u0423\u0441\u0435 \u0437\u0432\u0438\u0447\u043D\u0435 \u2014 \u0432\u0436\u0435
    \u0442\u0443\u0442\n- \u041F\u043E\u0433\u043B\u0430\u0434\u0438\u0442\u0438:
    \u043F\u0440\u043E\u0432\u0435\u0434\u0438 \u043F\u043E \u0433\u043E\u043B\u043E\u0432\u0456,
    \u0449\u043E\u043A\u0430\u0445 \u0447\u0438 \u043F\u0456\u0434\u0431\u043E\u0440\u0456\u0434\u0434\u044E
    \u2014 \u0441\u043E\u0431\u0430\u043A\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0441\u0442\u044C\n-
    \u041A\u0438\u043D\u0443\u0442\u0438 \u043C'\u044F\u0447: \u043F\u0456\u0434\u043D\u0456\u043C\u0438
    \u0442\u0430 \u043A\u0438\u043D\u044C, \u0441\u043E\u0431\u0430\u043A\u0430 \u043F\u0440\u0438\u043D\u0435\u0441\u0435
    \u043D\u0430\u0437\u0430\u0434\n- \u041F\u043E\u0434\u0440\u0456\u043C\u0430\u0442\u0438
    \u0440\u0430\u0437\u043E\u043C: \u0447\u0435\u0440\u0435\u0437 \xAB\u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438\xBB
    \u043D\u0430 \u0446\u0456\u0439 \u0434\u043E\u0448\u0446\u0456 \u0441\u043E\u0431\u0430\u043A\u0430
    \u043F\u0440\u0438\u0439\u0434\u0435 \u0439 \u043B\u044F\u0436\u0435 \u043F\u043E\u0440\u0443\u0447\n-
    \u0424\u043E\u0442\u043E: \u0432\u0434\u0430\u043B\u0456 \u043C\u0438\u0442\u0456
    \u0437\u043D\u0456\u043C\u0430\u044E\u0442\u044C\u0441\u044F \u0441\u0430\u043C\u0456
    \u0439 \u0437'\u044F\u0432\u043B\u044F\u044E\u0442\u044C\u0441\u044F \u043D\u0430
    \u0434\u043E\u0448\u0446\u0456 \u043D\u0430 \u0432\u0435\u0440\u0430\u043D\u0434\u0456\n\n\u0429\u043E
    \u0440\u043E\u0431\u0438\u0442\u044C \u0446\u044F \u0434\u043E\u0448\u043A\u0430:
    \u0447\u0430\u0441 \u0442\u0443\u0442 \u0441\u0442\u0430\u0454 \u0431\u0430\u043B\u0430\u043C\u0438,
    \u0430 \u0431\u0430\u043B\u0438 \u2014 \u0442\u0438\u043C, \u0449\u043E \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F\n-
    \u041B\u0430\u0441\u043E\u0449\u0456, \u0432\u0431\u0440\u0430\u043D\u043D\u044F,
    \u0448\u043E\u0443: \u0434\u0456\u0441\u0442\u0430\u0442\u0438, \u043E\u0434\u044F\u0433\u0442\u0438
    \u043D\u0430 \u0441\u043E\u0431\u0430\u043A\u0443, \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
    \u0432 \u0441\u0430\u0434\u0443 (\u0448\u043E\u0443 \u0434\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F
    \u0432\u0441\u0456, \u0445\u0442\u043E \u0442\u0443\u0442). \u0423 \u0432\u043A\u043B\u0430\u0434\u043A\u0430\u0445
    \u0443\u0433\u043E\u0440\u0456\n- \u0411\u0430\u043B\u0438 \u0442\u0430 \u0434\u0456\u0434\u0443\u0441\u044C:
    \xAB\u0411\u0430\u043B\u0438\xBB \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447
    \u0443\u0433\u043E\u0440\u0456 \u2014 \u044F\u043A \u0457\u0445 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
    \u0442\u0430 \u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043A\u043E\u0432\u0456
    \u043A\u043E\u0434\u0438. \u0414\u0456\u0434\u0443\u0441\u044C \u0443 \u0441\u0430\u0434\u0443
    \u0440\u043E\u0437\u043A\u0430\u0436\u0435, \u044F\u043A \u0433\u0440\u0430\u0442\u0438,
    \u0456 \u0434\u0430\u0441\u0442\u044C \u043F\u0435\u0440\u0448\u0456 \u0431\u0430\u043B\u0438"
  - "\u041F\u0456\u0441\u043B\u044F \u0437\u0430\u043A\u0440\u0438\u0442\u0442\u044F
    \u0443\u0442\u0440\u0438\u043C\u0443\u0439 \u043F\u0440\u0430\u0432\u0438\u0439
    \u0441\u0442\u0456\u043A \u0434\u043E\u043D\u0438\u0437\u0443, \u0449\u043E\u0431
    \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u0446\u0435 \u0431\u0443\u0434\u044C-\u043A\u043E\u043B\u0438.\n\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u0438
    \u0437\u043D\u043E\u0432\u0443: \u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
    \u2192 \u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u2192 \u0417
    \u0447\u043E\u0433\u043E \u043F\u043E\u0447\u0430\u0442\u0438"
  - "\u041F\u0456\u0441\u043B\u044F \u0437\u0430\u043A\u0440\u0438\u0442\u0442\u044F
    \u043D\u0430\u0442\u0438\u0441\u043D\u0438 T, \u0449\u043E\u0431 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
    \u0446\u0435 \u0431\u0443\u0434\u044C-\u043A\u043E\u043B\u0438.\n\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u0438
    \u0437\u043D\u043E\u0432\u0443: \u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
    \u2192 \u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u2192 \u0417
    \u0447\u043E\u0433\u043E \u043F\u043E\u0447\u0430\u0442\u0438"
  - "\u041F\u0456\u0441\u043B\u044F \u0437\u0430\u043A\u0440\u0438\u0442\u0442\u044F
    \u0442\u043E\u0440\u043A\u043D\u0438\u0441\u044C \xAB\u041C\u0435\u043D\u044E\xBB
    \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456, \u0449\u043E\u0431 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
    \u0446\u0435 \u0431\u0443\u0434\u044C-\u043A\u043E\u043B\u0438.\n\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u0438
    \u0437\u043D\u043E\u0432\u0443: \u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
    \u2192 \u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u2192 \u0417
    \u0447\u043E\u0433\u043E \u043F\u043E\u0447\u0430\u0442\u0438"
  - "\u041F\u0456\u0437\u043D\u0456\u0448\u0435"
  - "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u043C\u0435\u043D\u044E"
  - "\u0417 \u0447\u043E\u0433\u043E \u043F\u043E\u0447\u0430\u0442\u0438"
  - "\u042F\u043A \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0442\u0438 \u043C\u0435\u043D\u044E
    (\u0437\u0430 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u044F\u043C\u0438)\nVR:
    \u0443\u0442\u0440\u0438\u043C\u0443\u0439 \u043F\u0440\u0430\u0432\u0438\u0439
    \u0441\u0442\u0456\u043A \u0434\u043E\u043D\u0438\u0437\u0443 / \u041F\u041A:
    \u043D\u0430\u0442\u0438\u0441\u043D\u0438 T / \u0422\u0435\u043B\u0435\u0444\u043E\u043D:
    \u0442\u043E\u0440\u043A\u043D\u0438\u0441\u044C \xAB\u041C\u0435\u043D\u044E\xBB
    \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456"
  - "\u0423\u0442\u0440\u0438\u043C\u0443\u0439 \u043F\u0440\u0430\u0432\u0438\u0439
    \u0441\u0442\u0456\u043A \u0434\u043E\u043D\u0438\u0437\u0443 \u2014 \u043C\u0435\u043D\u044E"
  - "\u041D\u0430\u0442\u0438\u0441\u043D\u0438 T \u2014 \u043C\u0435\u043D\u044E"
  - "\u0422\u043E\u0440\u043A\u043D\u0438\u0441\u044C \xAB\u041C\u0435\u043D\u044E\xBB
    \u0432\u0433\u043E\u0440\u0456"
  - "\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u043F\u043E\u0437\u0443"
  - "\u041D\u0430 \u0431\u043E\u0446\u0456"
  - "\u041B\u0435\u0436\u0430\u0442\u0438"
  - "\u0421\u0438\u0434\u0456\u0442\u0438"
  - "\u0414\u043E \u0441\u043F\u0438\u0441\u043A\u0443 \u0441\u043E\u0431\u0430\u043A"
  - "\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u043C\u0456\u0441\u0446\u0435"
  - "\u041F\u0440\u0438\u0439\u043D\u044F\u0442\u0438 \u043F\u043E\u0437\u0443"
  - "\u0412\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u0442\u0438"
  - "\u0414\u0430\u0439 \u043B\u0430\u043F\u0443 (\u0449\u0435 \u0440\u0430\u0437
    \u2014 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u0442\u0438)"
  - "\u0412\u0438\u0431\u0435\u0440\u0438 \u043F\u043E\u0437\u0443, \u043F\u043E\u0442\u0456\u043C
    \u043C\u0456\u0441\u0446\u0435 \u0439 \u043D\u0430\u043F\u0440\u044F\u043C\u043E\u043A."
  - "\u041F\u043E\u043A\u0438 \u0441\u043E\u0431\u0430\u043A\u0430 \u0441\u0438\u0434\u0438\u0442\u044C,
    \u043F\u043E\u0442\u0440\u0438\u043C\u0430\u0439 \u0440\u0443\u043A\u0443 \u043F\u0435\u0440\u0435\u0434
    \u0457\u0457 \u0433\u0440\u0443\u0434\u044C\u043C\u0438 \u2014 \u0432\u043E\u043D\u0430
    \u0434\u0430\u0441\u0442\u044C \u043B\u0430\u043F\u0443.\n\u041F\u0440\u0438\u0431\u0435\u0440\u0438
    \u0440\u0443\u043A\u0443, \u0449\u043E\u0431 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u0442\u0438.
    \u041F\u043E\u0437\u0430 VR \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439
    \xAB\u0414\u0430\u0439 \u043B\u0430\u043F\u0443\xBB \u043F\u043E\u0440\u0443\u0447."
  - "\u0426\u044F \u0441\u043E\u0431\u0430\u043A\u0430 \u0437\u0430\u0440\u0430\u0437
    \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430. \u041C\u043E\u0436\u043D\u0430
    \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E
    \u0441\u043F\u0438\u0441\u043A\u0443 \u0441\u043E\u0431\u0430\u043A."
  - "\u0417\u0430\u0440\u0430\u0437: "
  - "\u041F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u0454\u043C\u043E \u0441\u043E\u0431\u0430\u043A\u0443..."
