  - "\u0406\u043C'\u044F \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E"
  - "\u0417\u0440\u043E\u0431\u0438\u0442\u0438 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u0435\u044E
    (\u043E\u0434\u043D\u0430 \u0441\u043E\u0431\u0430\u043A\u0430)"
  - "\u041F\u0440\u0438\u0431\u0440\u0430\u0442\u0438 \u0437 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0445"
  - "\u0423\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u044F"
  - "\u0417\u0430\u043A\u0440\u0438\u0442\u0438"
  - "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0445
    \u0456\u043C\u0435\u043D\u2026"
  - "\u0412\u0456\u0434\u043F\u043E\u0447\u0438\u0432\u0430\u0454"
  - "\u0422\u0456\u0448\u0438\u0442\u044C\u0441\u044F \u0433\u043B\u0430\u0434\u0456\u043D\u043D\u044F\u043C"
  - "\u0413\u0440\u0430\u0454\u0442\u044C\u0441\u044F \u0437 \u043C'\u044F\u0447\u0435\u043C"
  - "\u0421\u043A\u043B\u0430\u0434\u0430\u0454 \u043A\u043E\u043C\u0443\u0441\u044C
    \u043A\u043E\u043C\u043F\u0430\u043D\u0456\u044E"
  - "\u0421\u043B\u0443\u0445\u0430\u0454 \u043C\u0443\u0437\u0438\u043A\u0443"
  - "\u0412\u0456\u0434\u043F\u043E\u0447\u0438\u0432\u0430\u0454 \u043F\u0456\u0441\u043B\u044F
    \u0456\u0433\u043E\u0440"
  - "\u0412\u0456\u0442\u0430\u0454\u0442\u044C\u0441\u044F"
  - "\u0413\u0440\u0430\u0454\u0442\u044C\u0441\u044F \u0437 \u0456\u043D\u0448\u0438\u043C\u0438
    \u0441\u043E\u0431\u0430\u043A\u0430\u043C\u0438"
  - '?'
  - "\u0406\u043C\u0435\u043D\u0430 \u0442\u0430 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u044F"
  - "\u041D\u0430\u0442\u0438\u0441\u043D\u0438 \u043D\u0430 \u043A\u0430\u0440\u0442\u043A\u0443,
    \u0449\u043E\u0431 \u0434\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u0446\u0456
    \u0441\u0432\u043E\u0454 \u0456\u043C'\u044F. \u0419\u043E\u0433\u043E \u043F\u043E\u0431\u0430\u0447\u0438\u0448
    \u043B\u0438\u0448\u0435 \u0442\u0438; \u0434\u043B\u044F \u0456\u043D\u0448\u0438\u0445
    \u0456 \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u0457 \u0441\u043E\u0431\u0430\u043A\u0438
    \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0437\u043C\u0456\u043D\u0438\u0442\u044C\u0441\u044F.
    \u041D\u0430\u0437\u0438\u0432\u0430\u0439 \u044F\u043A \u0445\u043E\u0447\u0435\u0448.\n\u0412
    \u0456\u043C\u0435\u043D\u0456 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
    \u043B\u0456\u0442\u0435\u0440\u0438, \u0446\u0438\u0444\u0440\u0438, \u0445\u0456\u0440\u0430\u0433\u0430\u043D\u0443
    \u0442\u0430 \u043A\u0430\u0442\u0430\u043A\u0430\u043D\u0443, \u0434\u043E 12
    \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0432. \u0406\u0454\u0440\u043E\u0433\u043B\u0456\u0444\u0438
    \u0442\u0430 \u0435\u043C\u043E\u0434\u0437\u0456 \u043D\u0435 \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0430\u044E\u0442\u044C\u0441\u044F,
    \u0442\u043E\u043C\u0443 \u0432\u0438\u0434\u0430\u043B\u044F\u044E\u0442\u044C\u0441\u044F
    \u043F\u0456\u0434 \u0447\u0430\u0441 \u0432\u0432\u0435\u0434\u0435\u043D\u043D\u044F.\n\u041C\u043E\u0436\u043D\u0430
    \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u043E\u0434\u043D\u0443 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u044E.
    \u041A\u043E\u043B\u0438 \u0442\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0448,
    \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u044F \u043E\u0434\u0438\u043D
    \u0440\u0430\u0437 \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u043F\u0440\u0438\u0432\u0456\u0442\u0430\u0442\u0438\u0441\u044F,
    \u0449\u043E\u0439\u043D\u043E \u0437\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u044C\u0441\u044F.
    \u0406\u043D\u043E\u0434\u0456 \u0432\u043E\u043D\u0430 \u0439 \u0441\u0430\u043C\u0430
    \u0437\u0430\u0433\u043B\u044F\u0434\u0430\u0454 \u0434\u043E \u0442\u0435\u0431\u0435.\n\u042F\u043A\u0449\u043E
    \u0445\u0442\u043E\u0441\u044C \u0456\u043D\u0448\u0438\u0439 \u0457\u0457 \u0433\u043B\u0430\u0434\u0438\u0442\u044C,
    \u043A\u043B\u0438\u0447\u0435 \u0430\u0431\u043E \u0433\u0440\u0430\u0454\u0442\u044C\u0441\u044F
    \u0437 \u043D\u0435\u044E, \u0446\u0435 \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0435.
    \u0412\u043E\u043D\u0430 \u043F\u0456\u0434\u0456\u0439\u0434\u0435, \u043A\u043E\u043B\u0438
    \u0437\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u044C\u0441\u044F, \u2014 \u0437\u0430\u0447\u0435\u043A\u0430\u0439
    \u0442\u0440\u043E\u0445\u0438.\n\u0423\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u044F
    \u043D\u0435 \u043D\u0430\u043B\u0435\u0436\u0438\u0442\u044C \u043B\u0438\u0448\u0435
    \u0442\u043E\u0431\u0456. \u0423\u0441\u0456 \u0439 \u0434\u0430\u043B\u0456
    \u043C\u043E\u0436\u0443\u0442\u044C \u0433\u0440\u0430\u0442\u0438\u0441\u044F
    \u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u044E \u0441\u043E\u0431\u0430\u043A\u043E\u044E.\n\u0406\u043C\u0435\u043D\u0430
    \u0442\u0430 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u0446\u044F \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044E\u0442\u044C\u0441\u044F
    \u0439 \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u044C\u0441\u044F \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E
    \u0440\u0430\u0437\u0443."
  - "\u0417\u0430\u043A\u0440\u0438\u0442\u0438"
  - "\u041A\u0443\u043F\u0438\u0442\u0438 {0} \u0437\u0430 {1}?"
  - "\u041A\u0443\u043F\u0438\u0442\u0438 {0}?"
  - "\u041A\u0443\u043F\u0456\u0432\u043B\u044F \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456
    VRChat. \u0422\u0443\u0442 \u043C\u043E\u0436\u043D\u0430 \u0439 \u0434\u0430\u0440\u0443\u0432\u0430\u0442\u0438."
  - "\u041F\u043E\u0434\u0430\u0440\u0443\u0432\u0430\u0442\u0438 {0}?"
  - "\u041A\u0443\u043F\u043B\u0435\u043D\u043E \xB7 \u0443 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456
    VRChat \u0432\u0438\u0431\u0435\u0440\u0438 \xAB\u041F\u043E\u0434\u0430\u0440\u0443\u0432\u0430\u0442\u0438\xBB
    \u0439 \u043E\u0434\u0435\u0440\u0436\u0443\u0432\u0430\u0447\u0430"
  - "\u0417\u0430\u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F {0} pt"
  - "\u0411\u0440\u0430\u043A\u0443\u0454 {0} pt"
  - "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D"
  - "\u0406\u0433\u0440\u0438"
  - "\u0414\u043E \u0456\u0433\u043E\u0440, \u044F\u043A\u0456 \u043F\u043E\u0447\u0438\u043D\u0430\u0454
    \u0422\u0440\u0435\u043D\u0435\u0440, \u043C\u043E\u0436\u0443\u0442\u044C \u0434\u043E\u043B\u0443\u0447\u0438\u0442\u0438\u0441\u044F
    \u0432\u0441\u0456, \u0445\u0442\u043E \u0442\u0443\u0442."
  - "\u041A\u0430\u043C\u0435\u0440\u0430 \u043E\u0447\u0438\u043C\u0430 \u0441\u043E\u0431\u0430\u043A\u0438
    \u2014 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
    \u0437\u0430 \u0431\u0430\u043B\u0438, \u0432\u0438\u0434\u0438\u043C\u0430 \u043B\u0438\u0448\u0435
    \u0432\u0430\u043C"
  - "VAnimal Trainer \u2014 \u043D\u0430 \u0441\u0442\u0440\u043E\u043A, \u0432\u0456\u0434
    500 Credits \u043D\u0430 \u043C\u0456\u0441\u044F\u0446\u044C, \u043D\u0435 \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u043E"
  - "VAnimal Trainer \u2014 \u0430\u043A\u0442\u0438\u0432\u043D\u043E, \u0434\u0456\u0454
    \u0432\u0435\u0441\u044C \u0432\u0456\u0437\u0438\u0442, \u044F\u043A\u0449\u043E
    \u0431\u0443\u043B\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u0435 \u043F\u0440\u0438
    \u0432\u0445\u043E\u0434\u0456"
  - "\u0422\u0440\u0435\u043D\u0435\u0440 \u043C\u043E\u0436\u0435 \u0437\u0456\u0431\u0440\u0430\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A, \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438
    \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0438 \u0439 \u0434\u0430\u0442\u0438
    \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u043C \u0434\u0432\u043E\u043C \u0441\u043E\u0431\u0430\u043A\u0430\u043C
    \u043F\u043E\u0433\u0440\u0430\u0442\u0438\u0441\u044F \u0440\u0430\u0437\u043E\u043C.\n\u0412\u0431\u0440\u0430\u043D\u043D\u044F,
    \u0456\u0433\u0440\u0430\u0448\u043A\u0438 \u0442\u0430 \u0448\u043E\u0443 \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u044C\u0441\u044F
    \u043E\u043A\u0440\u0435\u043C\u043E. \u0414\u0440\u0443\u0437\u0456 \u0431\u0435\u0437
    \u0422\u0440\u0435\u043D\u0435\u0440\u0430 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E
    \u043C\u043E\u0436\u0443\u0442\u044C \u0431\u0440\u0430\u0442\u0438 \u0443\u0447\u0430\u0441\u0442\u044C
    \u0443 \u0433\u0440\u0443\u043F\u043E\u0432\u0438\u0445 \u0444\u043E\u0442\u043E,
    \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u0448\u043E\u0443 \u0442\u0430
    \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0438.\n500 Credits \u0437\u0430 1
    \u043C\u0456\u0441\u044F\u0446\u044C / 1 350 \u0437\u0430 3 / 2 550 \u0437\u0430
    6 / 4 800 \u0437\u0430 12. \u0411\u0435\u0437 \u0430\u0432\u0442\u043E\u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u043D\u044F;
    \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u043D\u044F \u0434\u043E\u0434\u0430\u0454\u0442\u044C\u0441\u044F
    \u0434\u043E \u0440\u0435\u0448\u0442\u0438 \u0434\u043D\u0456\u0432."
  - "\u041F\u0440\u0430\u0432\u0430 \u0422\u0440\u0435\u043D\u0435\u0440\u0430, \u0430\u043A\u0442\u0438\u0432\u043D\u0456
    \u043F\u0440\u0438 \u0432\u0445\u043E\u0434\u0456, \u0434\u0456\u044E\u0442\u044C
    \u0432\u0435\u0441\u044C \u0432\u0456\u0437\u0438\u0442. \u0417\u0431\u0456\u0440,
    \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0438 \u0442\u0430 \u0433\u0440\u0430
    \u0443\u0434\u0432\u043E\u0445 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456
    \u0432\u0441\u0456\u043C, \u0445\u0442\u043E \u0442\u0443\u0442."
  - "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D"
  - "\u041A\u0443\u043F\u0456\u0432\u043B\u044F \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456
    VRChat"
  - "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u043E \u0422\u0440\u0435\u043D\u0435\u0440\u0430\u043C"
  - "\u0412\u0438\u0434 \u043E\u0447\u0438\u043C\u0430 \u0441\u043E\u0431\u0430\u043A\u0438
    \u043D\u0430 \u0432\u0430\u0448\u043E\u043C\u0443 \u043C\u043E\u043D\u0456\u0442\u043E\u0440\u0456"
  - "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u043C\u043E\u043D\u0456\u0442\u043E\u0440
    \u0434\u043E \u0441\u0435\u0431\u0435"
  - "\u042F\u043A\u0449\u043E \u043F\u0440\u0438\u0431\u0440\u0430\u0442\u0438, \u043A\u0430\u043C\u0435\u0440\u0430
    \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u044C\u0441\u044F"
  - "\u0413\u0440\u0443\u043F\u043E\u0432\u0456 \u0444\u043E\u0442\u043E \u0432 6
    \u0448\u0438\u043A\u0443\u0432\u0430\u043D\u043D\u044F\u0445"
  - "\u041F\u0435\u0440\u0435\u0433\u043E\u043D\u0438 / \u0432\u0438\u0431\u0440\u0430\u0442\u0438
    \u0434\u0432\u043E\u0445 \u0441\u043E\u0431\u0430\u043A"
  - "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u043F\u043E\u0442\u043E\u0447\u043D\u0435
    \u0437\u0430\u043D\u044F\u0442\u0442\u044F"
  - "\u0422\u0440\u0435\u043D\u0435\u0440 \u043A\u0443\u043F\u0443\u0454\u0442\u044C\u0441\u044F
    \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456 VRChat. \u042F\u043A\u0449\u043E
    \u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u043F\u0440\u0438 \u0432\u0445\u043E\u0434\u0456,
    \u0434\u0456\u0454 \u0432\u0435\u0441\u044C \u0432\u0456\u0437\u0438\u0442."
  - "\u041E\u0444\u043E\u0440\u043C\u0438\u0442\u0438 VAnimal Trainer?"
  - "\u0412\u0456\u0434 500 Credits \u043D\u0430 \u043C\u0456\u0441\u044F\u0446\u044C.
    \u041D\u0430 3 / 6 / 12 \u043C\u0456\u0441\u044F\u0446\u0456\u0432 \u2014 450
    / 425 / 400 \u043D\u0430 \u043C\u0456\u0441\u044F\u0446\u044C. \u0411\u0435\u0437
    \u0430\u0432\u0442\u043E\u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u043D\u044F."
  - "\u041A\u0443\u043F\u043B\u0435\u043D\u043E \xB7 \u0432\u0438\u0431\u0435\u0440\u0438
    \u0441\u043E\u0431\u0430\u043A\u0443 \u0434\u043B\u044F \u043F\u043E\u043A\u0430\u0437\u0443"
  - "\u0414\u043E\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435"
  - "\u0414\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u0432 \xAB\u0415\u0444\u0435\u043A\u0442\u0430\u0445\xBB"
  - "\u0414\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u0443 \xAB\u0412\u0431\u0440\u0430\u043D\u043D\u0456\xBB"
