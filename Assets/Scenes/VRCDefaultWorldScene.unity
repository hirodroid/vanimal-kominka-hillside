    \u0438 \u0437\u0430\u0431\u0435\u0433\u0438 \u0438\u043B\u0438 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    2 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u0441\u043E\u0431\u0430\u043A,
    \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0438 \u043F\u043E\u0438\u0433\u0440\u0430\u043B\u0438
    \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
    \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E, \u0434\u0430\u0436\u0435
    \u0431\u0435\u0437 \u0447\u043B\u0435\u043D\u0441\u0442\u0432\u0430. \u041F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0432 \u0440\u0430\u0437\u0434\u0435\u043B\u0435
    \xAB\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\xBB \u0432 \u043C\u0435\u043D\u044E
    \xAB\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438\xBB.\n\n\u041F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
    \u0448\u043E\u0443 \u043C\u043E\u0436\u0435\u0442 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440,
    \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043E\u043D\u043E \u043A\u0443\u043F\u043B\u0435\u043D\u043E.
    \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u043E\u043C
    \u0437\u0434\u0435\u0441\u044C \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u043A\u043E\u043C\u043D\u0430\u0442\u044B,
    \u0430 \u0435\u0441\u043B\u0438 \u0435\u0433\u043E \u043D\u0435\u0442, \u0442\u043E
    Master. \u041A\u043E\u0433\u0434\u0430 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0430
    \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430 \xAB\u0428\u043E\u0443
    \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
    \u0432\u0441\u0435: \u0412\u041A\u041B\xBB, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0442\u043E\u0436\u0435 \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
    \u043A\u0443\u043F\u043B\u0435\u043D\u043D\u044B\u0435 \u0438\u043C\u0438 \u0448\u043E\u0443.
    \u0418\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u044D\u0442\u0430
    \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0430.
    \u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043C\u043E\u0436\u0435\u0442
    \u0438\u0434\u0442\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u043E
    \u0448\u043E\u0443, \u0430 \u043F\u043E\u0441\u043B\u0435 \u0435\u0433\u043E
    \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u043D\u0443\u0436\u043D\u043E
    \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C,
    \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0442\u044C
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435. \u0412\u0440\u0435\u043C\u044F
    \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F \u0443\u043A\u0430\u0437\u0430\u043D\u043E
    \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435. \u0421\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043C\u043E\u0436\u043D\u043E \u0432\u0441\u0435\u043C \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E.
    \u0412 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0448\u043E\u0443
    \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0442 \u0438 \u0441\u043E\u0431\u0430\u043A\u0438."
  - "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \xAB\u041B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430\xBB
    \u0432 \u043B\u0438\u0447\u043D\u043E\u043C \u043C\u0435\u043D\u044E \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0414\u0430\u0442\u044C\xBB. \u041A\u043E\u0433\u0434\u0430 \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E
    \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F, \u043C\u0435\u043D\u044E \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F.
    \u0423\u0433\u043E\u0441\u0442\u0438\u0442\u0435 \u0438\u043C \u0441\u043E\u0431\u0430\u043A\u0443.\n\n\u041F\u043E\u043A\u0430
    \u0432\u044B \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E,
    \u0441\u043E\u0431\u0430\u043A\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442
    \u0431\u043B\u0438\u0436\u0435. \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435
    \u0435\u0433\u043E, \u0438 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0430\u044F
    \u0441\u043E\u0431\u0430\u043A\u0430 \u0435\u0433\u043E \u0441\u044A\u0435\u0441\u0442.
    \u0417\u0430 \u0440\u0430\u0437 \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u043E \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E.
    \u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u0434\u0430\u043B
    \u0432\u0430\u043C 5 \u0448\u0442\u0443\u043A. \u041A\u043E\u0433\u0434\u0430
    \u0437\u0430\u043A\u043E\u043D\u0447\u0430\u0442\u0441\u044F, \u043E\u0431\u043C\u0435\u043D\u044F\u0439\u0442\u0435
    \u043D\u0430 \u043F\u043E\u043B\u043A\u0435 \u043E\u0447\u043A\u0438 \u043D\u0430
    \u043D\u043E\u0432\u044B\u0435 \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430."
  - "[\u041A\u0430\u043A \u043F\u043E\u0437\u0432\u0430\u0442\u044C \u0441\u043E\u0431\u0430\u043A\u0443]\n\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
