  texts:
  - "\u8DDD\u96E2\u30D5\u30A7\u30FC\u30C9\u8A2D\u5B9A"
  - "\u8DDD\u96E2\u30D5\u30A7\u30FC\u30C9 (PC\u306E\u307F)"
  - "\u6A19\u6E96"
  - "\u6DF1\u3081"
  - "\u3084\u308F\u3089\u304B\u3081"
  - "\u30AB\u30B9\u30BF\u30E0"
  - "\u8272 (#RRGGBB)"
  - "\u958B\u59CB\u8DDD\u96E2 (m)"
  - "\u7D42\u4E86\u8DDD\u96E2 (m)"
  - "\u5F37\u5EA6"
  - "\u81EA\u5206\u3060\u3051\u306B\u53CD\u6620\u30FB\u6B21\u56DE\u3082\u5FA9\u5143"
  - "\u78BA\u5B9A\u524D\u306E\u5165\u529B\u306F\u5207\u308A\u66FF\u3048\u308B\u3068\u7834\u68C4"
  - "\u78BA\u5B9A\u3057\u3066\u4FDD\u5B58"
  - "\u30AB\u30B9\u30BF\u30E0\u3092\u4FDD\u5B58\u3057\u307E\u3057\u305F"
  - "\u672A\u78BA\u5B9A: \u300C\u78BA\u5B9A\u3057\u3066\u4FDD\u5B58\u300D\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044"
  - "\u8A2D\u5B9A\u3092\u3088\u307F\u3053\u307F\u4E2D"
  - "\u8272\u306F # \u30686\u6841\u306E16\u9032\u6570\u3067\u5165\u529B"
  - "\u6570\u5024\u306F\u534A\u89D2\u30FB\u5C0F\u6570\u70B9\u306F . \u3067\u5165\u529B"
  - "\u958B\u59CB\u8DDD\u96E2 > \u7D42\u4E86\u8DDD\u96E2 >= 0\u3001\u5F37\u5EA6 >=
    0"
  - "\u4FDD\u5B58\u5024\u3092\u8AAD\u3081\u306A\u3044\u305F\u3081\u6A19\u6E96\u3092\u8868\u793A"
  - "\u5927\u304D\u304F\u898B\u308B"
  - "\u9589\u3058\u308B"
  - "\u304A\u3058\u3044\u3055\u3093\u306B\u8A71\u3057\u304B\u3051\u308B"
  - "\u3088\u304F\u6765\u305F\u306D\u3002\n\u3053\u3053\u306F\u308F\u3057\u306E\u5EAD\u3060\u3088\u3002\n\u72AC\u305F\u3061\u3068\u597D\u304D\u306B\u904A\u3093\u3067\u3044\u304D\u306A\u3002\n\u77E5\u308A\u305F\u3044\u3053\u3068\u304C\u3042\u308C\u3070\u3001\n\u4F55\u3067\u3082\u805E\u3044\u3066\u304A\u304F\u308C\u3002"
  - "\u3088\u304F\u6765\u305F\u306D\u3002\n\u3053\u3053\u306F\u308F\u3057\u306E\u5EAD\u3060\u3088\u3002\n\n\u306F\u3058\u3081\u3066\u3060\u306D\u3002\n\u3053\u308C\u3092\u6301\u3063\u3066\u3044\u304D\u306A\u3002\n{0}pt\u3060\u3002\n\u597D\u304D\u306A\u3082\u306E\u3068\u4EA4\u63DB\u3057\u306A\u3002\n\n\u72AC\u305F\u3061\u3068\u597D\u304D\u306B\u904A\u3093\u3067\u3044\u304D\u306A\u3002\n\u77E5\u308A\u305F\u3044\u3053\u3068\u304C\u3042\u308C\u3070\u3001\n\u4F55\u3067\u3082\u805E\u3044\u3066\u304A\u304F\u308C\u3002"
  - "\u30E1\u30CB\u30E5\u30FC"
  - "\u306A\u3067\u304B\u305F"
  - "\u72AC\u306E\u3053\u3068"
  - "\u5199\u771F\u306E\u3053\u3068"
  - "\u304A\u304B\u3044\u3082\u306E"
  - "\u304A\u3084\u3064\u306E\u3053\u3068"
  - "\u307E\u305F\u306D"
  - "\u547C\u3076\u3053\u3068"
  - "\u307E\u305A\u306F\u624B\u5143\u306E\u30E1\u30CB\u30E5\u30FC\u3092\n\u958B\u3044\u3066\u307F\u306A\u3002\nVR\u306F\u53F3\u30B9\u30C6\u30A3\u30C3\u30AF\u3092\u4E0B\u306B\n\u5012\u3057\u305F\u307E\u307E\u306B\u3059\u308B\u3068\u51FA\u308B\u3002\nDesktop\u306FT\u30AD\u30FC\u3001\n\u30B9\u30DE\u30DB\u306F\u753B\u9762\u306B\u3042\u308B\n\u300C\u30E1\u30CB\u30E5\u30FC\u300D\u3092\u62BC\u3057\u306A\u3002\n\n\u4E0A\u306E\u9805\u76EE\u306F7\u3064\u3060\u3002\n\u300C\u304B\u3056\u308A\u300D\u72AC\u306B\u98FE\u308A\u3092\u3064\u3051\u308B\u3002\n\u300C\u304A\u3084\u3064\u300D\u304A\u3084\u3064\u3092\u624B\u5143\u306B\u51FA\u3059\u3002\n\u300C\u547C\u3076\u300D\u72AC\u3092\u305D\u3070\u306B\u547C\u3073\u3001\n\u30DD\u30FC\u30BA\u3092\u9078\u3076\u3002\n\u300C\u304A\u3082\u3061\u3083\u300D\u72AC\u306E\u30DC\u30FC\u30EB\u3092\n\u624B\u5143\u3078\u623B\u3059\u3002\n\u300C\u30E9\u30A4\u30D6\u300D\u5EAD\u3067\u30E9\u30A4\u30D6\u3092\u958B\u304F\u3002\n\u300C\u30D1\u30FC\u30C6\u30A3\u30AF\u30EB\u300D\u306A\u3067\u305F\u3068\u304D\u306E\n\u5149\u3092\u9078\u3076\u3002\n\u300C\u3042\u305D\u3076\u300D\u72AC\u76EE\u7DDA\u30AB\u30E1\u30E9\u3068\u3001\n\u30C8\u30EC\u30FC\u30CA\u30FC\u306E\u904A\u3073\u3002\n\n\u4E0A\u306E\u300C\u30DD\u30A4\u30F3\u30C8\u300D\u3092\u62BC\u3059\u3068\u3001\n\u30DD\u30A4\u30F3\u30C8\u306E\u5165\u624B\u65B9\u6CD5\u3068\n\u30AE\u30D5\u30C8\u30B3\u30FC\u30C9\u306E\u5165\u529B\u304C\u3042\u308B\u3088\u3002\n\u300C\u8A2D\u5B9A\u300D\u306B\u306F\u97F3\u91CF\u3001\u6697\u3055\u3001\n\u8A00\u8A9E\u3001\u5199\u771F\u306E\u89E3\u50CF\u5EA6\u304C\u3042\u308B\u3002\n\u30E9\u30B8\u30AA\u3068\u8DDD\u96E2\u30D5\u30A7\u30FC\u30C9\u3082\n\u3042\u308B\u304C\u3001\u3069\u3061\u3089\u3082PC\u3060\u3051\u3060\u3002\n\u7BA1\u7406\u8005\u306A\u3089\u3001\u547C\u3076\u3068\u30E9\u30A4\u30D6\u3092\n\u307F\u3093\u306A\u306B\u8A31\u3059\u9805\u76EE\u3082\u3042\u308B\u3002\n\u7BA1\u7406\u8005\u306F\u3001\u3053\u306E\u90E8\u5C4B\u306E\n\u30AA\u30FC\u30CA\u30FC\u306E\u3053\u3068\u3060\u3088\u3002\n\u30AA\u30FC\u30CA\u30FC\u304C\u3044\u306A\u3044\u3068\u304D\u306F\nMaster\u304C\u4EE3\u308F\u308A\u3092\u3059\u308B\u3002\n\u300C\u306F\u3058\u3081\u306B\u300D\u3082\u8A2D\u5B9A\u306E\n\u30A4\u30F3\u30D5\u30A9\u30E1\u30FC\u30B7\u30E7\u30F3\u304B\u3089\n\u8AAD\u307F\u8FD4\u305B\u308B\u3002\n\n\u4F7F\u3044\u7D42\u308F\u3063\u305F\u3089\u300C\u9589\u3058\u308B\u300D\u3060\u3002\nVR\u3068\u30B9\u30DE\u30DB\u3067\u306F\u3001\u958B\u304F\u64CD\u4F5C\u3092\n\u3082\u3046\u4E00\u5EA6\u3059\u308B\u3068\u3001\u9060\u304F\u306B\n\u7F6E\u3044\u3066\u304D\u3066\u3082\u624B\u5143\u306B\u623B\u308B\u3002\nDesktop\u306ET\u30AD\u30FC\u306F\n\u958B\u304F\u30FB\u9589\u3058\u308B\u306E\u5207\u308A\u66FF\u3048\u3060\u3002"
  - "\u72AC\u306F\u3001\u982D\u306E\u3046\u3048\u3001\u307B\u3063\u307A\u305F\u3001\n\u3042\u3054\u306E\u4E0B\u3092\u306A\u3067\u3066\u3084\u308C\u308B\u3088\u3002\n\u7247\u624B\u3067\u3082\u3088\u308D\u3053\u3076\u304C\u3001\n\u4E21\u624B\u3060\u3068\u5927\u559C\u3073\u3067\u3001\n\u51FA\u3066\u304F\u308B\u5149\u306E\u6F14\u51FA\u3082\u5909\u308F\u308B\u3002\n\n\u5149\u306E\u6F14\u51FA\u306F\u3001\u624B\u5143\u30E1\u30CB\u30E5\u30FC\u306E\n\u300C\u30D1\u30FC\u30C6\u30A3\u30AF\u30EB\u300D\u3067\u9078\u3079\u308B\u3002\n\u7121\u6599\u306E\u3082\u306E\u3082\u3042\u308B\u3057\u3001\n\u30DD\u30A4\u30F3\u30C8\u3067\u8CB7\u3046\u3082\u306E\u3084\u3001\n\u30E9\u30A4\u30D6\u306E\u5546\u54C1\u306B\u3064\u3044\u3066\u304F\u308B\n\u3082\u306E\u3082\u3042\u308B\u3088\u3002"
  - "\u307B\u3046\u3063\u3066\u304A\u3044\u3066\u3082\u3001\u72AC\u305F\u3061\u306F\n\u8FFD\u3044\u304B\u3051\u3063\u3053\u3092\u3057\u305F\u308A\u3001\n\u3058\u3083\u308C\u5408\u3063\u305F\u308A\u3057\u3066\u3044\u308B\u3002\n\u81EA\u7136\u306B\u59CB\u307E\u308B\u3058\u3083\u308C\u5408\u3044\u306F\n\u8AB0\u3067\u3082\u305F\u3060\u3067\u898B\u3089\u308C\u308B\u3088\u3002\n\u3064\u304B\u308C\u305F\u3089\u6C34\u3092\u98F2\u3093\u3067\u3001\n\u4F0F\u305B\u3066\u4F11\u3080\u3093\u3060\u3088\u3002\n\u306A\u304C\u3081\u3066\u3044\u308B\u3060\u3051\u3067\u3082\n\u3044\u3044\u3082\u3093\u3060\u3088\u3002\n\n\u30DC\u30FC\u30EB\u306F\u72AC\u3054\u3068\u306B\u8272\u3068\u5927\u304D\u3055\u304C\n\u304D\u307E\u3063\u3066\u3044\u3066\u3001\u6295\u3052\u308B\u3068\n\u305D\u306E\u72AC\u304C\u6301\u3063\u3066\u304D\u3066\u304F\u308C\u308B\u3088\u3002\nDesktop\u306F\u30AF\u30EA\u30C3\u30AF\u9577\u62BC\u3057\u3067\n\u305F\u3081\u3066\u3001\u96E2\u3059\u3068\u6295\u3052\u3089\u308C\u308B\u3002\nVR\u3067\u624B\u306B\u6301\u3063\u305F\u307E\u307E\n\u6295\u3052\u308B\u3075\u308A\u3092\u3059\u308B\u3068\u3001\n\u3053\u3061\u3089\u3092\u898B\u305F\u308A\u3001\n\u5420\u3048\u305F\u308A\u3059\u308B\u3053\u3068\u3082\u3042\u308B\u3088\u3002\n\n\u30DC\u30FC\u30EB\u304C\u898B\u3064\u304B\u3089\u306A\u3051\u308C\u3070\u3001\n\u30E1\u30CB\u30E5\u30FC\u306E\u300C\u304A\u3082\u3061\u3083\u300D\u3067\n\u305D\u306E\u72AC\u306E\u300C\u624B\u5143\u3078\u300D\u3092\u62BC\u3057\u306A\u3002\n\u8AB0\u304B\u304C\u6301\u3063\u3066\u3044\u308B\u9593\u3084\u3001\n\u72AC\u304C\u305D\u306E\u30DC\u30FC\u30EB\u3067\u904A\u3093\u3067\u3044\u308B\n\u9593\u306F\u3001\u623B\u305B\u306A\u3044\u3088\u3002\n\n\u72AC\u3092\u305D\u3070\u306B\u547C\u3093\u3067\n\u5BDD\u3066\u3082\u3089\u3046\u8A71\u306F\u300C\u547C\u3076\u3053\u3068\u300D\u3060\u3002\n\n\u3068\u306A\u308A\u306E\u300C\u5EAD\u306E\u72AC\u305F\u3061\u300D\u306E\u677F\u3067\u3001\n\u72AC\u306B\u547C\u3073\u540D\u3092\u3064\u3051\u305F\u308A\u3001\n\u304A\u6C17\u306B\u5165\u308A\u3092\u9078\u3093\u3060\u308A\u3067\u304D\u308B\u3088\u3002\n\u304F\u308F\u3057\u304F\u306F\u3001\u677F\u306E\u300C\uFF1F\u300D\u3092\n\u898B\u3066\u307F\u306A\u3002"
  - "\u72AC\u3068\u904A\u3093\u3067\u3044\u308B\u3068\u3001\n\u3044\u3044\u77AC\u9593\u304C\u5199\u771F\u306B\u306A\u3063\u3066\u3001\n\u7E01\u5074\u306E\u5199\u771F\u677F\u306B\u4E26\u3076\u3088\u3002\n\u5BDD\u5BA4\u306B\u306F\u3001\u6DFB\u3044\u5BDD\u306E\u5199\u771F\u3060\u3002\n\u5199\u771F\u306F\u7A2E\u985E\u3054\u3068\u306B\u3001\n\u305D\u306E\u67A0\u304C\u3044\u3063\u3071\u3044\u306B\u306A\u308B\u3068\n\u53E4\u3044\u3082\u306E\u304B\u3089\u5165\u308C\u66FF\u308F\u308B\u3088\u3002\n\n\u5199\u771F\u306F\u304D\u307F\u3060\u3051\u306E\u3082\u306E\u3067\u3001\n\u307B\u304B\u306E\u4EBA\u306B\u306F\u5225\u306E\u5199\u771F\u304C\n\u898B\u3048\u3066\u3044\u308B\u3002\n\u3053\u306E\u30EF\u30FC\u30EB\u30C9\u304B\u3089\u51FA\u308B\u3068\n\u5199\u771F\u306F\u6D88\u3048\u308B\u3088\u3002\n\u6C17\u306B\u5165\u3063\u305F\u4E00\u679A\u304C\u3042\u3063\u305F\u3089\u3001\nPC\u3084Quest\u3067\u306F\u3001\nVRChat\u306E\u30AB\u30E1\u30E9\u3092\n\u5199\u771F\u306B\u5411\u3051\u3066\u64AE\u308A\u306A\u3002\n\u30B9\u30DE\u30DB\u3067\u306F\u5199\u771F\u3092\u62BC\u3057\u3066\n\u5927\u304D\u304F\u3057\u3066\u304B\u3089\u3001\n\u30B9\u30AF\u30EA\u30FC\u30F3\u30B7\u30E7\u30C3\u30C8\u3060\u3002\n\u30D5\u30EC\u30FC\u30E0\u306F\u7121\u6599\u3067\u9078\u3079\u308B\u3002\n\n\u72AC\u76EE\u7DDA\u30AB\u30E1\u30E9\u306F\u3001\n\u30DD\u30A4\u30F3\u30C8\u3067\u8CB7\u3046\u9053\u5177\u3060\u3088\u3002\n\u300C\u3042\u305D\u3076\u300D\u304B\u3089\u4F7F\u3048\u3066\u3001\n\u6620\u50CF\u306F\u81EA\u5206\u3060\u3051\u306B\u898B\u3048\u308B\u3002\n\u3053\u3053\u306E\u5199\u771F\u3068\u306F\u5225\u306E\u3082\u306E\u3060\u3002\n\n\u304F\u308F\u3057\u3044\u8AAC\u660E\u306F\u3001\n\u5199\u771F\u677F\u306E\u300C\uFF1F\u300D\u3092\u898B\u306A\u3002\n\u64AE\u5F71\u3092\u6B62\u3081\u305F\u308A\u3001\n\u753B\u8CEA\u3092\u5909\u3048\u305F\u308A\u3059\u308B\u306A\u3089\u3001\n\u96A3\u306E\u300C\u89E3\u50CF\u5EA6\u8A2D\u5B9A\u300D\u3060\u3088\u3002"
  - "\u30DD\u30A4\u30F3\u30C8\u306F\u3001\u521D\u3081\u3066\u6765\u305F\u3068\u304D\u306B\n100pt\u3082\u3089\u3048\u308B\u3002\n\u308F\u3057\u3068\u521D\u3081\u3066\u8A71\u3057\u305F\u3068\u304D\u3082\u3001\n\u4E00\u5EA6\u3060\u3051100pt\u3042\u3052\u308B\u3088\u3002\n\u3042\u3068\u306F\u3053\u3053\u3067\u306E\u3093\u3073\u308A\n\u904E\u3054\u3057\u3066\u3044\u308C\u3070\u3001\n1\u5206\u3054\u3068\u306B1pt\u305F\u307E\u308B\u3002\n\u306A\u3067\u3066\u3082\u6295\u3052\u3066\u3082\u5897\u3048\u306A\u3044\u3002\n\u30AE\u30D5\u30C8\u30B3\u30FC\u30C9\u3067\u3082\n\u30DD\u30A4\u30F3\u30C8\u3092\u53D7\u3051\u53D6\u308C\u308B\u3088\u3002\n\u30DD\u30A4\u30F3\u30C8\u306F\u3053\u306E\u677F\u3068\u3001\n\u624B\u5143\u30E1\u30CB\u30E5\u30FC\u3067\u898B\u3089\u308C\u308B\u3002\n\u30B3\u30FC\u30C9\u306F\u3001\u624B\u5143\u30E1\u30CB\u30E5\u30FC\u306E\n\u300C\u30DD\u30A4\u30F3\u30C8\u300D\u3092\u62BC\u3057\u305F\u5148\u3067\n\u4F7F\u3048\u308B\u3088\u3002\n\n\u3053\u3053\u306B\u3042\u308B\u3082\u306E\u306F4\u3064\u306B\u5206\u304B\u308C\u308B\u3002\n\n\u7121\u6599\u3067\u904A\u3079\u308B\u3082\u306E\u3002\n\u306A\u3067\u308B\u3001\u6295\u3052\u308B\u3001\u547C\u3076\u3001\n\u307F\u3093\u306A\u304C\u958B\u3044\u305F\u30E9\u30A4\u30D6\u3084\u904A\u3073\u3002\n\n\u30DD\u30A4\u30F3\u30C8\u3067\u8CB7\u3046\u3082\u306E\u3002\n\u304A\u3082\u3061\u3083\u3068\u304A\u3084\u3064\u306F\u3001\n\u68DA\u306E\u54C1\u7269\u3092\u62BC\u3057\u3066\u3001\n\u78BA\u8A8D\u753B\u9762\u304B\u3089\u8CB7\u3048\u308B\u3088\u3002\n\u307B\u304B\u306E\u30DD\u30A4\u30F3\u30C8\u5546\u54C1\u306F\u3001\n\u624B\u5143\u30E1\u30CB\u30E5\u30FC\u3067\u8CB7\u3048\u308B\u3002\n\u304A\u3084\u3064\u306F\u4F7F\u3046\u305F\u3073\u306B\u6E1B\u308B\u304C\u3001\n\u307B\u304B\u306F\u4E00\u5EA6\u8CB7\u3048\u3070\u4F7F\u3048\u308B\u3002\n\nVRChat\u306E\u304A\u5E97\u3067\u8CB7\u3046\n\u8CB7\u3044\u5207\u308A\u306E\u5546\u54C1\u3002\n\u304A\u3082\u3061\u3083\u3084\u98FE\u308A\u306E\u30BB\u30C3\u30C8\u3001\n\u30E9\u30A4\u30D6\u304C\u3042\u308B\u3002\n\u8CA9\u58F2\u671F\u9593\u304C\u9650\u3089\u308C\u308B\n\u5546\u54C1\u3082\u3042\u308B\u3088\u3002\n\n\u6708\u3054\u3068\u306E\u4F1A\u54E1\u304C\u3001\n\u3070\u306B\u307E\u308B\u30C8\u30EC\u30FC\u30CA\u30FC\u3060\u3088\u3002\n\u4F1A\u54E1\u671F\u9593\u3092\u8CB7\u3063\u3066\u4F7F\u3048\u3066\u3001\n\u81EA\u52D5\u3067\u306F\u66F4\u65B0\u3055\u308C\u306A\u3044\u3002\n\u300C\u3042\u305D\u3076\u300D\u304B\u3089\u3001\u96C6\u5408\u3084\n\u304B\u3051\u3063\u3053\u3092\u958B\u3044\u305F\u308A\u3001\n\u7A7A\u3044\u3066\u3044\u308B2\u5339\u3092\u9078\u3093\u3067\n\u3058\u3083\u308C\u5408\u3063\u3066\u3082\u3089\u3048\u308B\u3002\n\u53C2\u52A0\u3059\u308B\u4EBA\u306F\u4F1A\u54E1\u3067\u306A\u304F\u3066\u3082\n\u7121\u6599\u3067\u697D\u3057\u3081\u308B\u3088\u3002\n\u304F\u308F\u3057\u304F\u306F\u300C\u8A2D\u5B9A\u300D\u306E\n\u30A4\u30F3\u30D5\u30A9\u30E1\u30FC\u30B7\u30E7\u30F3\u3092\u898B\u306A\u3002\n\n\u30E9\u30A4\u30D6\u3092\u958B\u3051\u308B\u306E\u306F\u3001\n\u305D\u306E\u4F5C\u54C1\u3092\u6301\u3064\u7BA1\u7406\u8005\u3060\u3088\u3002\n\u7BA1\u7406\u8005\u306F\u90E8\u5C4B\u306E\u30AA\u30FC\u30CA\u30FC\u3067\u3001\n\u3044\u306A\u3044\u3068\u304D\u306FMaster\u3060\u3002\n\u300C\u30E9\u30A4\u30D6\u958B\u50AC\u3092\u5168\u54E1\u306B\u8A31\u53EF\u300D\n\u304CON\u306A\u3089\u3001\u307B\u304B\u306E\u4EBA\u3082\n\u81EA\u5206\u306E\u6301\u3064\u4F5C\u54C1\u3092\u958B\u3051\u308B\u3002\n\u306F\u3058\u3081\u304B\u3089ON\u306B\u306A\u3063\u3066\u3044\u308B\u3002\n\u540C\u6642\u306B\u958B\u3051\u308B\u306E\u306F\u4E00\u672C\u3067\u3001\n\u7D42\u308F\u3063\u305F\u3042\u3068\u3082\u3057\u3070\u3089\u304F\u306F\n\u6B21\u306E\u3092\u958B\u3051\u306A\u3044\u3002\n\u5F85\u3061\u6642\u9593\u306F\u753B\u9762\u3092\u898B\u306A\u3002\n\u898B\u308B\u306E\u306F\u8AB0\u3067\u3082\u7121\u6599\u3060\u3088\u3002\n\u72AC\u304C\u51FA\u308B\u30E9\u30A4\u30D6\u3082\u3042\u308B\u3002"
  - "\u624B\u5143\u306E\u30E1\u30CB\u30E5\u30FC\u3067\u300C\u304A\u3084\u3064\u300D\u3092\n\u9078\u3073\u3001\u300C\u51FA\u3059\u300D\u3092\u62BC\u3057\u306A\u3002\n\u304A\u3084\u3064\u304C\u51FA\u308B\u3068\u30E1\u30CB\u30E5\u30FC\u306F\n\u9589\u3058\u308B\u304B\u3089\u3001\u72AC\u306B\u3042\u3052\u3066\u304A\u304F\u308C\u3002\n\n\u624B\u306B\u6301\u3063\u3066\u3044\u308B\u3068\u72AC\u304C\u5BC4\u3063\u3066\u304D\u3066\u3001\n\u624B\u653E\u3059\u3068\u3001\u4E00\u756A\u8FD1\u304F\u306B\u3044\u308B\u72AC\u304C\n\u98DF\u3079\u3066\u304F\u308C\u308B\u3088\u3002\n\u4E00\u5EA6\u306B\u51FA\u305B\u308B\u306E\u306F\u3072\u3068\u3064\u3060\u3051\u3002\n\u306F\u3058\u3081\u306B5\u500B\u6301\u305F\u305B\u3066\u3042\u308B\u304B\u3089\u3001\n\u306A\u304F\u306A\u3063\u305F\u3089\u68DA\u3067\n\u30DD\u30A4\u30F3\u30C8\u3068\u4EA4\u63DB\u3057\u306A\u3002"
  - "\uFF3B\u547C\u3073\u65B9\uFF3D\n\u624B\u5143\u30E1\u30CB\u30E5\u30FC\u306E\u300C\u547C\u3076\u300D\u3067\n\u72AC\u3092\u9078\u3073\u3001\u30DD\u30FC\u30BA\u3092\u9078\u3093\u3067\u3001\n\u5834\u6240\u3068\u5411\u304D\u3092\u6C7A\u3081\u308B\u3002\n\u5834\u6240\u3092\u6C7A\u3081\u308B\u9593\u306F\u3001\n\u30E1\u30CB\u30E5\u30FC\u304C\u9589\u3058\u308B\u3088\u3002\n\u6C7A\u3081\u305F\u3042\u3068\u3082\u9589\u3058\u305F\u307E\u307E\u3067\u3001\n\u72AC\u304C\u6B69\u3044\u3066\u304F\u308B\u3002\n\u81EA\u5206\u304C\u547C\u3093\u3060\u72AC\u3092\n\u81EA\u7531\u306B\u3059\u308B\u306A\u3089\u3001\n\u300C\u547C\u3076\u300D\u3067\u305D\u306E\u72AC\u3092\u9078\u3073\u3001\n\u300C\u81EA\u7531\u306B\u3059\u308B\u300D\u3092\u62BC\u3057\u306A\u3002\n\n\uFF3B\u59FF\u52E2\u3068\u52D5\u4F5C\uFF3D\n\u3054\u308D\u3093\u3001\u3075\u305B\u3001\u304A\u3059\u308F\u308A\u3001\n\u3046\u305A\u304F\u307E\u308B\u306E4\u3064\u306F\u7121\u6599\u3060\u3002\n\u3078\u305D\u5929\u306F\u3001\u30DD\u30A4\u30F3\u30C8\u3067\u8CB7\u3046\u3068\n\u30DD\u30FC\u30BA\u3067\u9078\u3079\u308B\u3002\n\u304A\u624B\u3068\u3042\u3054\u4E57\u305B\u3082\u3001\n\u30DD\u30A4\u30F3\u30C8\u3067\u8CB7\u3046\u52D5\u4F5C\u3060\u3088\u3002\n\u304A\u3059\u308F\u308A\u3067\u304A\u624B\u3001\n\u3075\u305B\u3067\u3042\u3054\u4E57\u305B\u3060\u3002\nVR\u3067\u306F\u3001\u547C\u3093\u3060\u672C\u4EBA\u304C\n\u72AC\u306E\u524D\u306B\u624B\u3092\u5DEE\u3057\u51FA\u3057\u3066\u3001\n\u5C11\u3057\u305D\u306E\u307E\u307E\u5F85\u3061\u306A\u3002\n\u624B\u3092\u72AC\u304B\u3089\u9060\u3056\u3051\u308B\u3068\n\u7D42\u308F\u308B\u3088\u3002\nDesktop\u3068\u30B9\u30DE\u30DB\u3067\u306F\u3001\n\u72AC\u306E\u8FD1\u304F\u3067\u30E1\u30CB\u30E5\u30FC\u3092\u958B\u304D\u3001\n\u300C\u547C\u3076\u300D\u306E\u52D5\u4F5C\u30DC\u30BF\u30F3\u3092\n\u62BC\u3057\u306A\u3002\u3057\u3070\u3089\u304F\u305D\u306E\u59FF\u3067\n\u5FDC\u3048\u3066\u304F\u308C\u308B\u3088\u3002\n\u4F38\u3073\u3068\u3042\u304F\u3073\u306F\u30BB\u30C3\u30C8\u3067\u3001\n\u305