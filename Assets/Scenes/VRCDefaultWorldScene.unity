  - "\u0423 \u0434\u0432\u0430 \u0440\u044F\u0434\u0438"
  - "\u0412\u0438\u0431\u0435\u0440\u0438 \u0448\u0438\u043A\u0443\u0432\u0430\u043D\u043D\u044F,
    \u043F\u043E\u0434\u0438\u0432\u0438\u0441\u044C \u043D\u0430 \u043F\u043E\u0437\u043D\u0430\u0447\u043A\u0438
    \u043D\u0430 \u0437\u0435\u043C\u043B\u0456 \u0442\u0430 \u0437\u0431\u0435\u0440\u0438
    \u0441\u043E\u0431\u0430\u043A. \u041F\u0456\u0434\u0456\u0439\u0434\u0435 \u0431\u0443\u0434\u044C-\u044F\u043A\u0435
    \u0440\u0456\u0432\u043D\u0435 \u043C\u0456\u0441\u0446\u0435, \u043D\u0430\u0432\u0456\u0442\u044C
    \u0443 \u0431\u0443\u0434\u0438\u043D\u043A\u0443."
  - "\u0412\u0438\u0431\u0435\u0440\u0438 \u0434\u0432\u043E\u0445 \u0432\u0456\u043B\u044C\u043D\u0438\u0445
    \u0441\u043E\u0431\u0430\u043A. \u0422\u0456, \u043A\u043E\u0433\u043E \u0433\u043B\u0430\u0434\u044F\u0442\u044C
    \u0430\u0431\u043E \u0445\u0442\u043E \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u0432\u0430\u0454,
    \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043C\u0456\u0441\u0446\u0456."
  - "\u0412\u0438\u0431\u0435\u0440\u0438 \u0441\u043E\u0431\u0430\u043A\u0443, \u0449\u043E\u0431
    \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0441\u0432\u0456\u0439 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0438\u0439
    \u043C\u043E\u043D\u0456\u0442\u043E\u0440. \u0419\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u0430
    \u0432\u0437\u044F\u0442\u0438 \u0439 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438
