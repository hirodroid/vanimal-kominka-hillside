  - "\u0412\u043E\u043B\u043E\u043D\u0442\u0451\u0440\u0441\u043A\u0430\u044F \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044F
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    VRChat \u0438\u0437 \u042F\u043F\u043E\u043D\u0438\u0438. \u0412\u0435\u0449\u0430\u043D\u0438\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u044F\u043F\u043E\u043D\u0441\u043A\u043E\u043C.\n\u0412
    \u044D\u0444\u0438\u0440\u0435 \u043A\u0440\u0443\u0433\u043B\u043E\u0441\u0443\u0442\u043E\u0447\u043D\u043E,
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0435\u0436\u0435\u043C\u0435\u0441\u044F\u0447\u043D\u043E."
  - "\u0420\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0438 \u043D\u043E\u0432\u043E\u0441\u0442\u0438
    \u2014 \u0432 X"
  - "\u0427\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F"
  - "\u0412\u043E\u0442 \u0447\u0435\u043C \u043C\u043E\u0436\u043D\u043E \u0437\u0434\u0435\u0441\u044C
    \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F. \u041F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
    \u0432 \u043B\u044E\u0431\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435.\n\n\u041F\u043E\u0433\u043B\u0430\u0434\u044C\u0442\u0435
    \u0441\u043E\u0431\u0430\u043A\u0443. \u0411\u0440\u043E\u0441\u044C\u0442\u0435
    \u043C\u044F\u0447. \u0423\u0433\u043E\u0441\u0442\u0438\u0442\u0435 \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E\u043C.
    \u041E\u0434\u043D\u043E\u0433\u043E \u044D\u0442\u043E\u0433\u043E \u0443\u0436\u0435
    \u0432\u043F\u043E\u043B\u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.\n\n\u0412\u043E
    \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u041F\u043E\u0437\u0432\u0430\u0442\u044C\xBB
    \u0432 \u043B\u0438\u0447\u043D\u043E\u043C \u043C\u0435\u043D\u044E \u043C\u043E\u0436\u043D\u043E
    \u043F\u043E\u0437\u0432\u0430\u0442\u044C \u0441\u043E\u0431\u0430\u043A\u0443
    \u0432 \u043B\u044E\u0431\u043E\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0432\u0448\u0435\u0435\u0441\u044F
    \u043C\u0435\u0441\u0442\u043E, \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430
    \u043F\u043E\u0441\u043F\u0430\u043B\u0430 \u0440\u044F\u0434\u043E\u043C \u0441
    \u0432\u0430\u043C\u0438. \u041F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
    \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0432 \u0440\u0430\u0437\u0434\u0435\u043B\u0435
    \xAB\u041A\u0430\u043A \u043F\u043E\u0437\u0432\u0430\u0442\u044C\xBB.\n\n\u041F\u0430\u043C\u044F\u0442\u043D\u044B\u0435
    \u043C\u043E\u043C\u0435\u043D\u0442\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
    \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F\u043C\u0438 \u043D\u0430
    \u0434\u043E\u0441\u043A\u0435 \u0443 \u0432\u0435\u0440\u0430\u043D\u0434\u044B.
    \u041E \u043D\u0438\u0445 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0432
    \u0440\u0430\u0437\u0434\u0435\u043B\u0435 \xAB\u041E \u0444\u043E\u0442\u043E\xBB.\n\n\u0412\u043E
    \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u041D\u0430\u0440\u044F\u0434\u044B\xBB
    \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0440\u044F\u0434\u0438\u0442\u044C
    \u0441\u043E\u0431\u0430\u043A\u0443, \u0430 \u0432\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435
    \xAB\u042D\u0444\u0444\u0435\u043A\u0442\u044B\xBB \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0438 \u043F\u043E\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u0438.
    \u0415\u0441\u043B\u0438 \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0443\u0441\u0442\u0440\u043E\u0438\u0442 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0432\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u0428\u043E\u0443\xBB,
    \u0432\u0441\u0435 \u0437\u0434\u0435\u0441\u044C \u0441\u043C\u043E\u0433\u0443\u0442
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0433\u043E
    \u0432\u043C\u0435\u0441\u0442\u0435. \u0412\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435
    \xAB\u0418\u0433\u0440\u044B\xBB \u0435\u0441\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0430
    \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u0441\u043E\u0431\u0430\u043A\u0438
    \u0438 \u0438\u0433\u0440\u044B \u0422\u0440\u0435\u043D\u0435\u0440\u0430. \u041E\u0431
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0434\u043B\u044F \u0448\u043E\u0443
    \u0438 \u0422\u0440\u0435\u043D\u0435\u0440\u0430, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u043E \u043F\u043E\u043A\u0443\u043F\u043A\u0430\u0445 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443
    \u0432 \u0440\u0430\u0437\u0434\u0435\u043B\u0435 \xAB\u041F\u043E\u043A\u0443\u043F\u043A\u0438\xBB.\n\n\u041D\u0430
    \u0434\u043E\u0441\u043A\u0435 \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u043C\u043D\u043E\u0439
    \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u0442\u044C \u0441\u043E\u0431\u0430\u043A\u0430\u043C
    \u0438\u043C\u0435\u043D\u0430 \u0438 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u043B\u044E\u0431\u0438\u043C\u0438\u0446\u0443.\n\n\u041D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0432\u0441\u0451. \u041F\u0440\u043E\u0441\u0442\u043E
    \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u043E\u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u043E."
  - "\u0418\u0437 \u0441\u043F\u0430\u043B\u044C\u043D\u0438"
  - "\u0412\u0437\u0434\u0440\u0435\u043C\u043D\u0438 \u0440\u044F\u0434\u043E\u043C
    \u0441 \u0441\u043E\u0431\u0430\u043A\u043E\u0439\n\u041C\u0435\u043D\u044E:
    \u041F\u043E\u0437\u0432\u0430\u0442\u044C \u2192 \u041D\u0430 \u0431\u043E\u043A\u0443"
  - "\u0412\u0437\u043C\u0430\u0445\u043D\u0438 \u0440\u0443\u043A\u043E\u0439 \u0438
    \u043E\u0442\u043F\u0443\u0441\u0442\u0438, \u0447\u0442\u043E\u0431\u044B \u0431\u0440\u043E\u0441\u0438\u0442\u044C"
  - "\u0417\u0430\u0436\u043C\u0438 \u043A\u043B\u0438\u043A \u0434\u043B\u044F \u0437\u0430\u043C\u0430\u0445\u0430
    \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438, \u0447\u0442\u043E\u0431\u044B
    \u0431\u0440\u043E\u0441\u0438\u0442\u044C"
  - "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0431\u0440\u043E\u0441\u043A\u0430 \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438,
    \u0447\u0442\u043E\u0431\u044B \u0431\u0440\u043E\u0441\u0438\u0442\u044C"
  - "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u043F\u043E\u0433\u043B\u0430\u0434\u0438\u0442\u044C
    \u0433\u043E\u043B\u043E\u0432\u0443, \u0449\u0451\u043A\u0438 \u0438\u043B\u0438
    \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043E\u043A\n\u0414\u0432\u0443\u043C\u044F
    \u0440\u0443\u043A\u0430\u043C\u0438 \u0441\u043E\u0431\u0430\u043A\u0430\u043C
    \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0435"
  - "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 \u043F\u0440\u0430\u0432\u044B\u0439
    \u0441\u0442\u0438\u043A \u0432\u043D\u0438\u0437, \u0447\u0442\u043E\u0431\u044B
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043C\u0435\u043D\u044E\n\u041D\u0430\u0440\u044F\u0434\u044B,
    \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430, \u043F\u043E\u0437\u0432\u0430\u0442\u044C,
    \u0438\u0433\u0440\u0443\u0448\u043A\u0438, \u0448\u043E\u0443, \u044D\u0444\u0444\u0435\u043A\u0442\u044B
    \u0438 \u0438\u0433\u0440\u044B"
  - "\u041D\u0430\u0436\u043C\u0438 T, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C
    \u043C\u0435\u043D\u044E\n\u041D\u0430\u0440\u044F\u0434\u044B, \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430,
    \u043F\u043E\u0437\u0432\u0430\u0442\u044C, \u0438\u0433\u0440\u0443\u0448\u043A\u0438,
    \u0448\u043E\u0443, \u044D\u0444\u0444\u0435\u043A\u0442\u044B \u0438 \u0438\u0433\u0440\u044B"
  - "\u041A\u043E\u0441\u043D\u0438\u0441\u044C \xAB\u041C\u0435\u043D\u044E\xBB
    \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435\n\u041D\u0430\u0440\u044F\u0434\u044B,
    \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430, \u043F\u043E\u0437\u0432\u0430\u0442\u044C,
    \u0438\u0433\u0440\u0443\u0448\u043A\u0438, \u0448\u043E\u0443, \u044D\u0444\u0444\u0435\u043A\u0442\u044B
    \u0438 \u0438\u0433\u0440\u044B"
  - "\u041C\u043E\u0436\u043D\u043E \u0432\u0437\u0434\u0440\u0435\u043C\u043D\u0443\u0442\u044C
    \u0440\u044F\u0434\u043E\u043C \u0441 \u0441\u043E\u0431\u0430\u043A\u043E\u0439\n\u0412
    \u043C\u0435\u043D\u044E: \u041F\u043E\u0437\u0432\u0430\u0442\u044C \u2192 \u041D\u0430
    \u0431\u043E\u043A\u0443"
  - "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
    \u0432 Kominka Dog Run"
  - "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435\u0442 \u0432 \u0440\u0443\u043A\u0430\u0445?
    \u0412\u0441\u0451 \u043E\u0431\u044B\u0447\u043D\u043E\u0435 \u2014 \u0443\u0436\u0435
    \u0437\u0434\u0435\u0441\u044C\n- \u041F\u043E\u0433\u043B\u0430\u0434\u0438\u0442\u044C:
    \u043F\u0440\u043E\u0432\u0435\u0434\u0438 \u043F\u043E \u0433\u043E\u043B\u043E\u0432\u0435,
    \u0449\u0435\u043A\u0430\u043C \u0438\u043B\u0438 \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0443
    \u2014 \u0441\u043E\u0431\u0430\u043A\u0430 \u043E\u0442\u0432\u0435\u0442\u0438\u0442\n-
    \u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043C\u044F\u0447: \u043F\u043E\u0434\u043D\u0438\u043C\u0438
    \u0438 \u0431\u0440\u043E\u0441\u044C, \u0441\u043E\u0431\u0430\u043A\u0430 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E\n- \u0412\u0437\u0434\u0440\u0435\u043C\u043D\u0443\u0442\u044C
    \u0432\u043C\u0435\u0441\u0442\u0435: \u0447\u0435\u0440\u0435\u0437 \xAB\u041F\u043E\u0437\u0432\u0430\u0442\u044C\xBB
    \u043D\u0430 \u044D\u0442\u043E\u0439 \u0434\u043E\u0441\u043A\u0435 \u0441\u043E\u0431\u0430\u043A\u0430
    \u043F\u0440\u0438\u0434\u0451\u0442 \u0438 \u043B\u044F\u0436\u0435\u0442 \u0440\u044F\u0434\u043E\u043C\n-
    \u0424\u043E\u0442\u043E: \u0443\u0434\u0430\u0447\u043D\u044B\u0435 \u043C\u043E\u043C\u0435\u043D\u0442\u044B
    \u0441\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u0441\u0430\u043C\u0438
    \u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043D\u0430
    \u0434\u043E\u0441\u043A\u0435 \u043D\u0430 \u0432\u0435\u0440\u0430\u043D\u0434\u0435\n\n\u0427\u0442\u043E
    \u0434\u0435\u043B\u0430\u0435\u0442 \u044D\u0442\u0430 \u0434\u043E\u0441\u043A\u0430:
    \u0432\u0440\u0435\u043C\u044F \u0437\u0434\u0435\u0441\u044C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u043E\u0447\u043A\u0430\u043C\u0438, \u0430 \u043E\u0447\u043A\u0438 \u2014
    \u0442\u0435\u043C, \u0447\u0442\u043E \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F\n-
    \u041B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430, \u043D\u0430\u0440\u044F\u0434\u044B,
    \u0448\u043E\u0443: \u0434\u043E\u0441\u0442\u0430\u0442\u044C, \u043D\u0430\u0434\u0435\u0442\u044C
    \u043D\u0430 \u0441\u043E\u0431\u0430\u043A\u0443, \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
    \u0432 \u0441\u0430\u0434\u0443 (\u0448\u043E\u0443 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
    \u0432\u0441\u0435, \u043A\u0442\u043E \u0437\u0434\u0435\u0441\u044C). \u0412\u043E
    \u0432\u043A\u043B\u0430\u0434\u043A\u0430\u0445 \u0441\u0432\u0435\u0440\u0445\u0443\n-
    \u041E\u0447\u043A\u0438 \u0438 \u0434\u0435\u0434\u0443\u0448\u043A\u0430: \xAB\u041E\u0447\u043A\u0438\xBB
    \u0441\u043F\u0440\u0430\u0432\u0430 \u0432\u0432\u0435\u0440\u0445\u0443 \u2014
    \u043A\u0430\u043A \u0438\u0445 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C
    \u0438 \u043F\u043E\u0434\u0430\u0440\u043E\u0447\u043D\u044B\u0435 \u043A\u043E\u0434\u044B.
    \u0414\u0435\u0434\u0443\u0448\u043A\u0430 \u0432 \u0441\u0430\u0434\u0443 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0442,
    \u043A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C, \u0438 \u0434\u0430\u0441\u0442
    \u043F\u0435\u0440\u0432\u044B\u0435 \u043E\u0447\u043A\u0438"
  - "\u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F
