  - "\u304A\u3058\u3044\u3055\u3093\u306B\u8A71\u3057\u304B\u3051\u308B"
  - "\u3088\u304F\u6765\u305F\u306D\u3002\n\u3053\u3053\u306F\u53E4\u6C11\u5BB6\u306E\u88CF\u5C71\u3060\u3088\u3002\n\u72AC\u305F\u3061\u3068\u3001\u306E\u3093\u3073\u308A\n\u6B69\u3044\u3066\u3044\u304D\u306A\u3002\n\n\u652F\u5EA6\u306F\u3001\u624B\u5143\u30E1\u30CB\u30E5\u30FC\u306E\n\u300C\u304B\u3056\u308A\u300D\u3067\u3067\u304D\u308B\u3002\nVR\u306F\u53F3\u30B9\u30C6\u30A3\u30C3\u30AF\u3092\u4E0B\u306B\n\u5012\u3057\u305F\u307E\u307E\u306B\u3059\u308B\u3068\u51FA\u308B\u3002\nDesktop\u306FT\u30AD\u30FC\u3001\n\u30B9\u30DE\u30DB\u306F\u753B\u9762\u306B\u3042\u308B\n\u300C\u30E1\u30CB\u30E5\u30FC\u300D\u3092\u62BC\u3057\u306A\u3002\n\n\u77E5\u308A\u305F\u3044\u3053\u3068\u304C\u3042\u308C\u3070\u3001\n\u5DE6\u304B\u3089\u9078\u3093\u3067\u304A\u304F\u308C\u3002"
  - "\u3088\u304F\u6765\u305F\u306D\u3002\n\u306F\u3058\u3081\u3066\u3060\u306D\u3002\n\u6563\u6B69\u306E\u652F\u5EA6\u306B\u3001\u3053\u308C\u3092\n\u6301\u3063\u3066\u3044\u304D\u306A\u3002\n{0}pt\u3060\u3002\u4E00\u5EA6\u304D\u308A\u3060\u3088\u3002\n\n\u624B\u5143\u30E1\u30CB\u30E5\u30FC\u306E\u300C\u304B\u3056\u308A\u300D\u3067\n\u72AC\u306E\u652F\u5EA6\u304C\u3067\u304D\u308B\u3002\nVR\u306F\u53F3\u30B9\u30C6\u30A3\u30C3\u30AF\u3092\u4E0B\u306B\n\u5012\u3057\u305F\u307E\u307E\u306B\u3059\u308B\u3068\u51FA\u308B\u3002\nDesktop\u306FT\u30AD\u30FC\u3001\n\u30B9\u30DE\u30DB\u306F\u753B\u9762\u306B\u3042\u308B\n\u300C\u30E1\u30CB\u30E5\u30FC\u300D\u3092\u62BC\u3057\u306A\u3002\n\n\u77E5\u308A\u305F\u3044\u3053\u3068\u304C\u3042\u308C\u3070\u3001\n\u5DE6\u304B\u3089\u9078\u3093\u3067\u304A\u304F\u308C\u3002"
  - "\u30E1\u30CB\u30E5\u30FC"
