    \u0441\u043E\u0431\u0430\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435. \u0412 \u0440\u0435\u0436\u0438\u043C\u0435
