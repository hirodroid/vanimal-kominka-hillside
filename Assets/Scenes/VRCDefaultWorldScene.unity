    \u0432\u0431\u0438\u0440\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u043A."
  - "<b>\u041F\u043E\u0447\u0443\u0432\u0430\u0439\u0442\u0435\u0441\u044F \u044F\u043A
    \u0443\u0434\u043E\u043C\u0430</b>\n\u0417\u0432\u0438\u0447\u043D\u0456 \u0437\u0430\u043D\u044F\u0442\u0442\u044F
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456 \u0431\u0435\u0437 \u043F\u043E\u043A\u0443\u043F\u043E\u043A.\n\n<b>\u041F\u043E\u0433\u043B\u0430\u0434\u0438\u0442\u0438
    \u0441\u043E\u0431\u0430\u043A\u0443</b>\n\u041F\u0440\u043E\u0432\u0435\u0434\u0456\u0442\u044C
    \u043F\u043E \u0433\u043E\u043B\u043E\u0432\u0456, \u0449\u043E\u043A\u0430\u0445
    \u0430\u0431\u043E \u043F\u0456\u0434\u0431\u043E\u0440\u0456\u0434\u0434\u044E
    \u2014 \u0432\u043E\u043D\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0441\u0442\u044C.\n\n<b>\u041F\u043E\u0433\u0440\u0430\u0442\u0438\u0441\u044F
    \u0432 \u0430\u043F\u043E\u0440\u0442</b>\n\u041F\u0456\u0434\u043D\u0456\u043C\u0456\u0442\u044C
    \u043C'\u044F\u0447 \u0456 \u043A\u0438\u043D\u044C\u0442\u0435. \u0421\u043E\u0431\u0430\u043A\u0430
    \u043F\u0440\u0438\u043D\u0435\u0441\u0435 \u0439\u043E\u0433\u043E \u043D\u0430\u0437\u0430\u0434.\n\n<b>\u0412\u0456\u0434\u043F\u043E\u0447\u0438\u0442\u0438
    \u0440\u0430\u0437\u043E\u043C</b>\n\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044C
    \xAB\u041F\u043E\u043A\u043B\u0438\u043A\u0430\u0442\u0438\xBB \u0432 \u043C\u0435\u043D\u044E.
    \u0421\u043E\u0431\u0430\u043A\u0430 \u043F\u0440\u0438\u0439\u0434\u0435 \u0439
    \u043B\u044F\u0436\u0435 \u043F\u043E\u0440\u0443\u0447.\n\n<b>\u041F\u043E\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
    \u0444\u043E\u0442\u043E</b>\n\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0456
    \u043C\u0438\u0442\u0456 \u0437\u043D\u0456\u043C\u0430\u044E\u0442\u044C\u0441\u044F
    \u0441\u0430\u043C\u0456 \u0439 \u043F\u043E\u043A\u0430\u0437\u0443\u044E\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0444\u043E\u0442\u043E\u0434\u043E\u0448\u0446\u0456 \u0431\u0456\u043B\u044F
    \u0432\u0435\u0440\u0430\u043D\u0434\u0438.\n\n<b>\u0429\u043E \u043C\u043E\u0436\u043D\u0430
    \u0440\u043E\u0431\u0438\u0442\u0438 \u0432 \u043C\u0435\u043D\u044E</b>\n\u0427\u0430\u0441
    \u0442\u0443\u0442 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C \u0431\u0430\u043B\u0438,
    \u044F\u043A\u0456 \u043C\u043E\u0436\u043D\u0430 \u043E\u0431\u043C\u0456\u043D\u044F\u0442\u0438
    \u043D\u0430 \u0442\u0435, \u0449\u043E \u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F.\n\u0423
    \u0432\u043A\u043B\u0430\u0434\u043A\u0430\u0445 \u0443\u0433\u043E\u0440\u0456
    \u2014 \u0434\u0456\u0441\u0442\u0430\u0442\u0438 \u043B\u0430\u0441\u043E\u0449\u0456,
    \u0432\u0431\u0440\u0430\u0442\u0438 \u0441\u043E\u0431\u0430\u043A\u0443 \u0430\u0431\u043E
    \u0432\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0448\u043E\u0443
    \u0432 \u0441\u0430\u0434\u0443. \u0423\u0441\u0456 \u043F\u043E\u0440\u0443\u0447
    \u0437\u043C\u043E\u0436\u0443\u0442\u044C \u043F\u043E\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
    \u0439\u043E\u0433\u043E \u0440\u0430\u0437\u043E\u043C.\n\n<b>\u0411\u0430\u043B\u0438
    \u0442\u0430 \u0434\u0456\u0434\u0443\u0441\u044C</b>\n\u0412\u0456\u0434\u043A\u0440\u0438\u0439\u0442\u0435
    \xAB\u0411\u0430\u043B\u0438\xBB \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447
    \u0443\u0433\u043E\u0440\u0456 \u2014 \u0442\u0430\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u0438
    \u0437\u0430\u0440\u043E\u0431\u0438\u0442\u0438 \u0431\u0430\u043B\u0438 \u0442\u0430
    \u043F\u043E\u0434\u0430\u0440\u0443\u043D\u043A\u043E\u0432\u0456 \u043A\u043E\u0434\u0438.\n\u0414\u0456\u0434\u0443\u0441\u044C
    \u0443 \u0441\u0430\u0434\u0443 \u0440\u043E\u0437\u043A\u0430\u0436\u0435, \u044F\u043A
    \u0433\u0440\u0430\u0442\u0438, \u0456 \u0434\u0430\u0441\u0442\u044C \u043F\u0435\u0440\u0448\u0456
    \u0431\u0430\u043B\u0438.\n\n<b>\u0412\u0438\u043A\u043B\u0438\u043A\u0430\u0442\u0438
    \u043C\u0435\u043D\u044E \u0434\u043E \u0441\u0435\u0431\u0435</b>\nVR: \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435
    \u043F\u0440\u0430\u0432\u0438\u0439 \u0441\u0442\u0456\u043A \u0434\u043E\u043D\u0438\u0437\u0443\n\u041F\u041A:
    \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C T\n\u0422\u0435\u043B\u0435\u0444\u043E\u043D:
    \u0442\u043E\u0440\u043A\u043D\u0456\u0442\u044C\u0441\u044F [\u041C\u0435\u043D\u044E]
    \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456"
